{
  "name": "rsi-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/slices.mjs && tsc -p . && node scripts/copy-static.mjs",
    "typecheck": "node scripts/slices.mjs && tsc -p . --noEmit",
    "test": "npm run build && node scripts/parity.mjs && node scripts/source-guard.mjs --check && node --test tests/*.test.mjs",
    "test:vim-repeat": "npm run build && node scripts/smoke-vim-repeat.mjs",
    "parity": "node scripts/slices.mjs && node scripts/parity.mjs --print",
    "audit": "npm run build && node scripts/audit.mjs",
    "smoke:webkit": "npm run build && node scripts/smoke-webkit.mjs",
    "smoke:app": "node scripts/smoke-app.mjs",
    "tauri": "cargo tauri"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0"
  }
}
