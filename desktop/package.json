{
  "name": "rsi-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/slices.mjs && tsc -p . && node scripts/copy-static.mjs",
    "typecheck": "tsc -p . --noEmit",
    "test": "node scripts/slices.mjs --check && npm run build && node scripts/parity.mjs --check && node scripts/source-guard.mjs --check && node --test tests/*.test.mjs",
    "tauri": "cargo tauri"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0"
  }
}
