# RSI daemon secrets and local configuration.
# Copy values into ~/.rsi/.env, then restart rsid. Do not put real secrets here.
# Variables already set by your shell, systemd unit, or process environment win
# over values in ~/.rsi/.env.

# Provider API keys
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
INCEPTION_API_KEY=
MERCURY_API_KEY=
KIMI_API_KEY=
GOOGLE_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
CEREBRAS_API_KEY=
PERPLEXITY_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
COHERE_API_KEY=
SAMBANOVA_API_KEY=
NVIDIA_API_KEY=

# OpenAI-compatible / local providers
KIMI_API_BASE_URL=
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_API_KEY=

# Common RSI daemon options
RSI_CONTEXT_ROTATION_ENABLED=false
RSI_MEMORY_ENABLED=true
RSI_MEMORY_DIR=
RSI_MEMORY_EMBEDDING_MODEL=nomic-embed-text
RSI_MEMORY_EMBEDDING_URL=
RSI_MEMORY_EMBEDDING_API_KEY=
RSI_BUILD_MODEL=
RSI_INVOKE_MODEL=
RSI_QUEUE_ENABLED=true
RSI_QUEUE_POLL_INTERVAL_SECS=30
RSI_WORKSPACE_ROOTS=
RSI_SANDBOX_BASE=
RSI_CODEX_SANDBOX_MODE=workspace-write

# Dream and classifier options
RSI_DREAM_ENABLED=true
RSI_DREAM_MODEL=
RSI_DREAM_API_URL=
RSI_DREAM_API_KEY=
RSI_STALL_CLASSIFIER_ENABLED=false
RSI_STALL_CLASSIFIER_MODEL=qwen2.5:7b
RSI_STALL_CLASSIFIER_API_URL=http://localhost:11434/v1/chat/completions
RSI_STALL_CLASSIFIER_API_KEY=
