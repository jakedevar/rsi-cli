#!/bin/sh
# Warm Cargo target pool shared by worker sandboxes (#1741): the command-line entry.
#
#   target-pool seed --sandbox ROOT [--target DIR] [--build-missing]
#   target-pool build --repo DIR [--sha SHA]
#   target-pool seed-from HOST --repo DIR [--sha SHA] [--dry-run]
#   target-pool gc [--repo DIR] [--keep N] [--pressure] [--json]
#   target-pool reclaim-idle [--min-interval SEC]
#   target-pool refresh [--repo DIR] [--keep N]
#   target-pool status [--repo DIR]
#   target-pool summary [--repo DIR] [--ref REF]
#   target-pool key [--repo DIR]
#
# The pool is implemented in Rust (#446/#453): crates/rsi-repo-guards/src/target_pool*.rs,
# reached as `rsi-repo-guard target-pool` (also `rsi-scoped-test target-pool`). This file
# only finds that binary and runs it, so every caller keeps one stable path
# (~/.rsi/bin/target-pool, installed by `make release-install`). The pool layout, marker,
# `.use` lock and event files are the format the earlier Python tool wrote.
#
# Where the binary is looked for, first hit wins:
#   $RSI_REPO_GUARD_BIN                      an explicit binary (tests, an unusual host)
#   <this directory>/rsi-repo-guard          ~/.rsi/bin, beside the installed copy
#   $CARGO_TARGET_DIR/{release,debug}/       the caller's own build (a sandbox or checkout)
#   <checkout>/target/{release,debug}/       a checkout's default target
#   ~/.rsi/install, ~/.local/bin, PATH       what `make release-install` links
#
# When there is none this exits 127 and says so: a seed is best effort for every caller,
# and nothing here builds a binary at call time (a seed has a 300 s limit and cargo-slot
# runs this while it waits for a build slot).
set -u

script_dir=$(CDPATH='' cd "$(dirname "$0")" && pwd -P) || exit 127
checkout=$(dirname "$script_dir")
rsi_home=$HOME/.rsi

find_guard() {
  for candidate in \
    "${RSI_REPO_GUARD_BIN:-}" \
    "$script_dir/rsi-repo-guard" \
    "${CARGO_TARGET_DIR:+$CARGO_TARGET_DIR/release/rsi-repo-guard}" \
    "${CARGO_TARGET_DIR:+$CARGO_TARGET_DIR/debug/rsi-repo-guard}" \
    "$checkout/target/release/rsi-repo-guard" \
    "$checkout/target/debug/rsi-repo-guard" \
    "$rsi_home/install/rsi-repo-guard" \
    "$HOME/.local/bin/rsi-repo-guard"; do
    [ -n "$candidate" ] && [ -f "$candidate" ] && [ -x "$candidate" ] || continue
    echo "$candidate"
    return 0
  done
  command -v rsi-repo-guard 2>/dev/null
}

guard=$(find_guard) || guard=""
if [ -z "$guard" ]; then
  echo "target-pool: rsi-repo-guard is not installed; run make release-install, or build it with: cargo build --release -p rsi-repo-guards --bin rsi-repo-guard" >&2
  exit 127
fi
exec "$guard" target-pool "$@"
