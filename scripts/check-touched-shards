#!/usr/bin/env python3
"""check-touched-shards: verify a candidate once, print one line plus a JSON receipt (#1099).

Replaces the per-file `grep -o 'test-shard-...'` + shard-mode compile ritual and
the manager's hand verification (merge-base, merge-tree, diff --check, audits).

    scripts/check-touched-shards [--base <rev>] [--head <rev>] [--repo <dir>]

For the diff merge-base(base, head)..head (when head merged an earlier, still-queued
commit of rolling there are several merge bases: the diff is then the clean merge result
against the base tip (`git merge-tree`, #2814; a conflicted merge keeps the diff against
the base tip kept to files some merge base also sees changed); the receipt's `merge_bases` lists them,
the summary says `MERGE_BASES=n`, #1633) it:
  * maps changed rsid and rsid-store sources to their test shards and
    shard-mode-compiles exactly those (`cargo check -p rsid [-p rsid-store]
    --lib --tests --no-default-features --features test-shard-<shard>`, the
    `-p` list being the packages that declare the shard, from
    `check-rsid-test-shards.py --list-shard-packages`; through
    ~/.rsi/bin/cargo-slot when present); a changed source with no gated test
    still compiles one fallback shard, and an rsid-store change also compiles
    one rsid-only shard so a store API break in the daemon is caught;
  * runs check-rsid-test-shards.py --require-gates, `git diff --check`,
    tools/check-released-migrations.py and a dynamic-SQL guard (format!-built
    SQL in added lines; add `sql-dynamic-ok` on the line to accept one);
  * reports whether head merges cleanly into base and which migrations it adds;
  * suggests landing filters (rsid=shard:<shard>:test(<module>), rsi-common=,
    rsi=, plus the cross-cutting pins the worker contract names).
    The receipt's `changed_modules` names each changed library module (with the sources
    below it that did not change, so a descendant's tests stay out) and each changed bin or
    integration-test target; scoped-test runs their tests before unrelated observers (#2182).
    Rust comment/doc-only changes keep compile checks and source readers,
    with no runtime module filters (#1887). Literal and attribute changes remain
    executable changes. Ambiguous Rust lexing retains normal coverage.
    Module paths follow `mod`, `#[path]` and `include!` mounts from each crate
    root, so a test file mounted under another module gets its real path; a
    shard filter that no test of that shard satisfies is dropped and listed in the
    receipt's `dropped_filters` with the reason (#1260, #1253). Migration rewind
    helper-only edits select their callers and fixture guards, not all of
    store::tests (#1341); when every added migration only adds columns or
    indexes or isolated new tables, only the migration-chain pins (#1618,
    #1654, #1696). Literal SQLite journal batches retain this proof with the
    standard transaction imports and reject-only triggers; unknown helpers
    and existing-object writes retain every rewind caller, with a reason. A shard counts for a source only when a `feature = "test-shard-<s>"`
    gate sits in its code, never when the name appears in a fixture string or
    comment (#1818). Likewise a module or target counts as holding a test only for a
    `#[test]` in code that is not `#[ignore]`d, never one named in a doc comment or
    string: its filter would select no test and the lander refuses the gate (#2338).
    A bin or integration target whose code include_str!s a changed
    source is suggested too (`rsid=bin:rsid`), though the target itself is untouched
    (#1769). An integration target that reads a changed command, skill or prompt
    file (`.claude/commands`, `.claude/skills`, `.agents`, `.codex/prompts`,
    `.gemini/commands`) is suggested the same way (#1926). A changed TUI file named by
    `scripts/e2e-tui-surfaces.json` (settings*, ui/settings, overlay/*, app/*, ...) suggests the
    rsi `e2e_tui` modules that drive it as `rsi=test:e2e_tui:test(<module>::)`, one filter per
    module, never the whole target unless every module is selected (#2321; receipt
    `e2e_surfaces`, an unmounted or test-less module is listed in `dropped_filters`). A bin or integration target
    owns every source it compiles, not only its root: a module its root mounts
    (`mod`, `#[path]`, `include!`), a `tests/` helper module, `tests/NAME/` of a
    `tests/NAME.rs` or `tests/NAME/main.rs` target. Such a source selects
    `<package>=bin:NAME`/`<package>=test:NAME`, and a source only a bin mounts never gets the
    lib-style `<package>=<module>` filter (`cargo test --lib` would select no test, #1937, #1650).
    A source that reads a changed non-Rust file selects its own tests whether it is
    a bin, an integration test (or a module it mounts) or a library module: an
    `include_str!`/`include_bytes!` that resolves to the file, a command/skill/prompt
    asset path (`.claude/commands`, ...) in a bin or integration test, a path
    literal in another package (`"scripts/x.txt"`), or in the file's own package its
    name or a directory above it outside `src/` (`.join("fixtures")`). A bare file
    name never selects another package's test. Sharded rsid/rsid-store library
    modules that read such a file are left to the lander's own selection, except a data
    file under `src/` that a sharded library const, static or function `include_str!`s (guidance
    markdown): it selects the tests that name that item, its callers in the including module and
    their direct outside callers, by exact name, while the closure stays within the test bound
    and every changed data file resolves (#2057; otherwise the lander's selection applies). No test is run.
    A diff that changes production Rust under `src/` of a crate a source scanner reads
    also suggests the scanners by exact name (#2034): tests that resolve the crate root
    (`manifest_dir!`/`CARGO_MANIFEST_DIR`, directly or via a test helper) and name a source
    tree, found from the test code (the lander's `source_readers` rule), reported as
    `source_scanners`; sharded rsid/rsid-store library tests only.
    A production edit of a leaf crate split out of rsid (`LEAF_FACADES`, #2410: rsid-remote-read) also
    suggests the daemon tests that observe it, because the leaf cannot name its callers: the tests of the
    retained facade module (`rsid=shard:S:test(remote_read)`) and any sharded test that names the changed
    identifiers (the receipt's `leaf_observers`). The trace starts in the leaf's own functions and follows
    private helpers through their public wrappers into rsid, including long functions (#2441). When it
    cannot be proven (an ambiguous public name, too wide a trace, a leaf module declaration), no filter
    is suggested at all (`unfiltered_leaf_paths`): the lander then runs its own complete closure over
    the leaf and rsid sources, because any filter would suppress it. A test-only or comment-only leaf
    edit suggests the leaf's own module filter alone. `rsi-graph::planning` (#2416: `crates/rsi-graph/src/planning/`,
    observed through the `topology` and `session::graph_runner` facades) is a leaf of the same kind.
    The list is bounded and precise (#1440, #1418, #1438, #1263), so a worker can
    run it inside its bounded test budget:
      - a test module that mounts test submodules (`session::tests::manager_actions`
        with `#[path] mod issue_worker;`) gets `test(/^<module>::[A-Za-z0-9_]+$/)`:
        its own tests, not the `test(<module>)` prefix that spills into every
        submodule. Receipt `narrowed_filters[].excludes` lists what is not selected:
        add `test(<submodule>)` after editing a helper they share;
      - a shard filter that would select more than BROAD_TEST_LIMIT (60) tests is
        narrowed to the tests that mention the diff: the changed functions traced
        through their callers (a word match in the body, transitively, through
        test helpers of any size and production functions up to 60 lines) to the
        tests that mention them; inside a large production function the rare
        identifiers of the changed lines; simple RPC arms
        trace their method and handler plus dispatch-table source readers,
        including named source constants, without traversing the dispatcher;
        same-file moves into a private inline module ignore unchanged
        indentation and trace changed private members to their receiver types
        and real users (common test-only method names stay with their type);
        unique unit enums and their methods trace concrete type consumers;
        common private helper names stay in their module subtree, while an
        exported helper whose name another module also defines is followed by
        the calls that provably reach it (a qualified path, an import, a
        definition in its own module or inline `mod`, a glob of the owner;
        #2247) and only an unplaceable reference (a re-export, a renaming
        `use`, a method of an unknown receiver) retains the conservative
        fallback, naming it in `ambiguous exported helper: <item> (<why>)`;
        named struct fields and explicit re-exports trace their rare identifiers
        through consuming helpers too; a
        `mod x;` registration selects x's tests. The filter is a named set,
        `test(/^<module>::(?:\\w+::)*(?:a|b)$/)`, one per shard and module. A
        complete trace that no test mentions yields no filter (`narrowed_filters`
        tests 0: the shard compile is all that observes it). Named sets, the agent
        verb catalog pins included, split so every whole filter (`rsid=shard:S:test(...)`)
        is at most 256 bytes, the AgentSubmitJob/AgentEnqueueLandingSource wire cap
        (#1705); a single name that cannot fit is listed in `oversize_filters`.
        Same-shard module coverage absorbs redundant filters. Identical shard
        expressions selecting the same unsharded packages run once (explicit
        --run-filters keeps its separate shard builds).
        When the aggregate exceeds 12 filters, smaller modules are traced too,
        accepting only reductions in the merged list;
      - the agent verb catalog pins (a change that adds AGENT_VERBS/READ_VERBS or
        touches rpc/agent* or harness/tools) are the named tests of `rpc::` and
        `session::harness::tools::` whose name says operator_only, catalog,
        agent_verb, read_verb or agent_gate, or whose body names AGENT_VERBS or
        READ_VERBS, never the whole `rpc::tests` or `harness::tools` modules;
      - a changed source named in SOURCE_OBSERVER_PINS (crates/rsi-common/src/agent_control_schema.rs
        -> rsid `rpc::tests::operator_daemon_config_is_absent_from_every_agent_surface`, #2949)
        selects those exact tests: they consume the data through a function call, which the
        include_str! trace cannot see. The manager spend inputs also pin the external
        delegation VM-cost regression (#3076). The receipt's `source_observer_pins` lists them;
        `source_observer_missing` names a pin whose test no longer exists;
      - any Rust file scanned by rsi-common's workspace manifest-path guard selects that
        integration test with one exact filter (#417), including comment-only changes;
      - a diff confined to the functions a rule in scripts/test-coverage.json names
        (the Store::open lifecycle hooks, #1585; the terminal-watch planner, #1593) selects that rule's named tests
        instead of the module's. The shard compile still covers the source. The
        receipt's `declared_coverage` lists each use; a change outside the named
        functions, or an unresolvable rule, derives the module filters as usual;
      - when the diff cannot be traced (a const, struct header, wildcard use, or
        impl header), the trace names more than 24 tests (60 for a same-file
        private move) or 150
        functions, or an identifier is too common, the module filter is kept and
        the receipt says so: `broad: true`, `broad_filters` (filter, test count,
        reason), a `BROAD` token in the summary line and a stderr warning. A broad
        filter may exceed the budget: split it into bounded runs. A trace never follows a
        high-fan-in token (more than 150 functions mention it): it follows the changed method by
        its name, stops at the hub and, like any stopped trace, names the tests it proved observe the
        change in `direct_observer_filters` (with `direct_observers`, and `direct_tests`, `hubs`,
        `trace_stopped` on the broad entry), nearest first; the module filter still selects the far
        observers and the receipt stays uncertain (#2588). Each broad entry names its `stop` and
        whether it is `worker_bounded` (#2592): a hub, the function bound or the test bound is a cap, so
        scoped-test selects only the changed-module tests and the direct observers for the worker and
        defers the rest to the merge-queue gate and the pinned full QA, while `suggested_filters` (the
        gate's selection) keep the module filter; an unresolved identity or an untraceable diff
        (`worker_bounded: false`) keeps the broad worker filter.
        Uncertain coverage can retain more than 12 filters; none are truncated.
      - `#[path]` and `include!` mounts (a `../` mount, a mount from a mounted
        file) resolve to the module path the compiler gives their tests. A `#[path]`-mounted
        file owns its directory like a `mod.rs`: its `mod tests;` loads `tests.rs` beside it,
        and a `<stem>/tests.rs` no declaration reaches covers nothing (#1697;
        `check-rsid-test-shards.py` refuses such a file).
      - a module filter is a nextest substring (`test(deploy)`), which also selects
        any test whose name merely contains the module (`store::tests::v95_deployed_...`);
        when the tree holds such foreign tests the filter is anchored to the module's own
        tree, `test(/^deploy::/)`, and `narrowed_filters` says what it no longer selects (#1653);
      - the BROAD size of a module filter counts the tests of every shard, because a
        focused filter builds without shard features and the `shard:S:` label only routes
        it; every labelled copy is flagged with the same real count (#1698).
      The filters are nextest atoms (`test(name)` substring, `test(=name)` exact,
      `test(/regex/)`), which rsi-rolling-land and scripts/scoped-test accept.
      Scope: the narrowing covers rsid and rsid-store shard filters; rsi, rsi-common
      and the other crates keep `<package>=<module>`.
  * when every shard compile fails with the same error it reports
    `shards.shard_compile_suspect_stale` (a stale path-dependency artifact in a
    reused target, #1260); CHECK_TOUCHED_SHARDS_CLEAN=1 opts in to a
    `cargo clean -p` of the workspace packages first, only for a target under the repo.
  * with --filters-only, derives the suggested filters and the cheap git audits
    only: no cargo compile, no shard-gate or released-migration audit, no
    rsi-test-impact. A small diff takes seconds on a loaded host (the full check
    spent ~8 s in two source inventories of check-rsid-test-shards.py, #1853).
    The receipt's `timings_sec` splits the time by phase. This is the mode a worker
    uses to derive landing filters: the default also queues every touched shard's
    compile behind the cargo build slots (minutes), which the lander runs itself (#2026).
  * COMPILE IS AN EXPLICIT VERIFIER MODE (#222/#2564): a run with none of --compile,
    --no-compile, --filters-only or --slow-tier-only is refused (exit 2) instead of
    silently starting cargo. Only a supervised job (the `check-touched-shards` recipe,
    scripts/candidate-receipt.sh) passes --compile, so every compiler process runs
    under a job's admission, budget and timeout. Planning (--filters-only, --no-compile,
    scripts/scoped-test derivation and its --dry-run) starts no cargo build/check/test;
    the only other cargo call, the opt-in clean's `cargo metadata`, is
    `--no-deps --offline` and runs only with --compile. The receipt's
    `compile` object says which happened (`mode`, `status` executed|skipped,
    `cargo_check_invoked`, `shards_checked`), so a skipped compile is never read as verified.
  * with --run-filters, runs the suggested (and any --filter) rsid shard
    landing filters under a private tmpfs TMPDIR (/dev/shm, override with
    CHECK_TOUCHED_SHARDS_TMPDIR), as the merge-queue lander does (#1182).

Progress (#1657, #1718): a full check prints one stderr line per phase and per shard
(`check-touched-shards: [ 12.3s] shard store-01 ok in 183.2s (build slot wait 12s)`)
so it never looks hung under a shell cap; --filters-only (seconds) and
CHECK_TOUCHED_SHARDS_QUIET=1 print none. The receipt's `shards.runs` gives each shard's
verdict, seconds, `slot_wait_sec` (queued for a cargo-slot build slot, read from its
`slot-granted` phase line) and `build_sec`. With --receipt PATH the receipt is also
written atomically before the compile and after every shard as `{"partial": true,
"phase": ..., "shards": {"compiled_ok", "compile_pending", "runs"}}`; a SIGTERM (the
unit's time limit) writes the same partial receipt as `phase: "interrupted"` (and, with
--receipt-line, as the last `RECEIPT_JSON` line) and exits 143, so a successor re-runs
only `compile_pending`. The finished receipt has `partial: false`.

Output: one summary line, then the JSON receipt (--json: only JSON). The receipt's
`suggested_filters`, `dropped_filters`, `narrowed_filters`, `broad` and `broad_filters`
describe the landing filters above.
Exit 0 when every verdict is ok/skipped, 1 otherwise.
"""

from __future__ import annotations

import argparse
import collections
import difflib
import functools
import json
import os
import posixpath
import re
import shlex
import shutil
import signal
import sqlite3
import subprocess
import sys
import tempfile
import time
from pathlib import Path

try:
    import tomllib
except ImportError:  # Python before 3.11: the slow-tier decision then fails closed to "full"
    tomllib = None

RSID_SRC = "crates/rsid/src/"
RSID_STORE_SRC = "crates/rsid-store/src/"
# Sharded library sources: rsid and (since the #1021 S4 crate split) rsid-store.
SHARDED_SRCS = (RSID_SRC, RSID_STORE_SRC)
# #2410: leaf crates split out of rsid, mapped to the rsid facade module that keeps their daemon-side
# owner (Store locking, admission, runtime permits, the per-boot signer). The leaf's own tests run as
# `<package>=<module>`; a production edit is also observed by the daemon code that calls it.
LEAF_FACADES = {
    "rsid-remote-read": ("remote_read",),
    "rsid-harness": ("session::harness",),
}
# #2416: `rsi-graph::planning` (pure topology planning, #2415) is observed through two retained rsid facades,
# `topology` and `session::graph_runner`. Only `src/planning/` is a leaf (the rest of rsi-graph keeps the generic
# dependency treatment), and the facades are broad, so a provable trace selects exactly the tests that name the change
# and an unprovable one derives no filter (#2441), leaving the facades to the lander's own closure.
LEAF_FACADES["rsi-graph"] = ("topology", "session::graph_runner")
LEAF_SCOPES = {"rsi-graph": "crates/rsi-graph/src/planning/"}
LEAF_FACADES_FALLBACK_ONLY = frozenset({"rsi-graph"})
# `build.rs` of rsid-store consumes only the first directory; the second is the
# pre-split layout, still read on an old base and refused for new units.
MIGRATIONS = RSID_STORE_SRC + "store/migrations/"
PRE_SPLIT_MIGRATIONS = RSID_SRC + "store/migrations/"
GATE = re.compile(r"test-shard-([a-z]+-[0-9]+)")
MIGRATION_FILE = re.compile(r"^" + re.escape(MIGRATIONS) + r"v(\d+)\.rs$")
PRE_SPLIT_MIGRATION_FILE = re.compile(r"^" + re.escape(PRE_SPLIT_MIGRATIONS) + r"v(\d+)\.rs$")
SQL_WORDS = re.compile(r"\b(SELECT|INSERT\s+INTO|UPDATE|DELETE\s+FROM|CREATE\s+(?:TABLE|INDEX)|ALTER\s+TABLE|DROP\s+(?:TABLE|INDEX))\b")
SQL_OK = "sql-dynamic-ok"
# #1440: a change that touches the agent verb catalog pins the catalog and
# operator-only tests by name; it never pins whole modules (`rpc::tests` alone is
# ~240 slow fixtures, more than a worker's 10-minute test budget).
AGENT_VERB_PIN_MODULES = ("rpc::", "session::harness::tools::")
AGENT_VERB_PIN_NAME = re.compile(r"operator_only|catalog|agent_verb|read_verb|agent_gate")
AGENT_VERB_PIN_BODY = re.compile(r"\b(?:AGENT_VERBS|READ_VERBS)\b")
AGENT_VERB_PIN_CAP = 80
# #2949 (satellite #23): a source whose data an rsid test consumes through a function call (not
# include_str!, so the data-file observer trace cannot see it) pins that test by exact name.
# {changed source: ((test module, test name), ...)}; a pin whose test no longer exists is
# reported in the receipt (`source_observer_missing`) instead of silently selecting nothing.
# #3076: the small spend-input modules retain their own tests without a caller trace.
# The delegation cost bound observes both inputs through the manager snapshot/gate,
# so it must join those module filters even though it lives elsewhere in rsid-store.
MANAGER_SPEND_OBSERVERS = (
    ("store::portfolio_nodes::delegation_tests",
     "a_manager_pass_costs_a_bounded_number_of_instructions_per_member_2494"),
)
SOURCE_OBSERVER_PINS = {
    RSID_STORE_SRC + "model_control/cost.rs": MANAGER_SPEND_OBSERVERS,
    RSID_STORE_SRC + "store/manager_resources.rs": MANAGER_SPEND_OBSERVERS,
    "crates/rsi-common/src/agent_control_schema.rs": (
        ("rpc::tests", "operator_daemon_config_is_absent_from_every_agent_surface"),
    ),
}
# #1418/#1438: a filter that selects more tests than a worker's 10-minute budget
# can run is narrowed to the tests that observe the diff, or flagged `broad`.
BROAD_TEST_LIMIT = 60
GATE_FILTER_LIMIT = 12
GATE_FILTER_LENGTH = 256
NARROW_TEST_CAP = 24
# Bound on the shard listing subprocess; past it the single-shard fallback applies (#1853).
LIST_TIMEOUT_SEC = 60
NARROW_FUNCTION_CAP = 150
# Modules a `pub use` / glob chain may cross before the item is called unplaceable (#2592).
REEXPORT_DEPTH = 6
# A token that more functions mention than the whole observer trace may name is a hub (the
# `SessionManager` of #1186): following it reaches most of the namespace, so the walk stops
# there, follows the changed method by its own name, and leaves the hub's far observers to the
# broad fallback (#2588).
HUB_FUNCTIONS = NARROW_FUNCTION_CAP
# The stops that are a cap, not an ambiguity (#2592): the walk was bounded (a hub, the function or
# the test bound) but every identity it followed was placed. A broad entry stopped this way is
# `worker_bounded`: scoped-test selects its changed-module tests and proven direct observers and
# defers the rest to the merge-queue gate and the pinned full QA instead of widening the worker's
# plan to the module filter. An unresolved receiver or helper identity is an ambiguity and keeps
# the broad worker fallback. The gate's `suggested_filters` are the same either way.
WORKER_BOUNDED_STOPS = frozenset({"function bound", "test bound", "hub"})
# A function this long (a dispatch table, a big match) is traced by the rare
# identifiers on the changed lines, not by its own name, which every test reaches.
LARGE_FUNCTION_LINES = 60
RARE_TOKEN_FUNCTIONS = 10
NOISE_WORDS = frozenset(
    "self Self super crate pub let mut impl struct enum match return async await move true false None Some Ok Err "
    "where trait type const static mod use while loop else for ref dyn Box Vec Option Result String str bool "
    "u8 u16 u32 u64 usize i32 i64 f64 serde json into from with this that".split()
)


def run(args, cwd, check=False, env=None, timeout=None):
    return subprocess.run(args, cwd=cwd, text=True, capture_output=True, check=check, env=env, timeout=timeout)


def git(repo, *args):
    return run(["git", *args], repo)


def git_out(repo, *args):
    result = git(repo, *args)
    if result.returncode != 0:
        raise SystemExit(f"git {' '.join(args)} failed: {result.stderr.strip()}")
    return result.stdout


def _released_migration_guard(repo):
    """The released-migration guard module of this checkout (hyphenated file name)."""
    import importlib.util
    candidates = [repo / "tools/check-released-migrations.py",
                  Path(__file__).resolve().parents[1] / "tools/check-released-migrations.py"]
    spec = importlib.util.spec_from_file_location("released_migration_guard", next(c for c in candidates if c.exists()))
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


STARTED = time.monotonic()
PROGRESS = [True]
SLOT_GRANTED = re.compile(r"^rsi-phase \d+ slot-granted: waited (\d+)s", re.M)


def progress(message):
    """One stderr line per phase, so a long check never looks hung (#1657)."""
    if PROGRESS[0]:
        sys.stderr.write(f"check-touched-shards: [{time.monotonic() - STARTED:6.1f}s] {message}\n")
        sys.stderr.flush()


def slot_wait_seconds(stderr):
    """Seconds a cargo-slot wrapper reports it queued for a build slot (0 when it never queued)."""
    return sum(int(waited) for waited in SLOT_GRANTED.findall(stderr or ""))


def write_receipt(path, receipt):
    """Write `receipt` to `path` atomically, so a killed run never leaves half a file."""
    target = Path(path)
    scratch = target.with_name(target.name + ".partial")
    scratch.write_text(json.dumps(receipt, indent=2) + "\n")
    os.replace(scratch, target)


CRATE_SRC = re.compile(r"^crates/([A-Za-z0-9_-]+)/src/(.+)\.rs$")


def package_for(path: str) -> str | None:
    """The package that owns a source path: its crate directory under crates/ (names match)."""
    found = CRATE_SRC.match(path)
    return found.group(1) if found else None


def module_of(path: str) -> str | None:
    """crates/rsid/src/a/b.rs -> a::b ; a/mod.rs -> a ; lib.rs/main.rs -> None."""
    found = CRATE_SRC.match(path)
    if found:
        parts = found.group(2).split("/")
        if parts[-1] == "mod":
            parts.pop()
        if parts and parts != ["lib"] and parts != ["main"]:
            return "::".join(parts)
    return None


MOD_DECL = re.compile(r"^([ \t]*)(?:pub(?:\([^)]*\))?\s+)?mod\s+([A-Za-z_][A-Za-z_0-9]*)\s*(;|\{)")
PATH_ATTR = re.compile(r'#\[\s*path\s*=\s*"([^"]+)"\s*\]')
INCLUDE = re.compile(r'^\s*include!\(\s*"([^"]+)"\s*\)\s*;')
ATTR_LINE = re.compile(r"^\s*#\[")
MOD_ROOTS = ("lib.rs", "main.rs")


def read_blobs(repo, head, paths):
    """{path: text} for `paths` at `head` in one `git cat-file --batch` round trip."""
    request = "".join(f"{head}:{p}\n" for p in paths)
    result = subprocess.run(["git", "cat-file", "--batch"], cwd=repo, input=request.encode(), capture_output=True)
    out, data, position = {}, result.stdout, 0
    for path in paths:
        end = data.find(b"\n", position)
        if end < 0:
            break
        header = data[position:end].split()
        position = end + 1
        if len(header) == 3 and header[1] == b"blob":
            size = int(header[2])
            out[path] = data[position : position + size].decode("utf-8", "replace")
            position += size + 1
    return out


@functools.lru_cache(maxsize=None)
def mod_declarations(text):
    """[(name, path_attr or None, inline_stack, host_off)] for the `mod x;` lines of one source.

    An `include!("x.rs");` line yields (None, "x.rs", inline_stack, host_off).

    `inline_stack` is the chain of enclosing `mod y {` blocks (rustfmt indentation
    pairs each block's closing brace with its opener). `host_off` is whether a
    plain `#[cfg(target_os = ..)]` on the declaration or an enclosing inline block
    leaves it out of a build on this host (#2291).
    """
    found, stack, lines = [], [], text.split("\n")
    for index, line in enumerate(lines):
        if stack and line.startswith(stack[-1][0] + "}") and line.rstrip() in (stack[-1][0] + "}", stack[-1][0] + "};"):
            stack.pop()
            continue
        include = INCLUDE.match(line) if "include!" in line else None
        if include:
            # `include!("x.rs");` splices the file into the enclosing module.
            found.append((None, include.group(1), [n for _, n, _ in stack], any(off for _, _, off in stack)))
            continue
        if "mod " not in line:
            continue
        indent = line[: len(line) - len(line.lstrip())]
        # `#[path = "x.rs"] mod m;` on one line: peel the leading attributes.
        rest, attr, peeled = line, None, []
        while rest.lstrip().startswith("#[") and "]" in rest:
            attr = PATH_ATTR.search(rest) or attr
            head, rest = rest.split("]", 1)
            peeled.append(head.strip() + "]")
        match = MOD_DECL.match(indent + rest.lstrip())
        if not match:
            continue
        _, name, terminator = match.groups()
        own_off = gated_to_other_os("\n".join(peeled + attrs_above(lines, index)))
        if terminator == "{":
            stack.append((indent, name, own_off))
            continue
        back = index - 1
        while attr is None and back >= 0 and ATTR_LINE.match(lines[back]):
            attr = PATH_ATTR.search(lines[back])
            back -= 1
        found.append((name, attr.group(1) if attr else None, [n for _, n, _ in stack],
                      own_off or any(off for _, _, off in stack)))
    return tuple(found)


def attrs_above(lines, index):
    """The contiguous `#[..]` rows directly above line `index`."""
    rows, back = [], index - 1
    while back >= 0 and ATTR_LINE.match(lines[back]):
        rows.append(lines[back])
        back -= 1
    return rows


def mount_closure(files, root, gated_off=None):
    """{source path: module path} of every source mounted from `root` through `mod`, `#[path]` and `include!`.

    `root` is a crate or target root (`lib.rs`, `main.rs`, `src/bin/x.rs`,
    `tests/x.rs`): its `mod x;` lines resolve beside it and it maps to "".

    When `gated_off` is a set, it receives every mounted source that no declaration
    chain from `root` reaches without a `cfg(target_os)` gate leaving it out of a
    build on this host (#2291). A source also mounted through an ungated chain stays out.
    """
    mapped = {root: ""}
    queue = [root]
    edges = []
    # Files a `#[path]` attribute mounted: rustc gives them module-root directory ownership, so
    # their own `mod x;` resolves beside them (`store/x.rs`), not under `store/<stem>/` (#1697).
    path_mounted = set()
    while queue:
        parent = queue.pop(0)
        directory, _, base = parent.rpartition("/")
        own = directory if parent == root or parent in path_mounted or base in ("mod.rs", *MOD_ROOTS) else f"{directory}/{base[:-3]}"
        for name, attr, inline, off in mod_declarations(files[parent]):
            if name is None:
                target = posixpath.normpath(posixpath.join(directory, attr))
                if target in files:
                    edges.append((parent, target, off))
                if target in files and target not in mapped:
                    mapped[target] = "::".join(part for part in (mapped[parent], *inline) if part)
                    queue.append(target)
                continue
            if attr is not None:
                anchor = posixpath.join(directory if not inline else posixpath.join(own, *inline), attr)
                candidates = [posixpath.normpath(anchor)]
            else:
                anchor = posixpath.join(own, *inline)
                candidates = [f"{anchor}/{name}.rs", f"{anchor}/{name}/mod.rs"]
            target = next((c for c in candidates if c in files), None)
            if target is not None:
                edges.append((parent, target, off))
            if target is None or target in mapped:
                continue
            prefix = [part for part in (mapped[parent], *inline, name) if part]
            mapped[target] = "::".join(prefix)
            if attr is not None:
                path_mounted.add(target)
            queue.append(target)
    if gated_off is not None:
        ungated = collections.defaultdict(list)
        for source, target, off in edges:
            if not off:
                ungated[source].append(target)
        live, frontier = {root}, [root]
        while frontier:
            for target in ungated[frontier.pop()]:
                if target not in live:
                    live.add(target)
                    frontier.append(target)
        gated_off.update(set(mapped) - live)
    return mapped


def module_map(files, gated_off=None):
    """{source path: crate-relative module path} by following `mod` and `#[path]` from each crate root.

    The module path is what a test's name starts with, so a test mounted with
    `#[path = "manager_issue_worker.rs"] mod issue_worker;` in `manager_actions.rs`
    is `...::manager_actions::issue_worker`, not what its file name suggests.
    """
    mapped = {}
    roots = sorted(p for p in files if re.fullmatch(r"crates/[^/]+/src/(?:lib|main)\.rs", p))
    # One root per crate: lib.rs wins over main.rs (a bin target's modules are its own).
    chosen = {}
    for root in roots:
        crate = root.rsplit("/", 1)[0]
        if crate not in chosen or root.endswith("lib.rs"):
            chosen[crate] = root
    for root in chosen.values():
        for path, module in mount_closure(files, root, gated_off).items():
            mapped.setdefault(path, module)
    return mapped


# Appended (never prepended: diff line numbers stay put) to the text of a source that is
# mounted only behind a `cfg(target_os)` gate leaving it out of a build on this host.
# rust_functions and holds_runnable_test read it, so no consumer of a tree text needs
# to know which declaration gated it (#2291).
HOST_GATED_OFF = "\n// rsi-host-gated-off: mounted only behind a cfg(target_os) that excludes this host\n"


def mark_gated_off(texts, gated_off):
    for path in gated_off:
        if path in texts and not texts[path].endswith(HOST_GATED_OFF):
            texts[path] += HOST_GATED_OFF


class SourceTree:
    """The head tree's Rust sources, their real module paths and test shards."""

    def __init__(self, repo, head, tree_files):
        self.repo, self.head, self.tree_files = repo, head, tree_files
        sources = [f for f in tree_files if f.endswith(".rs") and re.match(r"crates/[^/]+/src/", f)]
        self.texts = read_blobs(repo, head, sources)
        gated_off = set()
        self.modules = module_map(self.texts, gated_off)
        mark_gated_off(self.texts, gated_off)
        self._test_files = None
        self._shard_counts = None
        self._functions = None
        self._function_paths = None
        self._frequency = None
        self._targets = None
        self._mounts = {}
        self._loaded_packages = set()

    def text(self, path):
        if path not in self.texts:
            shown = git(self.repo, "show", f"{self.head}:{path}")
            self.texts[path] = shown.stdout if shown.returncode == 0 else ""
        return self.texts[path]

    def module(self, path):
        """Module path of a source: the mounted one, else the one its file name implies."""
        return self.modules.get(path) or module_of(path)

    def child_sources(self, path):
        """The file, its module-directory children and every module mounted beneath it."""
        found = child_sources(path, self.tree_files)
        mounted = self.modules.get(path)
        if self.lib_mounted(path):
            # A file under the module directory that no target mounts is never compiled (rustc
            # resolves a `#[path]`-mounted file's `mod tests;` beside it, #1697): it covers nothing.
            found = [f for f in found if f == path or not f.endswith(".rs") or f in self.modules or self.target_owners(f)]
        if mounted:
            found += [f for f, m in self.modules.items() if m.startswith(mounted + "::") and f not in found]
        return found

    def has_tests(self, path):
        return any(holds_runnable_test(self.text(source)) for source in self.child_sources(path))

    def targets(self):
        """{package: [(kind, name, root)]}: the binary and integration test targets Cargo discovers."""
        if self._targets is None:
            self._targets = {}
            for path in self.tree_files:
                found = TARGET_ROOT.match(path)
                if found:
                    package, main, binary, integration = found.groups()
                    kind, name = ("bin", package) if main else ("bin", binary) if binary else ("test", integration)
                    self._targets.setdefault(package, []).append((kind, name, path))
        return self._targets

    def load_package(self, package):
        """Read every Rust source and integration test of `package` (once), so mounts can resolve."""
        if package not in self._loaded_packages:
            self._loaded_packages.add(package)
            prefix = f"crates/{package}/"
            missing = [f for f in self.tree_files if f.startswith(prefix) and f.endswith(".rs") and f not in self.texts]
            self.texts.update(read_blobs(self.repo, self.head, missing))

    def mounted(self, package, root):
        """Sources compiled into the target rooted at `root` (the root included)."""
        if root not in self._mounts:
            self.load_package(package)
            gated_off = set()
            self._mounts[root] = mount_closure(self.texts, root, gated_off) if root in self.texts else {root: ""}
            # A source the library also mounts is judged by the library's declarations.
            mark_gated_off(self.texts, gated_off - set(self.modules))
        return self._mounts[root]

    def target_owners(self, path):
        """[(package, kind, name)] of the binary and integration test targets that compile `path` (#1937, #1650).

        A file counts when a target root mounts it (`mod`, `#[path]`, `include!`),
        else by Cargo's directory layout: `src/bin/NAME/`, `tests/NAME/` of a
        `tests/NAME.rs` or `tests/NAME/main.rs` target. Library mounts do not count.
        """
        found = re.match(r"crates/([a-z0-9_-]+)/(?:src|tests)/", path)
        if not found or not path.endswith(".rs"):
            return []
        package = found.group(1)
        targets = self.targets().get(package, [])
        owners = [(package, kind, name) for kind, name, root in targets if path in self.mounted(package, root)]
        if not owners:
            layout = re.match(rf"crates/{re.escape(package)}/(?:src/bin/([A-Za-z0-9_-]+)|tests/([A-Za-z0-9_-]+))/", path)
            if layout and layout.group(1):
                owners = [(package, "bin", layout.group(1))]
            elif layout and any(kind == "test" and name == layout.group(2) for kind, name, _ in targets):
                owners = [(package, "test", layout.group(2))]
        return owners

    def target_declares_tests(self, package, kind, name):
        """Whether a source of the target (mounted, or beside its `main.rs`/`NAME.rs`) holds a test."""
        for k, n, root in self.targets().get(package, []):
            if (k, n) != (kind, name):
                continue
            self.load_package(package)
            if root.endswith("/main.rs") and not root.endswith("/src/main.rs"):
                members = {f for f in self.tree_files if f.startswith(root[: -len("main.rs")]) and f.endswith(".rs")}
            else:
                members = {f for f in child_sources(root, self.tree_files) if f.endswith(".rs")}
            members |= set(self.mounted(package, root))
            if any(holds_runnable_test(self.text(source)) for source in members):
                return True
        return False

    def target_filters(self, path):
        """Landing filters of every bin/integration target that compiles `path` and holds a test."""
        filters = []
        for package, kind, name in self.target_owners(path):
            if self.target_declares_tests(package, kind, name):
                filters.append(f"{package}={kind}:{name}")
        return filters

    def lib_mounted(self, path):
        """Whether the package's library target compiles `path` (a package without lib.rs has none)."""
        package = package_for(path)
        return bool(package) and f"crates/{package}/src/lib.rs" in self.tree_files and path in self.modules

    def shards_for(self, path):
        found = set()
        for source in self.child_sources(path):
            found |= code_shards(self.text(source))
        return found

    def test_files(self):
        """[(module, shards, test function names)] of every test-bearing library source."""
        if self._test_files is None:
            self._test_files = [
                (self.module(f), test_shards(t), [name for name, _, _, attrs, _ in rust_functions(t) if TEST_ATTR.search(attrs)])
                for f, t in self.texts.items()
                if lib_source(f) and TEST_ATTR.search(t)
            ]
        return self._test_files

    def filter_matches(self, shard, module):
        """Whether `test(module)` selects a test of `shard`: some test-bearing library
        source gated for the shard has `module` in its module path (nextest's `test()`
        is a substring match on `module::path::fn`)."""
        return any(shard in shards and (module in mod or any(module in f"{mod}::{name}" for name in names))
                   for mod, shards, names in self.test_files() if mod)

    def foreign_tests(self, module):
        """Tests the substring filter `test(module)` selects outside `module`'s own tree (#1653).

        nextest matches `module` anywhere in `module::path::fn`: `test(deploy)` also
        selects `store::tests::v95_deployed_v94_bridge_...` and `satellite::deploy_link::...`."""
        prefix = module + "::"
        return sorted(full for mod, _, names in self.test_files() if mod
                      for full in (f"{mod}::{name}" for name in names)
                      if module in full and not full.startswith(prefix))

    def subtree_tests_everywhere(self, module):
        """Tests of every shard in `module` and the modules mounted beneath it (the anchored `^module::`)."""
        return sum(sum(counts.values()) for mod, counts in self.shard_test_counts()
                   if mod == module or mod.startswith(module + "::"))


    def shard_test_counts(self):
        """[(module, {shard: tests})] of the sharded library sources (a cheap scan, no parsing)."""
        if self._shard_counts is None:
            self._shard_counts = []
            for path, text in self.texts.items():
                if not lib_source(path) or not TEST_ATTR.search(text):
                    continue
                module, counts, lines = self.module(path), {}, text.split("\n")
                for index in range(1, len(lines)):
                    gate = TEST_GATE.match(lines[index - 1])
                    if gate and TEST_ATTR.match(lines[index].lstrip()):
                        counts[gate.group(1)] = counts.get(gate.group(1), 0) + 1
                if module and counts:
                    self._shard_counts.append((module, counts))
        return self._shard_counts

    def tests_selected(self, shard, module):
        """How many tests of `shard` the nextest filter `test(module)` selects (substring match)."""
        return sum(counts.get(shard, 0) for mod, counts in self.shard_test_counts() if module in mod)

    def direct_tests(self, shard, module):
        """Tests of `shard` declared directly in `module`, not in a module mounted beneath it."""
        return sum(counts.get(shard, 0) for mod, counts in self.shard_test_counts() if mod == module)

    def tests_selected_everywhere(self, module):
        """How many tests, in every shard, the nextest filter `test(module)` selects.

        A focused landing filter builds without shard features and matches module names
        across the whole binary, so its `shard:S:` label only routes it: the run selects
        the tests of every shard (#1698), not just those of the labelled one."""
        return sum(sum(counts.values()) for mod, counts in self.shard_test_counts() if module in mod)

    def direct_tests_everywhere(self, module):
        """Tests of every shard declared directly in `module` (the anchored `direct_filterset`)."""
        return sum(sum(counts.values()) for mod, counts in self.shard_test_counts() if mod == module)

    def test_children(self, module):
        """Modules mounted beneath `module` whose sources hold sharded tests."""
        return sorted(mod for mod, _ in self.shard_test_counts() if mod.startswith(module + "::"))

    def trace_module(self, path):
        """Module a function of `path` is traced under, or None when its source is not traced.

        A sharded library source keeps its crate-relative module. A leaf crate source (LEAF_FACADES,
        #2441) is prefixed with its crate name, so its modules never collide with rsid's own and
        its crate-root functions still have a name to trace under."""
        if lib_source(path):
            return self.module(path)
        if (package := leaf_package(path)):
            module = self.module(path)
            return package.replace("-", "_") + (f"::{module}" if module else "")
        return None

    def functions(self):
        """Every function of the sharded library sources and the leaf crates' sources
        (#2441): (name, module, is_test, shards, words, lines)."""
        if self._functions is None:
            self._functions, self._function_paths = [], []
            for path, text in self.texts.items():
                module = self.trace_module(path)
                if not module:
                    continue
                for name, start, end, attrs, body in rust_functions(text):
                    self._functions.append((name, module, bool(TEST_ATTR.search(attrs)), shards_in(attrs),
                                            set(WORD.findall(body)) - {name}, end - start))
                    self._function_paths.append(path)
        return self._functions

    def functions_without_initializers(self, fields, owned_field):
        """`functions()` where a function that mentions a unique private `field` only to initialize it
        (`field: Type::new(),` in a literal of the owning struct) no longer counts as mentioning it.

        The initializer stores a value; only the code that reads the field observes it. A function with
        any other mention of the field (a read, a write, a pattern, a comment) keeps the word."""
        base = self.functions()
        touched = {path for path, text in self.texts.items() if any(field in text for field in fields)}
        if not touched:
            return base
        result = [entry for entry, path in zip(base, self._function_paths) if path not in touched]
        owners = {owned_field(field) for field in fields} - {None}
        for path in touched:
            module = self.trace_module(path)
            text = self.texts[path]
            if not module:
                continue
            line_owners = type_owners(text, owners)
            for name, start, end, attrs, body in rust_functions(text):
                words, rows = set(WORD.findall(body)) - {name}, body.splitlines()
                enclosing = line_owners[start] if 0 <= start < len(line_owners) else None
                initializing = set()
                for field in fields & words:
                    mentions = [i for i, row in enumerate(rows) if field in WORD.findall(row)]
                    found = [initializer_value(rows, i, owned_field, enclosing) for i in mentions]
                    if all(item and item[0] == field for item in found):
                        words.discard(field)
                        initializing |= {(i, kind) for i, item in zip(mentions, found) for kind in item[1]}
                # A type named only by those initializers is no more an observer than the field.
                for kind in {kind for _, kind in initializing} & words:
                    mentions = {i for i, row in enumerate(rows) if kind in WORD.findall(row)}
                    if mentions <= {i for i, named in initializing if named == kind}:
                        words.discard(kind)
                result.append((name, module, bool(TEST_ATTR.search(attrs)), shards_in(attrs), words, end - start))
        return result

    def token_frequency(self):
        """{identifier: how many functions mention it}, to tell a rare identifier from a common one."""
        if self._frequency is None:
            self._frequency = {}
            for *_, words, _ in self.functions():
                for word in words:
                    self._frequency[word] = self._frequency.get(word, 0) + 1
        return self._frequency


WORD = re.compile(r"[A-Za-z_]\w*")
TEST_ATTR = re.compile(r"#\[(?:[a-z_]+::)?test\b")
TARGET = re.compile(r"^crates/([a-z0-9_-]+)/(?:src/main\.rs|src/bin/([A-Za-z0-9_-]+)(?:\.rs|/.+)|tests/([A-Za-z0-9_-]+)\.rs)$")


TARGET_ROOT = re.compile(
    r"^crates/([a-z0-9_-]+)/(?:src/(main)\.rs|src/bin/([A-Za-z0-9_-]+)(?:\.rs|/main\.rs)|tests/([A-Za-z0-9_-]+)(?:\.rs|/main\.rs))$")


def target_filter(sources, path):
    """The landing filter of the bin/integration target `path` belongs to, if it holds a test."""
    target = TARGET.match(path)
    if not target:
        return None
    package, binary, integration = target.groups()
    is_main = path == f"crates/{package}/src/main.rs"
    # A helper may hold no tests itself; select the owning binary's tests.
    root = f"crates/{package}/src/bin/{binary}.rs" if binary else path
    if not sources.has_tests(root):
        return None
    name = binary or (package if is_main else None)
    return f"{package}=bin:{name}" if name else f"{package}=test:{integration}"


def crate_root_test_filter(sources, path):
    """`PKG=tests::` for a non-sharded library root (lib.rs) that holds its own inline test module.

    The root has no module path, so no `PKG=module` filter names its tests (#2331). The
    name is a libtest substring: it also selects `child::tests::` modules, a safe superset.
    """
    package = package_for(path)
    if (not package or path != f"crates/{package}/src/lib.rs" or path.startswith(SHARDED_SRCS)
            or path not in sources.tree_files):
        return None
    text = sources.text(path)
    rows = text.splitlines()
    regions = [(start, end) for start, end in test_module_regions(text)
               if holds_runnable_test("\n".join(rows[start:end]))]
    return f"{package}=tests::" if regions else None


SCAN_INCLUDE = re.compile(r'\binclude_(?:str|bytes)!\(\s*"([^"]+)"\s*\)')


def rust_lexemes(text):
    """Comment/literal spans, preserving literals and nested block comments."""
    position, size = 0, len(text)
    while match := LITERAL.search(text, position):
        token, end = match.group(0), match.end()
        if token == "/*":
            depth = 1
            while depth and end < size:
                opener, closer = text.find("/*", end), text.find("*/", end)
                if closer < 0:
                    raise ValueError("unterminated Rust comment")
                if 0 <= opener < closer:
                    depth, end = depth + 1, opener + 2
                else:
                    depth, end = depth - 1, closer + 2
            if depth:
                raise ValueError("unterminated Rust comment")
        elif match.group("raw") is not None:
            closer = text.find('"' + match.group("hashes"), end)
            if closer < 0:
                raise ValueError("unterminated Rust raw string")
            end = closer + 1 + len(match.group("hashes"))
        elif token.endswith('"') and not token.startswith("//"):
            # A line comment that merely ends in a quote (`// as a "user"`) is
            # already closed at the newline, not an opening string (#2434).
            while end < size and text[end] != '"':
                end += 2 if text[end] == "\\" else 1
            if end >= size:
                raise ValueError("unterminated Rust string")
            end += 1
        yield ("comment" if token.startswith(("//", "/*")) else "literal"), match.start(), end
        position = end


def code_includes(text):
    """Literal source reads in code, excluding examples inside strings/comments."""
    try:
        spans = list(rust_lexemes(text))
    except ValueError:
        # Ambiguous source reads are retained conservatively.
        return list(SCAN_INCLUDE.finditer(text))
    masked, previous = [], 0
    for _, start, end in spans:
        masked.extend((text[previous:start], " " * (end - start)))
        previous = end
    masked.append(text[previous:])
    code = "".join(masked)
    return [match for match in SCAN_INCLUDE.finditer(text)
            if code[match.start():match.start() + 8] == "include_"]


@functools.lru_cache(maxsize=4096)
def code_text(text):
    """`text` with comments and string/char literals blanked, newlines and offsets kept (#2338).

    A source the lexer cannot close is returned whole: a conservative reading keeps
    whatever it would have matched."""
    try:
        spans = list(rust_lexemes(text))
    except ValueError:
        return text
    pieces, previous = [], 0
    for _, start, end in spans:
        pieces.extend((text[previous:start], re.sub(r"[^\n]", " ", text[start:end])))
        previous = end
    pieces.append(text[previous:])
    return "".join(pieces)


IGNORE_ATTR = re.compile(r"#\[ignore\b")


# Test-declaring attributes and macros TEST_ATTR does not model: `#[rstest]`, `#[test_case]`,
# `#[proptest]`, `proptest! {`, a deeper path ending in `::test`, and `#[cfg_attr(.., test)]`.
UNMODELLED_TEST = re.compile(
    r"#\[\s*(?:(?:\w+::)*(?:rstest|test_case|proptest|quickcheck|wasm_bindgen_test)\b"
    r"|(?:\w+::){2,}test\b"
    r"|cfg_attr\([^\]]*?,\s*(?:\w+::)*(?:test|rstest|test_case|proptest|quickcheck)\b)"
    r"|\b(?:proptest|quickcheck)!\s*[{(]")


@functools.lru_cache(maxsize=4096)
def holds_runnable_test(text):
    """Whether `text` may declare a test the gate runs (#2338, #2361).

    A `#[test]` named in a doc comment or a fixture string is not a test, and a source
    whose every test is a recognized `#[test]`/`#[tokio::test]` that is `#[ignore]`d runs
    nothing in the default test run, so a filter naming only it selects no test and the
    lander refuses the whole derived gate. Fail safe: the answer is False only when the
    scan proves it, so any test-like attribute the scan does not model keeps the filter."""
    if file_gated_off(text):
        return False
    code = code_text(text)
    if UNMODELLED_TEST.search(code):
        return True
    if not TEST_ATTR.search(code):
        return False
    declared = len(TEST_ATTR.findall(code))
    # A test gated to another OS is not compiled here (#2291), so it runs nothing, like an
    # ignored one. The gates are read from `text`: `code` blanks their string literal, and
    # blanking keeps every line where it was, so the spans of `code` index `text`.
    lines = text.splitlines()
    inert = sum(1 for _, start, _, attr in rust_function_spans(code)
                if TEST_ATTR.search("\n".join(lines[attr:start]))
                and (IGNORE_ATTR.search("\n".join(lines[attr:start]))
                     or function_gated_off(text, start, "\n".join(lines[attr:start]))))
    return declared > inert


RUST_TOKEN = re.compile(r"\w+|::|->|=>|\.\.=?|&&|\|\||[<>!=+*/%&|^-]=|<<=?|>>=?|[^\s]")


def rust_comment_only_change(before, after):
    """Equal executable tokens with changed comments, keeping every literal.

    Doc comments and nested block comments are prose for runtime selection.
    Explicit attributes and macro/string contents remain executable tokens;
    ambiguous lexing keeps ordinary coverage. Formatting alone is unchanged.
    """
    def contents(text):
        tokens, comments, previous = [], [], 0
        for kind, start, end in rust_lexemes(text):
            tokens.extend(RUST_TOKEN.findall(text[previous:start]))
            (comments if kind == "comment" else tokens).append(text[start:end])
            previous = end
        tokens.extend(RUST_TOKEN.findall(text[previous:]))
        return tokens, comments

    try:
        old, new = contents(before), contents(after)
    except ValueError:
        return False
    return old[0] == new[0] and old[1] != new[1]


def include_readers(repo, head, changed):
    """Rust sources under crates/ whose code include_str!s/include_bytes!s a changed file (#1769).

    These readers see a sibling source or data file as text, so a diff that
    leaves the reader untouched still changes what its tests observe: a bin or
    integration target (or a module one mounts), a library module's tests.
    """
    listing = git(repo, "grep", "-l", "-E", r"include_(str|bytes)!", head, "--", "crates")
    paths = [line.split(":", 1)[1] for line in listing.stdout.splitlines() if ":" in line]
    texts = read_blobs(repo, head, [p for p in paths if p.endswith(".rs")])
    found = []
    for path, text in texts.items():
        for match in code_includes(text):
            if posixpath.normpath(posixpath.join(posixpath.dirname(path), match.group(1))) in changed:
                found.append(path)
                break
    return found


# #1926: command, skill and prompt files are read as text by integration
# targets (`root.join(".claude/commands/x.md")`), so an edit to one changes what
# those tests observe although no Rust item changed.
ASSET_ROOTS = (".claude/commands", ".claude/skills", ".agents", ".codex/prompts", ".gemini/commands")


def asset_pattern(root):
    """A regex for a test source that names `root` as a literal path or as chained `.join` calls."""
    parts = root.split("/")
    return re.compile(r'(?:/|"\)\s*\.join\(")'.join(re.escape(part) for part in parts))


def asset_reader_targets(repo, head, tree_files, changed):
    """Target sources (integration tests, bins and the modules they mount) that read a changed command/skill/prompt asset."""
    roots = [r for r in ASSET_ROOTS if any(c == r or c.startswith(r + "/") for c in changed)]
    if not roots:
        return []
    patterns = [asset_pattern(r) for r in roots]
    candidates = [f for f in tree_files if f.endswith(".rs") and re.match(
        r"crates/[a-z0-9_-]+/(?:tests/.+|src/main\.rs|src/bin/.+)$", f)]
    texts = read_blobs(repo, head, candidates)
    return [f for f in candidates if any(rx.search(texts.get(f, "")) for rx in patterns)]


STRING_LITERAL = re.compile(r'"((?:[^"\\\n]|\\.)*)"')
GENERIC_DIRECTORIES = frozenset({"tests", "src", "crates", "test", "data"})


def literal_names_file(literal, relative, directories=False):
    """Whether a string literal names `relative`: by file name or path suffix, or (`directories`) a directory above it."""
    literal = literal.strip("/")
    parts = relative.split("/")
    if not literal:
        return False
    if literal == parts[-1] or relative == literal or relative.endswith("/" + literal):
        return True
    return (directories and len(literal) >= 4 and "/" not in literal
            and literal not in GENERIC_DIRECTORIES and literal in parts[:-1])


# #199: a path in a closed list of string literals that only in-memory code consumes is
# a fabricated fixture input (`classify(&["docs/x.md"], ..)`), not a read. The proof is
# fail-closed: the list must be consumed directly by a project function, a `for` loop or
# a safe macro, and every function it can reach must be provably in memory. A filesystem,
# environment or process word, a callback or generic parameter, a receiver or callee of
# unknown provenance, an unknown macro or a lexing ambiguity keeps the reader.
# `include!`, `include_str!`, `env!` and the like are macros: FIXTURE_SAFE_MACROS refuses them.
FIXTURE_OBSERVER_WORDS = frozenset({
    "fs", "File", "OpenOptions", "read_to_string", "read_to_end", "read_dir", "read_link",
    "metadata", "symlink_metadata", "canonicalize", "exists", "try_exists", "is_file", "is_dir",
    "env", "current_dir", "Command", "WalkDir", "walkdir", "tempdir", "TempDir", "manifest_dir",
    "CARGO_MANIFEST_DIR", "unsafe", "asm", "extern",
})
FIXTURE_SAFE_MACROS = frozenset({
    "assert", "assert_eq", "assert_ne", "debug_assert", "debug_assert_eq", "debug_assert_ne",
    "vec", "format", "matches", "panic", "write", "writeln", "unreachable", "todo", "unimplemented",
    "println", "eprintln", "dbg", "concat", "stringify",
})
# Methods of the standard library and iterators. A name is trusted only when the receiver
# is provably standard or project-owned (see FixtureFlow); a project definition of the
# same name is followed as well, and any other method name keeps the reader.
FIXTURE_STD_NAMES = frozenset({
    "new", "from", "into", "len", "iter", "iter_mut", "into_iter", "map", "filter", "collect", "contains",
    "insert", "push", "extend", "clone", "cloned", "copied", "unwrap", "expect", "is_empty", "to_owned",
    "to_string", "as_str", "as_ref", "join", "get", "any", "all", "cmp", "eq", "starts_with", "ends_with",
    "default", "sort", "dedup", "retain", "remove", "first", "last", "keys", "values", "chain", "zip",
    "enumerate", "rev", "take", "skip", "find", "position", "unwrap_or", "unwrap_or_default", "ok",
    "err", "is_some", "is_none", "is_ok", "is_err", "and_then", "ok_or", "with_capacity",
    "next", "peek", "pop", "max", "min", "count", "lines", "split", "split_once", "rsplit", "rsplit_once",
    "strip_prefix", "strip_suffix", "trim", "trim_start", "trim_end", "trim_matches", "trim_start_matches",
    "trim_end_matches", "contains_key", "entry", "or_default", "or_insert_with", "or_insert", "try_from",
    "from_str", "as_bytes", "chars", "is_some_and", "is_none_or", "map_or", "map_or_else", "flat_map",
    "filter_map", "flatten", "find_map", "then", "then_some", "saturating_sub", "saturating_add", "to_vec",
    "as_slice", "peekable", "sort_by_key", "get_or_insert", "get_or_insert_with", "or_else", "as_mut",
    "extend_from_slice", "is_ascii_digit", "is_ascii_alphanumeric", "is_ascii_whitespace", "is_alphabetic",
    "is_alphanumeric", "is_whitespace", "windows", "or", "to_ascii_lowercase", "to_lowercase",
})
# Types whose values hold data and run no code of their own.
FIXTURE_STD_TYPES = frozenset({
    "Vec", "String", "Option", "Result", "HashMap", "HashSet", "BTreeMap", "BTreeSet", "VecDeque",
    "Box", "Rc", "Arc", "Cow", "Ordering", "Range", "Self", "Path", "PathBuf", "Some", "None", "Ok", "Err",
    "u8", "u16", "u32", "u64", "u128", "usize", "i8", "i16", "i32", "i64", "i128", "isize", "f32", "f64",
    "bool", "char", "str",
})
FIXTURE_STD_MODULES = frozenset({"mem", "cmp", "iter", "str", "char", "slice", "array", "collections"})
FIXTURE_ROOT_MODULES = frozenset({"self", "super", "crate"})
# External in-memory parsers: they take a string or bytes, never a path or a reader.
FIXTURE_PURE_PATHS = frozenset({
    ("toml", "from_str"), ("serde_json", "from_str"), ("serde_json", "from_slice"),
    ("serde_json", "to_string"), ("serde_json", "to_value"), ("serde_json", "from_value"),
})
FIXTURE_KEYWORDS = frozenset({
    "if", "while", "match", "for", "in", "return", "loop", "else", "fn", "let", "mut", "move", "as",
    "where", "impl", "pub", "dyn", "ref", "async", "await", "break", "continue", "use", "mod", "const",
    "static", "struct", "enum", "trait", "type", "crate", "self", "super", "Self", "unsafe",
})
FIXTURE_CALL = re.compile(r"(?P<dot>\.\s*)?\b(?P<name>[A-Za-z_]\w*)(?:(?P<bang>!)\s*[(\[{]|\s*(?:::<[^()]*>)?\s*\()")
FN_NAMES = re.compile(r"\bfn\s+([A-Za-z_]\w*)")
TYPE_NAMES = re.compile(r"\b(?:struct|enum|union|trait|type)\s+([A-Z]\w*)")
MOD_NAMES = re.compile(r"\bmod\s+([A-Za-z_]\w*)")
FIXTURE_UNSAFE_SIGNATURE = re.compile(r"\b(?:impl|dyn|fn|Fn|FnMut|FnOnce|where)\b")
FIXTURE_CLOSURE_BINDING = r"\blet\s+(?:mut\s+)?{name}\s*(?::[^=;]*)?=\s*(?:move\s*)?\|"


def fixture_enclosing(code, position):
    """Offset of the nearest unmatched opening bracket before `position`, or None."""
    depth = 0
    for index in range(position - 1, -1, -1):
        char = code[index]
        if char in ")]}":
            depth += 1
        elif char in "([{":
            if depth == 0:
                return index
            depth -= 1
    return None


def fixture_list_consumer_ok(code, start, end, resolves):
    """Whether the closed string list around [start, end) is consumed in memory, directly.

    The list may sit in nested tuples or lists, but its first real consumer must be a
    `for .. in` head, a safe macro or a call of a project function. A method call on the
    list or on its holder, a `let` binding, a block, an index or a std/external callee keeps
    the reader (the value could flow anywhere).
    """
    left = start
    while left > 0 and (code[left - 1].isspace() or code[left - 1] == ","):
        left -= 1
    right = end
    while right < len(code) and (code[right].isspace() or code[right] == ","):
        right += 1
    if left == 0 or right >= len(code) or code[left - 1] != "[" or code[right] != "]":
        return False
    position, after = left - 1, right + 1
    # `&[..][..]` reslicing is allowed; a method on the list (`.iter().for_each(read)`) is not.
    rest = code[after:].lstrip()
    if rest.startswith("[") and (reslice := re.match(r"\[\s*\.\.\s*\]", rest)):
        rest = rest[reslice.end():].lstrip()
    if rest.startswith((".", "?")):
        return False
    for _ in range(8):
        before = code[:position].rstrip()
        before = re.sub(r"&\s*(?:mut\s+)?$", "", before).rstrip()
        if re.search(r"\bin$", before):
            return True
        opener = fixture_enclosing(code, len(before))
        if opener is None:
            return False
        head = code[:opener].rstrip()
        if code[opener] == "{":
            return False
        if code[opener] == "[":
            if head.endswith("!"):
                if re.search(r"\bvec\s*!$", head) is None:
                    return False
            elif re.search(r"\bin$", head):
                return True
            elif not (head[-1:] in ("&", "(", ",", "=", "[", ":") or not head):
                return False
            position = opener
            continue
        if head.endswith("!"):
            macro = re.search(r"([A-Za-z_]\w*)\s*!$", head)
            return bool(macro) and macro.group(1) in FIXTURE_SAFE_MACROS
        callee = re.search(r"(\.\s*)?\b([A-Za-z_]\w*)(?:\s*::\s*<[^()]*>)?$", head)
        if not callee or callee.group(2) in FIXTURE_KEYWORDS or callee.group(2)[0].isupper():
            position = opener
            continue
        return not callee.group(1) and resolves(callee.group(2))
    return False


def fixture_calls(body):
    """[(name, kind, qualifier)] for every call of `body`; kind is macro, method, bare or path."""
    calls = []
    for match in FIXTURE_CALL.finditer(body):
        name = match.group("name")
        before = body[:match.start("name")]
        if name in FIXTURE_KEYWORDS or re.search(r"\bfn\s+$", before) or name[0].isupper():
            continue
        if match.group("bang"):
            calls.append((name, "macro", None))
        elif match.group("dot"):
            calls.append((name, "method", None))
        elif qualifier := re.search(r"([A-Za-z_]\w*)\s*::\s*$", before):
            calls.append((name, "path", qualifier.group(1)))
        else:
            calls.append((name, "bare", None))
    return calls


def fixture_variants(code):
    """Variant names of the enums declared in `code`: they are values, not foreign types."""
    names = set()
    for match in re.finditer(r"\benum\s+[A-Za-z_]\w*[^{;]*\{", code):
        depth, index, segment = 1, match.end(), []
        while index < len(code) and depth:
            char = code[index]
            depth += char in "{([" and 1 or char in "})]" and -1 or 0
            if depth == 1 and char == "," or depth == 0:
                found = re.search(r"\b([A-Z]\w*)", "".join(segment))
                if found:
                    names.add(found.group(1))
                segment = []
            else:
                segment.append(char)
            index += 1
    return names


def fixture_declaration(code, name):
    """The text of `struct|enum|union name`, fields and variants included, or None when it cannot be read."""
    match = re.search(rf"\b(?:struct|enum|union)\s+{re.escape(name)}\b", code)
    if not match:
        return None
    index, depth = match.end(), 0
    while index < len(code):
        char = code[index]
        if char in "{(":
            depth += 1
        elif char in "})":
            depth -= 1
            if depth == 0:
                return code[match.start():index + 1]
        elif char == ";" and depth == 0:
            return code[match.start():index]
        index += 1
    return None


CALLBACK_TYPE = re.compile(r"\b(?:dyn|impl)\s+\w|\bfn\s*\(|\bFn(?:Mut|Once)?\s*[(<]")


def fixture_split(text):
    """Top-level comma-separated pieces of `text` (brackets and generics balanced; `->` is not a bracket)."""
    pieces, depth, current = [], 0, []
    for index, char in enumerate(text):
        if char in "([{<":
            depth += 1
        elif char in ")]}":
            depth -= 1
        elif char == ">" and text[index - 1:index] != "-":
            depth -= 1
        if char == "," and depth == 0:
            pieces.append("".join(current))
            current = []
        else:
            current.append(char)
    pieces.append("".join(current))
    return [piece.strip() for piece in pieces if piece.strip()]


def fixture_callback_fields(declaration):
    """({callback field: type}, declaration without those types) of a braced struct, or None when callbacks sit anywhere else."""
    if not CALLBACK_TYPE.search(declaration):
        return {}, declaration
    match = re.match(r"struct\s+\w+[^{;(]*\{(.*)\}$", declaration, re.S)
    if not match:
        return None
    fields, plain = {}, []
    for piece in fixture_split(match.group(1)):
        name, _, kind = piece.partition(":")
        if CALLBACK_TYPE.search(kind):
            fields[name.strip().removeprefix("pub").strip()] = kind.strip()
        else:
            plain.append(piece)
    return fields, " ".join(plain)


def fixture_blocks(code, opener):
    """[(header, body)] of every block whose header matches the `opener` regex, braces balanced."""
    blocks = []
    for match in re.finditer(opener, code):
        depth, index = 1, match.end()
        while index < len(code) and depth:
            depth += code[index] == "{" and 1 or code[index] == "}" and -1 or 0
            index += 1
        blocks.append((match.group(1), code[match.end():index - 1]))
    return blocks


def fixture_constant(code, name):
    """(type text, value text) of `const|static name: T = value;`, brackets balanced, or None."""
    match = re.search(rf"\b(?:const|static)\s+(?:mut\s+)?{re.escape(name)}\s*:", code)
    if not match:
        return None
    depth, equals, index = 0, None, match.end()
    while index < len(code):
        char = code[index]
        if char in "([{":
            depth += 1
        elif char in ")]}":
            depth -= 1
        elif char == "=" and depth == 0 and equals is None and code[index + 1:index + 2] != ">":
            equals = index
        elif char == ";" and depth == 0:
            return (code[match.end():equals], code[equals + 1:index]) if equals is not None else None
        index += 1
    return None


def fixture_type_words(text, types):
    """Capitalized words of `text` that are neither constants nor known types, after dropping std paths."""
    text = re.sub(r"\b(?:std|core|alloc)(?:\s*::\s*\w+)*\s*::\s*", "", text)
    return {word for word in WORD.findall(text)
            if word[0].isupper() and not word.isupper() and word not in types}


class FixtureFlow:
    """Fail-closed call closure inside one Rust source, for the synthetic path-list proof (#199).

    A callee, receiver type, callback or macro the file itself does not define or the
    standard library does not own keeps the reader: a name-based walk across the whole
    tree reaches unrelated code through shared names, and cannot prove what a foreign
    function does with a path.
    """

    def __init__(self, texts):
        self.texts = texts
        self.defined = {}
        for path, text in texts.items():
            for name in set(FN_NAMES.findall(text)):
                self.defined.setdefault(name, set()).add(path)
        self._files, self.paramless, self._codes, self._trait_methods, self._workspace = {}, False, None, None, None

    def file(self, path):
        """(bodies {name: [(signature, body, raw body)]}, aliases, types, modules, code, own types) of a source, or None when its lexing is ambiguous."""
        if path not in self._files:
            text = self.texts[path]
            code = code_text(text)
            if code is text or len(code) != len(text):
                self._files[path] = None
            else:
                lines, raw_lines = code.splitlines(), text.splitlines()
                bodies = {}
                for name, first, last, _attr in rust_function_spans(text):
                    body = "\n".join(lines[first:last])
                    if not re.search(rf"\bfn\s+{re.escape(name)}\b", body):
                        continue  # a `fn` quoted inside a string literal
                    bodies.setdefault(name, []).append((body.split("{", 1)[0], body, "\n".join(raw_lines[first:last])))
                aliases = {alias for use in re.findall(r"\buse\b[^;]*;", code)
                           for alias in re.findall(r"\bas\s+(\w+)", use)}
                own = set(TYPE_NAMES.findall(code))
                types = own | fixture_variants(code) | FIXTURE_STD_TYPES
                modules = set(MOD_NAMES.findall(code))
                self._files[path] = bodies, aliases, types, modules, code, own
        return self._files[path]

    @staticmethod
    def signature_ok(signature, types):
        """Whether every parameter is plain data: no callback, trait object, generic or foreign type."""
        declared = re.search(r"\bfn\s+\w+", signature)
        if not declared:
            return False
        signature = re.sub(r"^\s*<\s*(?:'\w+\s*,?\s*)*>", "", signature[declared.end():])
        if re.match(r"\s*<", signature) or FIXTURE_UNSAFE_SIGNATURE.search(signature):
            return False
        return all(word in types for word in WORD.findall(signature) if word[0].isupper())

    @staticmethod
    def local_names(body):
        """Names `body` binds itself: `let`/`for` patterns, `name:` parameters and fields, closure parameters and match-arm patterns."""
        names = set()
        for pattern in (r"\b(?:let|for)\b([^=;{}]*?)(?:=|\bin\b)", r"(?:[(,=]|\bmove)\s*\|([^|;{}]*)\|"):
            for found in re.findall(pattern, body):
                names.update(WORD.findall(found))
        names.update(re.findall(r"\b([A-Za-z_]\w*)\s*:(?!:)", body))
        for arrow in re.finditer(r"=>", body):
            depth, index = 0, arrow.start() - 1
            while index >= 0:
                char = body[index]
                if char in ")]":
                    depth += 1
                elif char in "([":
                    depth -= 1
                    if depth < 0:
                        break
                elif depth == 0 and (char in "{};," or body[index - 1:index + 1] == "=>"):
                    break
                index -= 1
            names.update(WORD.findall(body[index + 1:arrow.start()]))
        return names

    def reach(self, path, name):
        """[(file, name)] a call or callback named `name` reaches from `path`, or None when it is ambiguous.

        The file's own function wins; otherwise the name must have exactly one definition
        in the loaded sources, so a shared name never drags in unrelated code.
        """
        parsed = self.file(path)
        if parsed is not None and name in parsed[0]:
            return [(path, name)]
        places = self.defined.get(name, ())
        return [(next(iter(places)), name)] if len(places) == 1 else None

    def call_ok(self, path, parsed, body, name, kind, qualifier):
        """The functions a call reaches, or None when it cannot be proved in memory."""
        types, modules = parsed[2], parsed[3]
        if kind == "macro":
            return [] if name in FIXTURE_SAFE_MACROS else None
        if kind == "bare":
            if name == "drop" or re.search(FIXTURE_CLOSURE_BINDING.format(name=re.escape(name)), body):
                return []
            return self.reach(path, name)
        if kind == "path":
            if (qualifier in FIXTURE_STD_MODULES and qualifier not in modules) or (qualifier, name) in FIXTURE_PURE_PATHS:
                return []
            if qualifier not in types and qualifier not in modules and qualifier not in FIXTURE_ROOT_MODULES:
                return None
            if name in parsed[0]:
                return [(path, name)]
            # `derive(Default)` cannot read; any other associated function of a project type is followed.
            if name in FIXTURE_STD_NAMES and name in self.trait_methods():
                return None
            if (name in FIXTURE_STD_NAMES and qualifier in FIXTURE_STD_TYPES) or (name == "default" and qualifier in types):
                return []
            return self.reach(path, name)
        # types_ok vetted every type in scope, so a std name is a std method and an own definition is followed.
        own = [(path, name)] if name in parsed[0] else None
        if own:
            return own
        if name in FIXTURE_STD_NAMES:
            return None if name in self.trait_methods() or self.foreign_imports(path) else []
        return self.reach(path, name)

    def callbacks(self, path, parsed, body, raw, name, words):
        """Functions `body` names without calling them (a callback value), or None when one is ambiguous."""
        called = {callee for callee, _kind, _ in fixture_calls(body)}
        named, local = [], self.local_names(body)
        for word in sorted(words - FIXTURE_STD_NAMES - FIXTURE_KEYWORDS - called - local):
            if word == name or word not in self.defined or not any(
                    not re.search(r"(?:\.\s*|')$", body[:found.start()])
                    for found in re.finditer(rf"\b{re.escape(word)}\b", body)
                    if raw[found.end():found.end() + 1] not in ("'", '"')):
                continue
            reached = self.reach(path, word)
            if reached is None:
                return None
            named.extend(reached)
        return named

    def implemented_elsewhere(self, where, type_name):
        """Whether `type_name` has a trait `impl` anywhere in its crate, or an inherent `impl` in another source.

        A trait impl (Drop, Deref, Index, IntoIterator, From, a user trait) can run code
        at a place that names no call, so the walk cannot see it: any such type keeps
        the reader. An inherent impl elsewhere adds methods the walk would not follow.
        """
        crate = where.split("/src/", 1)[0] + "/"
        trait_impl = re.compile(rf"\bimpl\b[^{{;]*\bfor\s+(?:&\s*(?:mut\s+)?)?{re.escape(type_name)}\b")
        if any(path.startswith(crate) and trait_impl.search(parsed_code) for path, parsed_code in self.codes()):
            return True
        pattern = re.compile(rf"\bimpl\b(?:\s*<[^{{;>]*>)?\s*(?:[^{{;]*\bfor\s+)?(?:&\s*)?{re.escape(type_name)}\b")
        return any(path != where and path.startswith(crate) and pattern.search(text)
                   for path, text in self.texts.items())

    def trait_methods(self):
        """Every method name a trait declares or an `impl .. for ..` block defines, in all loaded sources.

        A trait method can be called through any import spelling, alias, re-export, crate or
        generic target, and the walk does not resolve those. So a standard name that some
        trait also declares (`get`, `from`, `next`, ...) is never trusted as the standard method.
        """
        if self._trait_methods is None:
            names = set()
            for _path, code in self.codes():
                for _trait, body in fixture_blocks(code, r"\btrait\s+(\w+)[^{;]*\{"):
                    names.update(FN_NAMES.findall(body))
                for header, body in fixture_blocks(code, r"\bimpl\b([^{;]*)\{"):
                    if re.search(r"\bfor\b", header):
                        names.update(FN_NAMES.findall(body))
            self._trait_methods = names
        return self._trait_methods

    def foreign_imports(self, path):
        """Whether the file imports from a crate outside the loaded workspace sources (an unseen extension trait)."""
        if self._workspace is None:
            self._workspace = {p.split("/src/", 1)[0].removeprefix("crates/").replace("-", "_") for p in self.texts}
        code = dict(self.codes()).get(path, "")
        roots = {found.group(1) for found in re.finditer(r"\buse\s+(?:::)?(\w+)", code)}
        roots |= {name for group in re.findall(r"\buse\s*\{([^;]*)\}", code) for name in re.findall(r"(?:^|,)\s*(?:::)?(\w+)", group)}
        known = {"std", "core", "alloc", "crate", "self", "super"} | self._workspace | set(MOD_NAMES.findall(code))
        return bool(roots - known)

    def codes(self):
        """(path, code) of every loaded source with comments and literals blanked."""
        if self._codes is None:
            self._codes = [(path, code_text(text)) for path, text in self.texts.items()]
        return self._codes

    def types_ok(self, where, parsed, body):
        """Whether every type a body names is std, or declared here with vetted fields and no impl elsewhere.

        Only then is a std-named method on any receiver in the body a std method or
        an own definition the walk follows; a foreign type (closure parameter, field,
        let annotation) leaves the receiver opaque, so the reader is kept.
        """
        types, code, own = parsed[2], parsed[4], parsed[5]
        pending, vetted = [re.sub(r"(?<=::)\s*[A-Z]\w*", "", body)], set()
        while pending:
            text = pending.pop()
            if fixture_type_words(text, types):
                return False
            for word in WORD.findall(text):
                if word not in own or word in vetted:
                    continue
                vetted.add(word)
                declaration = fixture_declaration(code, word)
                if self.implemented_elsewhere(where, word):
                    return False
                if declaration is None:
                    continue
                split = fixture_callback_fields(declaration)
                if split is None or (split[0] and not self.callbacks_built_ok(word, split[0], body)):
                    return False
                pending.append(split[1])
        return True

    def callbacks_built_ok(self, type_name, fields, body):
        """Whether a type with callback fields is built in `body` only from closures bound there, never received.

        The walk's start function takes no parameters, so every value of the type
        comes from a struct literal in a walked body; each callback field of that
        literal must be a closure literal or a `let` closure the same body defines
        (and the walk scans). A struct update, a function value or a parameter keeps the reader.
        """
        if not self.paramless:
            return False
        for literal in re.finditer(rf"(?<!struct )(?<!impl )\b{re.escape(type_name)}\s*\{{", body):
            depth, index = 1, literal.end()
            while index < len(body) and depth:
                depth += body[index] in "{([" and 1 or body[index] in "})]" and -1 or 0
                index += 1
            for piece in fixture_split(body[literal.end():index - 1]):
                if piece.startswith(".."):
                    return False
                name, colon, value = piece.partition(":")
                name, value = name.strip(), (value if colon else name).strip()
                if name not in fields:
                    continue
                value = value.removeprefix("&").strip().removeprefix("mut ").strip()
                closure = re.fullmatch(r"\w+", value) and re.search(
                    FIXTURE_CLOSURE_BINDING.format(name=re.escape(value)), body)
                if not (closure or value.startswith(("|", "move |"))):
                    return False
        return True

    def constants_ok(self, parsed, body):
        """Whether every constant or static a body names is declared here and holds plain data, not a callback."""
        code, types = parsed[4], parsed[2]
        for word in set(WORD.findall(re.sub(r"::\s*[A-Z_0-9]+", "", body))):
            if not word.isupper() or word in types:
                continue
            declaration = fixture_constant(code, word)
            if declaration is None:
                return False
            kind, value = declaration
            if re.search(r"\b(?:fn|Fn|FnMut|FnOnce|dyn|impl)\b|\||\b[a-z_]\w*\s*\(", kind + "=" + value):
                return False
            if fixture_type_words(kind + " " + value, types):
                return False
        return True

    @staticmethod
    def path_values_ok(parsed, body):
        """Whether every lowercase path named but not called (`external::load` as a value) stays inside this crate's std or modules."""
        modules = parsed[3] | FIXTURE_STD_MODULES | FIXTURE_ROOT_MODULES
        for found in re.finditer(r"\b([a-z_]\w*)\s*::\s*([a-z_]\w*)\b(?!\s*[(!:<])", body):
            if found.group(1) not in modules and found.group(1) not in parsed[2]:
                return False
        return True

    def pure(self, path, start_name):
        """Whether `start_name` and every function it reaches stays in memory."""
        pending, seen = [(path, start_name)], set()
        parsed = self.file(path)
        self.paramless = parsed is not None and all(
            re.search(r"\bfn\s+\w+\s*\(\s*\)", signature) for signature, _b, _r in parsed[0].get(start_name, ()))
        while pending:
            if len(seen) > 200:
                return False
            where, name = pending.pop()
            if (where, name) in seen:
                continue
            seen.add((where, name))
            parsed = self.file(where)
            if parsed is None:
                return False
            for signature, body, raw in parsed[0].get(name, ()):
                words = set(WORD.findall(body))
                if words & FIXTURE_OBSERVER_WORDS or words & parsed[1] or not self.signature_ok(signature, parsed[2]):
                    return False
                if not (self.types_ok(where, parsed, body) and self.constants_ok(parsed, body)
                        and self.path_values_ok(parsed, body)):
                    return False
                for callee, kind, qualifier in fixture_calls(body):
                    resolved = self.call_ok(where, parsed, body, callee, kind, qualifier)
                    if resolved is None:
                        return False
                    pending.extend(resolved)
                named = self.callbacks(where, parsed, body, raw, name, words)
                if named is None:
                    return False
                pending.extend(named)
        return True


def synthetic_path_list_member(source, text, match, flow):
    """Whether the string literal at `match` only ever feeds in-memory fixture code (#199).

    True when it is an element of a closed list of string literals inside a function,
    the list is consumed directly in memory (`fixture_list_consumer_ok`) and the
    function's name-based call closure is provably in memory (`FixtureFlow.pure`).
    """
    parsed = flow.file(source)
    if parsed is None:
        return False
    code = code_text(text)
    if not fixture_list_consumer_ok(code, match.start(), match.end(), lambda name: flow.reach(source, name) is not None):
        return False
    line = text.count("\n", 0, match.start())
    owners = [(last - first, name) for name, first, last, _attr in rust_function_spans(text)
              if first <= line < last]
    return bool(owners) and flow.pure(source, min(owners)[1])


def data_readers(repo, head, sources, changed):
    """Rust sources that name a changed non-Rust file in a string literal.

    Fixtures and data are read at run time by a path literal, which no
    `include_str!` edge shows. A literal names the file by a path suffix
    anywhere under crates/ (a bare file name would match unrelated readers);
    within one package its name or a directory literal (`.join("fixtures")`)
    also names every file beneath it, outside `src/`. A path in a closed list of
    strings that only in-memory fixture code consumes is not a read (#199).
    """
    data = sorted(p for p in changed if not p.endswith(".rs") and not p.endswith(("Cargo.toml", "Cargo.lock")))
    if not data:
        return []
    needles = [arg for p in data for arg in ("-e", p.rsplit("/", 1)[-1])]
    listing = git(repo, "grep", "-l", "-F", *needles, head, "--", "crates")
    found = {line.split(":", 1)[1] for line in listing.stdout.splitlines() if ":" in line and line.endswith(".rs")}
    for path in data:
        located = re.match(r"crates/([a-z0-9_-]+)/((?!src/)[^/].*)$", path)
        if located:
            sources.load_package(located.group(1))
            found |= {f for f in sources.texts if f.startswith(f"crates/{located.group(1)}/")}
    texts = read_blobs(repo, head, [f for f in found if f not in sources.texts])
    texts.update({f: sources.texts[f] for f in found if f in sources.texts})
    readers = []
    flow = None
    for source in sorted(texts):
        matches = list(STRING_LITERAL.finditer(texts[source]))
        for path in data:
            located = re.match(rf"crates/([a-z0-9_-]+)/((?!src/)[^/].*)$", path)
            same_package = bool(located) and source.startswith(f"crates/{located.group(1)}/")
            # Across packages a literal must carry a path ("scripts/x.txt"): a bare
            # name ("SKILL.md", "Makefile") is named by unrelated readers.
            naming = [m for m in matches
                      if ("/" in m.group(1).strip("/") and literal_names_file(m.group(1), path))
                      or (same_package and literal_names_file(m.group(1), located.group(2), True))]
            if not naming:
                continue
            if flow is None:
                flow = FixtureFlow({**sources.texts, **texts})
            if all(synthetic_path_list_member(source, texts[source], m, flow) for m in naming):
                continue
            readers.append(source)
            break
    return readers


def reader_filters(sources, path):
    """Landing filters of a source that reads a changed file: its targets, or its library module's tests.

    A sharded rsid/rsid-store module is not named here: its readers come from
    `source_scanner_tests`, and the lander's own selection covers the rest.
    """
    filters = list(sources.target_filters(path))
    module = sources.module(path)
    package = package_for(path)
    if (package and module and not path.startswith(SHARDED_SRCS) and sources.lib_mounted(path)
            and holds_runnable_test(sources.text(path))):
        filters.append(f"{package}={module}")
    return filters


def source_scanner_tests(sources, changed):
    """Library source scanners and callers of their helpers, even long helpers.

    These edges are source reads, not runtime calls to the dispatcher. A file-
    level include conservatively selects its module's tests as well.
    """
    helpers, modules, picked = set(), set(), set()
    for path, text in sources.texts.items():
        if not lib_source(path):
            continue
        spans = list(rust_functions(text))
        for match in code_includes(text):
            target = posixpath.normpath(posixpath.join(posixpath.dirname(path), match.group(1)))
            if target not in changed:
                continue
            line = text.count("\n", 0, match.start())
            owner = next((fn for fn in spans if fn[1] <= line < fn[2]), None)
            if owner:
                helpers.add((sources.module(path), owner[0]))
            else:
                # A named source constant is observed by its readers, not by
                # every test in a large fixture module.
                binding = re.search(r"\bconst\s+(\w+)\s*:[^=\n]*=\s*$", text[:match.start()])
                if binding:
                    helpers.update((sources.module(path), name) for name, _, _, _, body in spans
                                   if binding.group(1) in WORD.findall(body))
                else:
                    modules.add(sources.module(path))
    functions = sources.functions()
    definitions = {}
    for name, module, is_test, _, _, _ in functions:
        if not is_test:
            definitions.setdefault(name, set()).add(module)

    def reads(module, words):
        return any(name in words and (module == owner or module.startswith(owner + "::")
                                     or len(definitions.get(name, ())) == 1)
                   for owner, name in helpers if owner)

    while True:
        callers = {(module, name) for name, module, is_test, _, words, _ in functions
                   if not is_test and reads(module, words)}
        if callers <= helpers:
            break
        helpers |= callers
    for name, module, is_test, shards, words, _ in functions:
        if is_test and ((module, name) in helpers or reads(module, words) or any(
                m and f"{module}::".startswith(m + "::") for m in modules)):
            picked.update((module, name, shard) for shard in shards)
    return sorted(picked)


INCLUDE_BINDING = re.compile(r"\b(?:const|static)\s+(\w+)\s*:[^=;]*=\s*$")
INCLUDE_EXTERNAL_CALLERS = 12


def include_item_tests(sources, changed):
    """The tests that observe a data file through the item that `include_str!`s it (#2057).

    A changed non-Rust file under a crate's `src/` (guidance markdown, a SQL or JSON
    asset) is observed through the const, static or function whose body holds the
    `include_str!`/`include_bytes!`. Seed from that item, follow its callers inside
    the including module (the observing-test closure of a central reader is the
    whole daemon, so it is not followed past the module), add the direct callers
    elsewhere and select the tests that name any of them. Returns
    [(module, name, shard)], or None when the closure is not bounded: a changed
    data file with no resolvable including item, a reader outside the sharded
    library sources, another literal reader, more than INCLUDE_EXTERNAL_CALLERS
    outside callers or more than BROAD_TEST_LIMIT tests. The caller then keeps
    today's behaviour (the lander's own selection).
    """
    data = {p for p in changed if not p.endswith(".rs") and re.match(r"crates/[^/]+/src/", p)}
    if not data:
        return []
    seeds, owned = {}, set()
    for path, text in sources.texts.items():
        if "include_" not in text:
            continue
        spans = list(rust_functions(text))
        for match in code_includes(text):
            target = posixpath.normpath(posixpath.join(posixpath.dirname(path), match.group(1)))
            if target not in data:
                continue
            module = sources.module(path) if lib_source(path) else None
            if not module:
                return None
            line = text.count("\n", 0, match.start())
            owner = next((fn for fn in spans if fn[1] <= line < fn[2]), None)
            binding = None if owner else INCLUDE_BINDING.search(text[:match.start()])
            name = owner[0] if owner else binding.group(1) if binding else None
            if name is None:
                return None
            seeds.setdefault(module, set()).add(name)
            owned.add(target)
    if owned != data:
        return None
    # Another reader of the file (a path literal in a test) is not an include edge: keep the lander's view.
    for path, text in sources.texts.items():
        for target in data:
            if posixpath.basename(target) in text and not any(
                    posixpath.normpath(posixpath.join(posixpath.dirname(path), m.group(1))) == target
                    for m in code_includes(text)):
                return None
    functions = sources.functions()
    picked, names = set(), set()
    for module, seed in seeds.items():
        inside = lambda owner: owner == module or owner.startswith(module + "::")
        reached = set(seed)
        while True:
            callers = {name for name, owner, is_test, _, words, _ in functions
                       if not is_test and inside(owner) and name not in reached and words & reached}
            if not callers:
                break
            reached |= callers
        outside = {name for name, owner, is_test, _, words, _ in functions
                   if not is_test and not inside(owner) and name not in reached and words & reached}
        if len(outside) > INCLUDE_EXTERNAL_CALLERS:
            return None
        names |= reached | outside
    for name, module, is_test, shards, words, _ in functions:
        if is_test and (words & names or any(name in seed and (module == m or module.startswith(m + "::"))
                                             for m, seed in seeds.items())):
            picked.update((module, name, shard) for shard in shards)
    if len({(m, n) for m, n, _ in picked}) > BROAD_TEST_LIMIT:
        return None
    return sorted(picked)


def source_tree_literal(literal):
    """A string literal naming a source tree or a Rust source (`src`, `../x/src`, `src/store`, `lib.rs`).

    Mirrors `source_tree_path` in crates/rsid/src/bin/rsi-rolling-land/test_impact.rs.
    """
    literal = literal.rstrip("/")
    return (literal == "src" or literal.endswith("/src") or literal.startswith("src/")
            or "/src/" in literal or literal.endswith(".rs"))


SIBLING_CRATE = re.compile(r"\.\./([A-Za-z0-9_-]+)/")


SCANNED_TOKENS = "scripts/scanned-tokens.json"


def scanned_token_tests(sources, old_sources, changed, merge_base, comment_only=frozenset()):
    """Registered source readers, shared with the lander's test_impact (#2495).

    Match the whole file on both sides: a predicate edit at an existing reader
    need not repeat its SQL token in the changed lines. Companion behavioural
    tests run for new readers too. Only production edits trigger this rule.
    A triggered test that cannot resolve fails derivation rather than dropping
    a mandatory observer. Older trees without a registry keep their selection.
    """
    raw = git(sources.repo, "show", f"{sources.head}:{SCANNED_TOKENS}")
    if raw.returncode:
        return []
    registry = json.loads(raw.stdout)
    if registry.get("version") != 1:
        raise ValueError("unsupported scanned-token registry version")
    triggered = set(registry["tokens"]) if SCANNED_TOKENS in changed else set()
    for path in changed:
        if (path in comment_only or not path.endswith(".rs")
                or not re.match(r"crates/[^/]+/src/", path)
                or is_test_module(sources.module(path) or "")):
            continue
        before = old_sources.text(path) if old_sources else git(
            sources.repo, "show", f"{merge_base}:{path}").stdout
        after = sources.text(path)
        old_lines, new_lines = changed_line_numbers(sources.repo, merge_base, sources.head, path)
        if only_test_lines(before, old_lines) and only_test_lines(after, new_lines):
            continue
        # Keep literals (SQL included), discard comments. Ambiguous lexing
        # retains the whole text conservatively.
        texts = []
        for text in (before, after):
            try:
                spans = [(a, b) for kind, a, b in rust_lexemes(text) if kind == "comment"]
                for a, b in reversed(spans):
                    text = text[:a] + " " * (b - a) + text[b:]
            except ValueError:
                pass
            texts.append(text)
        for token, rule in registry["tokens"].items():
            if package_for(path) in rule["packages"] and any(token in text for text in texts):
                triggered.add(token)
    picked = set()
    for token in sorted(triggered):
        for test in registry["tokens"][token]["tests"]:
            found = set()
            for path, text in sources.texts.items():
                if not lib_source(path) or package_for(path) != test["package"]:
                    continue
                module = sources.module(path)
                for name, _, _, attrs, _ in rust_functions(text):
                    if (TEST_ATTR.search(attrs) and not IGNORE_ATTR.search(attrs)
                            and f"{module}::{name}" == test["name"]):
                        found.update((module, name, shard) for shard in shards_in(attrs))
            if not found:
                raise ValueError(f"scanned-token test does not resolve: {test['package']}::{test['name']}")
            picked.update(found)
    return sorted(picked)


def source_reader_tests(sources, changed, comment_only=frozenset()):
    """Library tests that scan crate source trees, when a production source they read changed (#2034).

    A source scanner (e.g. `session::issue21_phase2_tests::p2_07_gate_permit_spine`
    reads every rsid-store production file) observes a change it does not name, so
    the focused tests that name the change cannot cover it. The set is derived from
    the test code itself with the lander's own rule (`source_readers` in
    rsi-rolling-land/test_impact.rs): a test that resolves the crate root
    (`CARGO_MANIFEST_DIR` or `manifest_dir!`, directly or through a test helper) and
    names a source-tree literal. It reads its own crate's `src/` plus every sibling
    named by a `../<crate>/` literal in the test or its root helpers. Only the
    sharded rsid/rsid-store library sources are listed; a comment-only edit keeps
    `source_scanner_tests`. Returns [(module, name, shard)].
    """
    touched = {package_for(p) for p in changed
               if p not in comment_only and package_for(p)
               and not (module_of(p) and is_test_module(module_of(p)))}
    if not touched:
        return []
    if getattr(sources, "_source_readers", None) is None:
        rows = []
        for path, text in sources.texts.items():
            module = sources.module(path) if lib_source(path) else None
            if not module:
                continue
            for name, _start, _end, attrs, body in rust_functions(text):
                is_test = bool(TEST_ATTR.search(attrs))
                if not (is_test or is_test_module(module)):
                    continue
                words = set(WORD.findall(body))
                literals = [m.group(1) for m in STRING_LITERAL.finditer(body)]
                rows.append({"name": name, "module": module, "package": package_for(path), "test": is_test,
                             "shards": shards_in(attrs), "words": words - {name}, "literals": literals,
                             "root": "CARGO_MANIFEST_DIR" in literals or "CARGO_MANIFEST_DIR" in body
                                     or "manifest_dir" in words})
        helpers = {}
        for row in rows:
            if row["root"] and not row["test"]:
                helpers.setdefault(row["name"], []).append(row)
        readers = []
        for row in rows:
            if not row["test"] or not any(source_tree_literal(lit) for lit in row["literals"]):
                continue
            used = [h for name in row["words"] & helpers.keys() for h in helpers[name]]
            if not (row["root"] or used):
                continue
            crates = {row["package"]}
            for source in [row, *used]:
                for lit in source["literals"]:
                    crates.update(SIBLING_CRATE.findall(lit))
            readers.append((row["module"], row["name"], row["shards"], frozenset(crates)))
        sources._source_readers = readers
    picked = set()
    for module, name, shards, crates in sources._source_readers:
        if crates & touched:
            picked.update((module, name, shard) for shard in shards)
    return sorted(picked)


def source_reader_targets(sources, changed):
    """Runnable bin/integration tests that inspect source trees (#2165).

    A target test can observe arbitrary production Rust just like a library
    source scanner. Resolve its root helper and its source literals from the
    target's mounted files, then select it for every source crate it names.
    """
    # Like the library scanners above, a test-only module is not production
    # source a scanner reads: a fixture repair must not build unrelated bins (#2434).
    touched = {package_for(path) for path in changed
               if path.endswith(".rs") and package_for(path)
               and path.startswith(f"crates/{package_for(path)}/src/")
               and not (module_of(path) and is_test_module(module_of(path)))}
    if not touched:
        return []
    picked = set()
    for package, targets in sources.targets().items():
        for kind, name, root in targets:
            if not sources.target_declares_tests(package, kind, name):
                continue
            rows = []
            for path in sources.mounted(package, root):
                text = sources.text(path)
                for function, _start, _end, attrs, body in rust_functions(text):
                    rows.append({"name": function, "path": path,
                                 "test": bool(TEST_ATTR.search(attrs)),
                                 "words": set(WORD.findall(body)) - {function},
                                 "literals": [m.group(1) for m in STRING_LITERAL.finditer(body)],
                                 "root": "CARGO_MANIFEST_DIR" in body or "manifest_dir" in body})
            helpers = {row["name"] for row in rows if not row["test"] and row["root"]}
            for row in rows:
                if not row["test"]:
                    continue
                used = [helper for helper in rows if helper["name"] in row["words"] & helpers]
                if not (row["root"] or used):
                    continue
                literals = row["literals"] + [literal for helper in used for literal in helper["literals"]]
                crates = set()
                for literal in literals:
                    found = re.search(r"(?:^|/)crates/([A-Za-z0-9_-]+)/src/", literal)
                    if found:
                        crates.add(found.group(1))
                    elif source_tree_literal(literal):
                        crates.add(package)
                    crates.update(SIBLING_CRATE.findall(literal))
                if crates & touched:
                    picked.add(f"{package}={kind}:{name}")
                    break
    return sorted(picked)


REGISTRATION_MOD = re.compile(r"(?:pub(?:\([^)]*\))?\s+)?mod\s+([A-Za-z_][A-Za-z_0-9]*)\s*;")
REGISTRATION_USE = re.compile(
    r"pub(?:\([^)]*\))?\s+use\s+([A-Za-z_][A-Za-z_0-9]*(?:::[A-Za-z_][A-Za-z_0-9]*)*)"
    r"(?:::(?:\*|\{[^{};]+\}))?(?:\s+as\s+[A-Za-z_][A-Za-z_0-9]*)?\s*;"
)


def registration_sources(path, sources, old_sources):
    """Narrow registration-only edits (including .rs mounts) to their modules.

    Inspect both sides so removals and replacements count too. Unresolved uses,
    attributes, inline modules and any code change retain the root's coverage.
    """
    if not lib_source(path):
        return [path]
    parent = sources.module(path)
    if not parent:
        return [path]
    modules = getattr(sources, "_registration_modules", None)
    if modules is None:
        modules = {**old_sources.modules, **sources.modules}
        # Keep the existing filename fallback for trees without crate root mounts.
        for source in (*old_sources.texts, *sources.texts):
            modules.setdefault(source, module_of(source))
        sources._registration_modules = modules
    targets = []
    old_rows, new_rows = old_sources.text(path).splitlines(), sources.text(path).splitlines()
    first, old_end, new_end = 0, len(old_rows), len(new_rows)
    while first < min(old_end, new_end) and old_rows[first] == new_rows[first]:
        first += 1
    while old_end > first and new_end > first and old_rows[old_end - 1] == new_rows[new_end - 1]:
        old_end -= 1
        new_end -= 1
    # A row whose count differs between the sides lies in a changed region of any
    # alignment; one that is not a registration keeps the root's coverage, so the
    # quadratic matching below is only needed for registration-only windows.
    imbalance = collections.Counter(old_rows[first:old_end])
    imbalance.subtract(new_rows[first:new_end])
    for row, count in imbalance.items():
        if count:
            code = row.split("//", 1)[0].strip()
            if code and not PATH_ATTR.fullmatch(code) and not REGISTRATION_MOD.fullmatch(code) and not REGISTRATION_USE.fullmatch(code):
                return [path]
    changes = difflib.SequenceMatcher(None, old_rows[first:old_end], new_rows[first:new_end], autojunk=False).get_opcodes()
    offset = first
    declarations = []
    for tag, first, last, begin, end in changes:
        if tag == "equal":
            continue
        for rows, start, stop in ((old_rows, offset + first, offset + last), (new_rows, offset + begin, offset + end)):
            for index in range(start, stop):
                row = rows[index].split("//", 1)[0].strip()
                if PATH_ATTR.fullmatch(row):
                    # Only a path attribute directly attached to a mod mount
                    # is a registration; other attributes keep broad coverage.
                    following = next((r.strip() for r in rows[index + 1:] if r.strip()), "")
                    if not MOD_DECL.fullmatch(following):
                        return [path]
                    declarations.append(following)
                else:
                    declarations.append(row)
    for declaration in declarations:
        if not declaration.strip():
            continue
        mod = REGISTRATION_MOD.fullmatch(declaration)
        use = REGISTRATION_USE.fullmatch(declaration)
        if mod:
            module = f"{parent}::{mod.group(1)}"
        elif use:
            parts = use.group(1).split("::")
            prefix = parent.split("::")
            if parts[0] == "crate":
                prefix, parts = [], parts[1:]
            elif parts[0] == "self":
                parts = parts[1:]
            while parts and parts[0] == "super":
                prefix, parts = prefix[:-1], parts[1:]
            module = "::".join(prefix + parts)
        else:
            return [path]
        candidates = [
            (source, mounted) for source, mounted in modules.items()
            if source != path and package_for(source) == package_for(path) and mounted
            and (module == mounted or (use and module.startswith(mounted + "::")))
        ]
        if not candidates:
            return [path]
        longest = max(len(mounted) for _, mounted in candidates)
        targets.extend(source for source, mounted in candidates if len(mounted) == longest)
    return list(dict.fromkeys(targets)) or [path]


# #1341: migration fixture maintenance must not select the entire store suite.
REWIND_FIXTURE = RSID_STORE_SRC + "store/tests.rs"
REWIND_HELPERS = {
    "rewind_post_v121_tail_to", "assert_fixture_matches_claimed_version",
    "assert_post_v77_chain_replayed",
}
RUST_FN = re.compile(r"^([ \t]*)(?:pub(?:\([^)]*\))?\s+)?(?:async\s+)?fn\s+(\w+)\b", re.M)


@functools.lru_cache(maxsize=4096)
def rust_function_spans(text):
    """((name, start, end, attr_start), ...) of rust_functions without building bodies; cached per text."""
    lines = text.splitlines()
    offsets, offset = {}, 0
    for index, line in enumerate(lines):
        offsets[offset] = index
        offset += len(line) + 1
    spans = []
    for match in RUST_FN.finditer(text):
        start = offsets[match.start()]
        indent, name = match.groups()
        if "{" in lines[start] and lines[start].rstrip().endswith("}"):
            end = start + 1
        else:
            end = next((i + 1 for i in range(start + 1, len(lines))
                        if lines[i] == indent + "}"), None)
        if end is None:
            continue
        attr = start
        while attr and lines[attr - 1].lstrip().startswith("#["):
            attr -= 1
        spans.append((name, start, end, attr))
    return tuple(spans)


@functools.lru_cache(maxsize=4096)
def _rust_functions(text):
    lines = text.splitlines()
    return tuple(
        (name, start, end, "\n".join(lines[attr:start]), "\n".join(lines[start:end]))
        for name, start, end, attr in rust_function_spans(text))


HOST_OS = {"linux": "linux", "darwin": "macos", "win32": "windows"}.get(sys.platform, sys.platform)
# The supported gate grammar is check-rsid-test-shards.py's TARGET_OS_GATE/host_excluded,
# copied rather than imported because a daemon tool copy may hold this script alone; the
# parity fixture in test_check_touched_shards.py pins the two to the same answers.
OS_GATE = re.compile(r'#\[cfg\((?:all\(test, )?(not\()?target_os = "([a-z]+)"\)?\)?\)\]')


def other_os_gate(row):
    """Whether one `#[cfg([all(test, )][not(]target_os = "X"[)])]` row leaves its item out of this host.

    Any other condition (`any`, an `all` with another predicate, a feature, an unknown OS
    spelling) is not read: the item is kept, so a runnable test is never hidden."""
    row = row.strip()
    gate = OS_GATE.fullmatch(row)
    if not gate or row.count("(") != row.count(")"):
        return False
    return (gate.group(2) == HOST_OS) == bool(gate.group(1))


def gated_to_other_os(attrs):
    """Whether a plain `target_os` gate among the rows of `attrs` leaves the item out of a
    build on this host, so no landing filter can select it (#2291)."""
    return any(other_os_gate(row) for row in attrs.splitlines())


INLINE_MOD = re.compile(r"^([ \t]*)(?:pub(?:\([^)]*\))?\s+)?mod\s+[A-Za-z_]\w*\s*\{\s*$")


@functools.lru_cache(maxsize=4096)
def other_os_regions(text):
    """0-based inclusive (first, last) line ranges of the inline `mod x { .. }` blocks whose own
    gate leaves them out of this host. rustfmt pairs a block's closing brace with its opener's
    indentation; a block that never closes is not a region, so its items are kept."""
    lines = text.splitlines()
    regions = []
    for index, line in enumerate(lines):
        block = INLINE_MOD.match(line)
        if not block or not gated_to_other_os("\n".join(attrs_above(lines, index))):
            continue
        closing = block.group(1) + "}"
        end = next((j for j in range(index + 1, len(lines)) if lines[j].rstrip() == closing), None)
        if end is not None:
            regions.append((index, end))
    return tuple(regions)


@functools.lru_cache(maxsize=4096)
def file_gated_off(text):
    """Whether the whole source is out of this host: mounted only behind another OS's
    `mod x;` gate (see HOST_GATED_OFF), or its own `#![cfg(target_os = ..)]` says so."""
    if text.endswith(HOST_GATED_OFF):
        return True
    for row in text.splitlines():
        row = row.strip()
        if not row or row.startswith("//"):
            continue
        if not row.startswith("#!["):
            return False
        if other_os_gate(row.replace("#![", "#[", 1)):
            return True
    return False


def function_gated_off(text, start, attrs):
    """Whether the function at 0-based line `start` with attribute rows `attrs` is out of this host."""
    return gated_to_other_os(attrs) or any(first <= start <= last for first, last in other_os_regions(text))


def rust_functions(text):
    """Rustfmt function spans, including test attributes and their shard gate.

    Match the closing brace at the declaration's indentation, as module_map
    does for modules. Ambiguous/unclosed declarations are omitted, so the
    fixture-only diff check falls back to the full module. A function not compiled on
    this host is left out (#2291): a filter naming it selects no test. That is a
    function gated to another OS (a `#[cfg(target_os = "macos")]` test on Linux), one in
    an inline `mod` so gated, and every function of a source mounted or declared only
    behind such a gate.
    """
    if file_gated_off(text):
        return iter(())
    return (function for function in _rust_functions(text)
            if not function_gated_off(text, function[1], function[3]))


def rewind_only_change(before, after):
    def covered(text):
        result = set()
        for name, start, end, _ in rust_function_spans(text):
            if name in REWIND_HELPERS:
                result.update(range(start, end))
        result.update(i for i, line in enumerate(text.splitlines()) if "REWIND_TEARDOWN_COVERED_THROUGH" in line
                      and re.fullmatch(r"const REWIND_TEARDOWN_COVERED_THROUGH: i32 = \d+;", line))
        return result

    old, new = before.splitlines(), after.splitlines()
    old_allowed, new_allowed = covered(before), covered(after)
    # Trim the identical prefix/suffix before matching: this file has tens of
    # thousands of repetitive lines, but migration maintenance changes a short tail.
    start, old_end, new_end = 0, len(old), len(new)
    while start < min(old_end, new_end) and old[start] == new[start]:
        start += 1
    while old_end > start and new_end > start and old[old_end - 1] == new[new_end - 1]:
        old_end -= 1
        new_end -= 1
    # A row with more occurrences on one side leaves some occurrence in a changed
    # region of any alignment: when none of its occurrences there is covered, the
    # change is not rewind-only, so the quadratic matching below can be skipped.
    imbalance = collections.Counter(old[start:old_end])
    imbalance.subtract(new[start:new_end])
    excess_old = {row for row, count in imbalance.items() if count > 0}
    excess_new = {row for row, count in imbalance.items() if count < 0}
    covered_rows = {old[i] for i in range(start, old_end) if i in old_allowed and old[i] in excess_old}
    covered_rows |= {new[i] for i in range(start, new_end) if i in new_allowed and new[i] in excess_new}
    if (excess_old | excess_new) - covered_rows:
        return False
    changes = [op for op in difflib.SequenceMatcher(
        None, old[start:old_end], new[start:new_end], autojunk=False).get_opcodes()
        if op[0] != "equal"]
    return bool(changes) and all(
        set(range(start + i, start + j)) <= old_allowed
        and set(range(start + k, start + l)) <= new_allowed
        for _, i, j, k, l in changes
    )


# #1618: an additive migration (add column / create index) cannot change what
# any ordinary rewind caller observes; the migration-chain pins observe it.
ADDITIVE_SQL = re.compile(r"add_column_if_not_exists(?:_tx)?\s*\(|\bCREATE\s+(?:UNIQUE\s+)?INDEX\b", re.I)
DESTRUCTIVE_SQL = re.compile(
    r"\b(?:DROP|DELETE|UPDATE|INSERT|REPLACE|RENAME|TRIGGER|VIEW|SELECT|CREATE\s+TABLE|"
    r"CREATE\s+VIRTUAL|execute_batch|table_rebuild\w*|rebuild_\w+)\b", re.I)
MIGRATION_CHAIN_PINS = re.compile(
    r"every_recovered_migration_step_actually_executes|_fixture_rewinds|previous_schema_upgrades_")


def isolated_table_migration(code):
    """Prove literal DDL owns only new tables; ambiguity retains all rewind callers.

    SQLite parses object targets in a private in-memory DB. Triggers may only
    reject writes to their new table, never mutate another relation. Rust helper
    calls and nonliteral SQL are deliberately outside this small proof.
    """
    batch = re.compile(r'\btx\.execute_batch\(\s*"((?:\\.|[^"\\])*)"\s*,?\s*\)', re.S)
    matches = list(batch.finditer(code))
    if not matches:
        return False
    remainder = batch.sub("", code)
    # The shipped journal migrations import the store/result and SQLite
    # transaction types. Imports execute no code; accept only these known
    # bindings so a lookalike transaction helper cannot enter the proof.
    remainder = re.sub(
        r"\buse\s+(?:super::(?:super::)?Store|crate::error::Result|"
        r"rusqlite::(?:Transaction|TransactionBehavior|\{\s*Transaction\s*,\s*TransactionBehavior\s*\}))\s*;",
        "", remainder)
    remainder = re.sub(r"\bpub(?:\((?:super|crate)\))?\s+", "", remainder)
    remainder = re.sub(r'\btx\.pragma_update\(None,\s*"user_version",\s*\d+\)', "", remainder)
    words = set(re.findall(r'\b[A-Za-z_]\w*\b', remainder))
    skeleton = set("impl Store fn self version i32 Result if let tx rusqlite Transaction new_unchecked conn TransactionBehavior Immediate commit Ok".split())
    if any(word not in skeleton and not re.fullmatch(r'migrate_v\d+', word) for word in words) \
            or re.search(r'\b\w+!\s*[({\[]', remainder):
        return False
    calls = re.findall(r'\b([A-Za-z_]\w*(?:(?:\.|::)[A-Za-z_]\w*)*)\s*\(', remainder)
    if any(not re.fullmatch(r'migrate_v\d+|(?:rusqlite::)?Transaction::new_unchecked|tx\.commit|Ok', call)
           for call in calls):
        return False
    try:
        sql = "\n".join(json.loads('"' + match.group(1) + '"', strict=False) for match in matches)
    except ValueError:
        return False
    # Split complete SQLite statements, retaining a trigger's BEGIN/END body.
    statements, pending = [], ""
    for char in sql:
        pending += char
        if char == ";" and sqlite3.complete_statement(pending):
            statements.append(pending.strip())
            pending = ""
    if pending.strip() or not statements:
        return False
    for statement in statements:
        if not re.match(r'CREATE\s+(?:TABLE|(?:UNIQUE\s+)?INDEX|TRIGGER)\b', statement, re.I):
            return False
        # A pre-existing table must fail CREATE, never silently acquire new
        # indexes/triggers via IF NOT EXISTS on an existing relation.
        uncommented = re.sub(r'/\*.*?\*/|--[^\n]*', " ", statement, flags=re.S)
        if re.match(r'CREATE\s+TABLE\s+IF\b', uncommented, re.I):
            return False
        if re.match(r'CREATE\s+TRIGGER\b', statement, re.I) and not re.search(
                r"\bBEGIN\s+SELECT\s+RAISE\s*\(\s*ABORT\s*,\s*'(?:[^']|'')*'\s*\)\s*;\s*END\s*;$",
                statement, re.I):
            return False
    tables = set()

    def authorize(action, first, second, database, source):
        allowed = False
        if action == sqlite3.SQLITE_CREATE_TABLE:
            tables.add(first)
            allowed = database == "main"
        elif action in (sqlite3.SQLITE_CREATE_INDEX, sqlite3.SQLITE_CREATE_TRIGGER):
            allowed = second in tables and database == "main"
        elif action in (sqlite3.SQLITE_INSERT, sqlite3.SQLITE_UPDATE):
            allowed = first == "sqlite_master"
        elif action == sqlite3.SQLITE_READ:
            allowed = first == "sqlite_master" or first in tables
        elif action in (sqlite3.SQLITE_FUNCTION, sqlite3.SQLITE_REINDEX):
            allowed = True
        return sqlite3.SQLITE_OK if allowed else sqlite3.SQLITE_DENY

    connection = sqlite3.connect(":memory:")
    try:
        for function in ("rsi_uuid_is_canonical", "rsi_rfc3339_nanos_is_canonical"):
            connection.create_function(function, 1, lambda value: 1, deterministic=True)
        connection.set_authorizer(authorize)
        connection.executescript(sql)
        return bool(tables)
    except sqlite3.Error:
        return False
    finally:
        connection.close()


def additive_migration(text):
    """True for column/index additions or provably isolated new-table DDL."""
    try:
        spans = [(first, last) for kind, first, last in rust_lexemes(text) if kind == "comment"]
    except ValueError:
        return False
    code, previous = [], 0
    for first, last in spans:
        code.extend((text[previous:first], "\n" * text[first:last].count("\n") + " "))
        previous = last
    code = "".join(code) + text[previous:]
    return ((bool(ADDITIVE_SQL.search(code)) and not DESTRUCTIVE_SQL.search(code))
            or isolated_table_migration(code))


def rewind_test_filters(sources, pins_only=False, catalog_pins=False):
    """Scan direct and indirect callers, including fixtures in other modules.

    `pins_only` keeps only the migration-chain pins (#1618). `catalog_pins`
    keeps the pins plus every rewind caller that compares `sqlite_master`
    across the replay (#2029).
    """
    functions = []
    for path, text in sources.texts.items():
        if not lib_source(path):
            continue
        for name, _, _, attrs, body in rust_functions(text):
            calls = set(re.findall(r"\b([A-Za-z_]\w*)\s*\(", body)) - {name}
            functions.append((name, attrs, calls, "sqlite_master" in body))
    callers = {"rewind_store_to_schema_version", "rewind_post_v121_tail_to",
               "assert_post_v77_chain_replayed", "assert_fixture_matches_claimed_version"}
    while True:
        expanded = callers | {name for name, _, calls, _ in functions if calls & callers}
        if expanded == callers:
            break
        callers = expanded
    filters = set()
    for name, attrs, _, catalog in functions:
        if TEST_ATTR.search(attrs) and (name in callers or "_rewinds" in name or "fixture_guard" in name):
            if (pins_only or catalog_pins) and not MIGRATION_CHAIN_PINS.search(name) \
                    and not (catalog_pins and catalog):
                continue
            for shard in shards_in(attrs):
                filters.add(f"rsid=shard:{shard}:test({name})")
    return sorted(filters)


def migration_metadata_tests(sources, path):
    """All consumers of the replay catalog's constants/helpers, including large helpers.

    This test-only include! file mounts at `store`; its observers are replay
    tests, not every test under that namespace. Keep the entire closure without
    the ordinary observer cap: required migration coverage cannot be truncated.
    """
    text = sources.text(path)
    reached = {name for name, *_ in rust_functions(text)}
    reached.update(re.findall(r"\bconst\s+(\w+)\s*:", text))
    functions = sources.functions()
    while True:
        callers = {name for name, _, test, _, words, _ in functions
                   if not test and words & reached}
        if callers <= reached:
            break
        reached |= callers
    return [(module, name, shard) for name, module, test, shards, words, _ in functions
            if test and (name in reached or words & reached) for shard in shards]


def changed_test_filters(sources, repo, merge_base, head, changed):
    """Keep added/edited test identities even when a namespace filter covers them."""
    picked = []
    for path in changed:
        if not lib_source(path):
            continue
        _, lines = changed_line_numbers(repo, merge_base, head, path)
        for name, start, end, attrs, _ in rust_functions(sources.text(path)):
            first = start - (attrs.count("\n") + 1 if attrs else 0)
            if TEST_ATTR.search(attrs) and any(first < line <= end for line in lines):
                picked.extend((sources.module(path), name, shard) for shard in shards_in(attrs))
    return traced_filters(picked)


HUNK = re.compile(r"^@@ -(\d+)(?:,(\d+))? \+(\d+)(?:,(\d+))? @@")


def changed_line_numbers(repo, merge_base, head, path):
    """(old lines, new lines) a zero-context diff of `path` removes and adds (1-based)."""
    diff = git_out(repo, "diff", "-U0", "--no-color", f"{merge_base}..{head}", "--", path)
    old, new = [], []
    for raw in diff.splitlines():
        hunk = HUNK.match(raw)
        if hunk:
            start, length, begin, count = hunk.groups()
            old += range(int(start), int(start) + int(length if length is not None else 1))
            new += range(int(begin), int(begin) + int(count if count is not None else 1))
    return old, new


def function_spans(text):
    """[(name, first line, last line)] (1-based, attributes included) of every function."""
    return [(name, start - (attrs.count("\n") + 1 if attrs else 0) + 1, end)
            for name, start, end, attrs, _ in rust_functions(text)]


def private_move(before, after):
    """Types moved from the file's parent into a closed private inline module.

    This is a syntax seam, not a coverage declaration: its changed members still
    have to trace to actual users. Unrelated declarations retain the fallback.
    """
    rows = after.splitlines()
    old_types = set(re.findall(r"^(?:pub(?:\([^)]*\))?\s+)?struct\s+(\w+)\s*\{", before, re.M))
    moved, regions = {}, []
    for start, row in enumerate(rows):
        if not re.fullmatch(r"mod\s+\w+\s*\{", row):
            continue
        end = next((i for i in range(start + 1, len(rows)) if rows[i] == "}"), None)
        if end is None:
            continue
        types = set(re.findall(r"^    (?:pub(?:\([^)]*\))?\s+)?struct\s+(\w+)\s*\{",
                               "\n".join(rows[start + 1:end]), re.M))
        if types & old_types:
            moved.update({name: row.split()[1] for name in types})
            regions.append((start + 1, end + 1))
    return moved, regions


def relocation_lines(before, after, moved, regions):
    """Ignore indentation only within the moved items and their private module."""
    def normalized(text, private_regions):
        rows = text.splitlines()
        owners = type_owners(text, moved)
        for index in range(len(rows) - 2, -1, -1):
            if rows[index].strip().startswith("#["):
                owners[index] = owners[index + 1]
        return [row.strip() if owners[i] or any(first <= i + 1 <= last for first, last in private_regions)
                else row for i, row in enumerate(rows)]

    old, new = [], []
    a, b = normalized(before, ()), normalized(after, regions)
    for tag, i, j, k, l in difflib.SequenceMatcher(None, a, b, autojunk=False).get_opcodes():
        if tag != "equal":
            old.extend(range(i + 1, j + 1))
            new.extend(range(k + 1, l + 1))
    return old, new


def type_owners(text, types):
    """Line owners of simple rustfmt struct/enum/impl blocks, in one source scan."""
    owners, stack = [], []
    for row in text.splitlines():
        match = re.match(r"^(\s*)(?:pub(?:\([^)]*\))?\s+)?(?:struct|enum)\s+(\w+)\s*\{|"
                         r"^(\s*)impl(?:<[^>{}]*>)?(?:\s+[\w:]+(?:<[^{}]*>)?\s+for)?\s+(\w+)(?:<[^{}]*>)?\s*(?:\{|where\b.*|)$", row)
        if match:
            indent, name = (match.group(1), match.group(2)) if match.group(2) else (match.group(3), match.group(4))
            if name in types:
                stack.append((indent, name))
        owners.append(stack[-1][1] if stack else None)
        if stack and row == stack[-1][0] + "}":
            stack.pop()
    return owners


def enum_item_lines(text, resolved_types):
    """Proven unit-enum declarations and variants, keyed by one-based line.

    Payloads, discriminants and attributes on variants need richer resolution;
    leave those declarations to the conservative fallback.
    """
    rows, items = text.splitlines(), {}
    for start, row in enumerate(rows):
        header = re.fullmatch(r"(\s*)(?:pub(?:\([^)]*\))?\s+)?enum\s+(\w+)\s*\{", row)
        if not header or header.group(2) not in resolved_types:
            continue
        indent, owner = header.groups()
        end = next((i for i in range(start + 1, len(rows)) if rows[i] == indent + "}"), None)
        if end is None or any(line.strip() and not re.fullmatch(
                re.escape(indent) + r"    [A-Za-z_]\w*,", line) for line in rows[start + 1:end]):
            continue
        items.update((i + 1, owner) for i in range(start, end + 1))
        attr = start - 1
        while attr >= 0 and rows[attr].lstrip().startswith("#["):
            items[attr + 1] = owner
            attr -= 1
    return items


def private_owner(text, number, types):
    """Enclosing simple struct or impl of a moved type, using rustfmt's braces."""
    owners = type_owners(text, types)
    return owners[number - 1] if 0 < number <= len(owners) else None


# #213: a private struct field added beside mechanical constructor initializers. The field name
# alone is a precise trace token once the tree proves it is one private field of one uniquely
# named type, and the `field: Type::new(),` rows that only store its starting value are not
# observers of it: the code that reads the field is.
CONSTRUCTOR_CALL = re.compile(r"((?:[A-Za-z_]\w*::)+)([A-Za-z_]\w*)\(")
MECHANICAL_VALUE = re.compile(
    r"(?:[A-Za-z_]\w*::)+[A-Za-z_]\w*\((?:(?:[A-Za-z_]\w*::)+[A-Za-z_]\w*\(\)|None|true|false|\d+)?\)")
CONSTRUCTOR_NAMES = frozenset({"new", "default"})
STD_WRAPPERS = frozenset("Cell RefCell Mutex RwLock Arc Rc Box Option Vec HashMap HashSet BTreeMap BTreeSet VecDeque".split())
STRUCT_HEADER = re.compile(r"^(\s*)(?:pub(?:\([^)]*\))?\s+)?(?:struct|union)\s+(\w+)\b[^;{]*\{\s*$")
ITEM_KEYWORD = re.compile(r"(?:pub(?:\([^)]*\))?\s+)?(?:impl|struct|enum|union|trait|fn|mod)\b")


def mechanical_types(value):
    """The type names a plain `Path::new(Path::default())` constructor call instantiates, else None.

    Only `new` and `default` calls with no argument beyond one nested such call or a literal count:
    any other call, argument or expression may do work a reader never sees."""
    if not MECHANICAL_VALUE.fullmatch(value):
        return None
    calls = CONSTRUCTOR_CALL.findall(value)
    if any(function not in CONSTRUCTOR_NAMES for _, function in calls):
        return None
    return {part for prefix, _ in calls for part in prefix.split("::") if part[:1].isupper()} - STD_WRAPPERS


def struct_field_owner(rows, index):
    """The struct whose rustfmt body directly holds row `index`, else None."""
    indent = len(rows[index]) - len(rows[index].lstrip())
    for earlier in range(index - 1, -1, -1):
        row = rows[earlier]
        if not row.strip():
            continue
        depth = len(row) - len(row.lstrip())
        if depth >= indent:
            continue
        header = STRUCT_HEADER.match(row)
        return header.group(2) if header and depth == indent - 4 else None
    return None


def unique_private_field_owner(texts, field, resolved_types):
    """The type that declares `field`, when the whole tree proves the name is one private named
    field of a uniquely declared struct; None for anything ambiguous.

    Every `field:` row of every source must be that single declaration or a mechanical
    constructor initializer (`field: Type::new(),`): a second declaration, a pub field, a
    pattern, a parameter, a differently shaped initializer or a `macro_rules!` that could spell
    the name leaves the field to the conservative fallback."""
    pattern = re.compile(r"\b" + re.escape(field) + r"\s*:(?!:)")
    declared = []
    for text in texts.values():
        if field not in text:
            continue
        code = code_only(text)
        if not pattern.search(code):
            continue
        if "macro_rules!" in code:
            return None
        rows = code.splitlines()
        for index, row in enumerate(rows):
            if not pattern.search(row):
                continue
            stripped = row.strip()
            initializer = re.fullmatch(re.escape(field) + r"\s*:\s*(.+),", stripped)
            if initializer and mechanical_types(initializer.group(1)) is not None:
                continue
            owner = struct_field_owner(rows, index)
            if not owner or not re.fullmatch(re.escape(field) + r"\s*:\s*[^{};]+,", stripped):
                return None
            declared.append(owner)
    return declared[0] if len(declared) == 1 and declared[0] in resolved_types else None


def initializer_value(rows, index, owned_field, enclosing):
    """(field, types) when row `index` only stores a mechanical starting value in the struct
    literal of the unique private field it names, else None.

    `enclosing` is the type of the surrounding impl, which `Self { .. }` names."""
    match = re.fullmatch(r"(\w+)\s*:\s*(.+),", rows[index].strip())
    if not match or not owned_field:
        return None
    field, value = match.groups()
    owner = owned_field(field)
    types = mechanical_types(value) if owner else None
    if types is None:
        return None
    depth = 0
    for earlier in range(index - 1, -1, -1):
        depth += rows[earlier].count("}") - rows[earlier].count("{")
        if depth >= 0:
            continue
        opener = rows[earlier].strip()
        literal = re.search(r"(?:^|[\s=(])(Self|" + re.escape(owner) + r")\s*\{$", opener)
        if not literal or ITEM_KEYWORD.match(opener) or (literal.group(1) == "Self" and enclosing != owner):
            return None
        return field, types
    return None


def test_module_regions(text):
    """Rustfmt inline test modules, including their helper functions."""
    rows, regions = text.splitlines(), []
    for start, row in enumerate(rows):
        test_mod = re.fullmatch(r"(\s*)mod\s+(\w+)\s*\{", row)
        if test_mod and is_test_module(test_mod.group(2)):
            end = next((i for i in range(start + 1, len(rows))
                        if rows[i] == test_mod.group(1) + "}"), None)
            if end is not None:
                regions.append((start + 1, end + 1))
    return regions


def trace_seeds(text, lines, frequency, parent, moved=None, regions=(), resolved_types=(), owned_field=None,
                initializers=None):
    """(function names, rare identifiers, mounted modules) that the changed `lines` of `text` trace
    to; None for an unrecognized declaration or a common field/re-export name.

    Rustfmt's named struct fields and explicit re-exports can be traced by their
    identifiers too. Never infer coverage from a type's common plumbing names
    (Option, String, etc.), a wildcard export, or a changed struct header.
    """
    try:
        masked, previous = [], 0
        for kind, first, last in rust_lexemes(text):
            if kind == "comment":
                masked.extend((text[previous:first], re.sub(r"[^\n]", " ", text[first:last])))
                previous = last
        rows = ("".join(masked) + text[previous:]).splitlines()
    except ValueError:
        return None
    spans, names, tokens, modules = function_spans(text), set(), set(), set()
    moved = moved or {}
    line_owners = type_owners(text, set(moved) | set(resolved_types))
    enum_items = enum_item_lines("\n".join(rows), resolved_types)
    enums = set(enum_items.values())
    test_regions = test_module_regions("\n".join(rows))
    test_regions += [(start + 1, end) for _, start, end, attrs, _ in rust_functions(text)
                     if "#[cfg(test)]" in attrs or TEST_ATTR.search(attrs)]
    parent_imports = set()
    for imported_row in rows:
        direct = re.fullmatch(r"use\s+([\w:]+);", imported_row)
        grouped = re.fullmatch(r"use\s+([\w:]+)::\{([\w, ]+)\};", imported_row)
        if direct:
            parent_imports.add(direct.group(1))
        elif grouped:
            parent_imports.update(grouped.group(1) + "::" + part.strip() for part in grouped.group(2).split(",") if part.strip())
    for number in lines:
        row = rows[number - 1].strip() if 0 < number <= len(rows) else ""
        if not row or row.startswith("//"):
            continue
        inside = [span for span in spans if span[1] <= number <= span[2]]
        if not inside:
            enum_owner = enum_items.get(number)
            if enum_owner:
                if frequency.get(enum_owner, 0) > NARROW_FUNCTION_CAP:
                    return None
                tokens.add(enum_owner)
                continue
            private_region = any(first <= number <= last for first, last in regions)
            owner = line_owners[number - 1] if 0 < number <= len(line_owners) else None
            if private_region and re.fullmatch(r"mod\s+\w+\s*\{|}", row):
                continue
            # The new module imports the parent's existing bindings. Aliases,
            # globs and unresolved imports can change resolution: keep them broad.
            imported = re.fullmatch(r"use\s+([\w:]+);", row) if private_region else None
            if imported and imported.group(1) in parent_imports:
                continue
            if owner and row == "}":
                continue
            declaration = re.fullmatch(r"(?:pub(?:\([^)]*\))?\s+)?struct\s+(\w+)\s*\{", row)
            if declaration and declaration.group(1) in moved:
                identifier = declaration.group(1)
                if frequency.get(identifier, 0) > RARE_TOKEN_FUNCTIONS:
                    return None
                tokens.add(identifier)
                continue
            if private_region and row.startswith("#["):
                next_row = next((r.strip() for r in rows[number:] if r.strip() and not r.strip().startswith("#[")), "")
                derived = re.fullmatch(r"(?:pub(?:\([^)]*\))?\s+)?struct\s+(\w+)\s*\{", next_row)
                if derived and derived.group(1) in moved and frequency.get(derived.group(1), 0) <= RARE_TOKEN_FUNCTIONS:
                    tokens.add(derived.group(1))
                    continue
            mounted = re.match(r"(?:pub(?:\([^)]*\))?\s+)?mod\s+([A-Za-z_]\w*)\s*;", row)
            if mounted:
                modules.add(f"{parent}::{mounted.group(1)}" if parent else mounted.group(1))
                continue
            exported = re.fullmatch(
                r"pub(?:\([^)]*\))?\s+use\s+(?:[A-Za-z_]\w*::)+([A-Za-z_]\w*)\s*;", row)
            field = re.fullmatch(r"(?:pub(?:\([^)]*\))?\s+)?([A-Za-z_]\w*)\s*:\s*[^{};]+,", row)
            # A field-shaped row in an enum, macro, or impl is not proof of a
            # named struct field. Only accept a simple, rustfmt struct span.
            if field:
                prefix = rows[:number - 1]
                header = next((i for i in range(len(prefix) - 1, -1, -1)
                               if re.match(r"^(?:pub(?:\([^)]*\))?\s+)?struct\s+\w+\s*\{$", prefix[i])), None)
                if not owner and (header is None or any(line == "}" for line in prefix[header + 1:])):
                    field = None
            identifier = exported.group(1) if exported else field.group(1) if field else None
            # The re-export preserves a moved type's parent-visible name; its
            # implementation changes are traced independently above.
            if exported and identifier in moved and re.fullmatch(
                    r"pub(?:\([^)]*\))?\s+use\s+" + re.escape(moved[identifier] + "::" + identifier) + r";", row):
                continue
            typed_field = (field and owner in resolved_types
                           and frequency.get(identifier, 0) > RARE_TOKEN_FUNCTIONS
                           and 0 < frequency.get(owner, 0) <= NARROW_FUNCTION_CAP)
            if field and owner and (owner in moved and frequency.get(owner, 0) <= RARE_TOKEN_FUNCTIONS
                                    or typed_field):
                # Private member names (token, witness, ...) can be shared by
                # unrelated types. Prefer this member's concrete receiver.
                identifier = owner
            unresolved = (identifier is None or identifier in NOISE_WORDS
                          or not typed_field and frequency.get(identifier, 0) > RARE_TOKEN_FUNCTIONS)
            if (unresolved and field and owner and owned_field and not row.startswith("pub")
                    and owned_field(field.group(1)) == owner and struct_field_owner(rows, number - 1) == owner):
                # One private field of one uniquely named type that no rarer identifier resolves:
                # every reader names the field itself (#213).
                tokens.add(field.group(1))
                continue
            if unresolved:
                return None
            tokens.add(identifier)
            continue
        found = initializer_value(rows, number - 1, owned_field, line_owners[number - 1])
        if found:
            # A mechanical starting value of a unique private field (#213): the field's readers
            # observe it, not the constructor that stores it.
            if any(frequency.get(kind, 0) > RARE_TOKEN_FUNCTIONS for kind in found[1]):
                return None
            tokens.update({found[0]} | found[1])
            if initializers is not None:
                initializers.add(found[0])
            continue
        name, first, last = min(inside, key=lambda span: span[2] - span[1])
        owner = line_owners[number - 1]
        if owner in enums:
            # `refusal_code`, `status`, etc. are methods of this concrete
            # enum, not edges to every helper with the same name.
            tokens.add(owner)
            continue
        test_helper = is_test_module(parent) or any(a <= number <= b for a, b in test_regions)
        if last - first + 1 > LARGE_FUNCTION_LINES and not test_helper:
            rare = {word for word in WORD.findall(row)
                    if len(word) >= 4 and word not in NOISE_WORDS and frequency.get(word, 0) <= RARE_TOKEN_FUNCTIONS}
            if rare:
                tokens |= rare
                continue
        names.add(name)
    return names, tokens, modules


def rpc_dispatch_seeds(text, lines, sources):
    """Prove changed RPC arms are simple method-to-handler registrations.

    Braces and .await continuations belong to the arm, not the dispatcher.
    Resolve a family predicate in its own module; its common function name
    must never connect all the other RPC families. Other edits use the usual
    conservative trace.
    """
    rows, names, tokens = text.splitlines(), set(), set()
    headers = [i for i, row in enumerate(rows) if re.search(r"match request\.method\.as_str\(\)\s*\{", row)]
    if len(headers) != 1:
        return None
    begin = headers[0]
    indent = rows[begin][:len(rows[begin]) - len(rows[begin].lstrip())]
    end = next((i for i in range(begin + 1, len(rows)) if rows[i] in (indent + "}", indent + "};")), None)
    if end is None:
        return None
    starts = [i for i in range(begin + 1, end)
              if rows[i].startswith(indent + "    ") and not rows[i].startswith(indent + "     ")
              and "=>" in rows[i]]
    arms = list(zip(starts, starts[1:] + [end]))
    chosen = set()
    for number in lines:
        row = rows[number - 1].strip()
        if not row or row.startswith("//"):
            continue
        arm = next(((first, last) for first, last in arms if first <= number - 1 < last), None)
        if arm is None:
            return None
        chosen.add(arm)
    for first, last in chosen:
        code = " ".join(row.split("//", 1)[0].strip() for row in rows[first:last])
        pattern, body = code.split("=>", 1)
        handler = re.fullmatch(r"\s*\{?\s*self\.(handle_\w+)\((?:request)?\)\s*(?:\.await)?\s*\}?\s*,?\s*", body)
        if handler is None:
            return None
        names.add(handler.group(1))
        if re.fullmatch(r'\s*"[A-Za-z_]\w*"(?:\s*\|\s*"[A-Za-z_]\w*")*\s*', pattern):
            tokens.update(re.findall(r'"([A-Za-z_]\w*)"', pattern))
            continue
        family = re.fullmatch(r"\s*method if (\w+)::is_operator_method\(method\)\s*", pattern)
        if family is None:
            return None
        predicates = [body for path, source in sources.texts.items()
                      if sources.module(path) == "rpc::" + family.group(1)
                      for name, _, _, _, body in rust_functions(source) if name == "is_operator_method"]
        if len(predicates) != 1:
            return None
        methods = re.findall(r'"([A-Z][A-Za-z0-9_]*)"', predicates[0])
        if not methods:
            return None
        tokens.update(methods)
    return names, tokens, set()


CODE_ONLY = re.compile(r"""//[^\n]*|/\*.*?\*/|\br(#*)".*?"\1|"(?:\\.|[^"\\])*"|'(?:\\u\{[^}]*\}|\\.|[^\\'\n])'""", re.S)
USE_ITEM = re.compile(r"^([ \t]*)(pub(?:\([^)]*\))?[ \t]+)?use[ \t]+([^;]+);", re.M)
QUALIFIER = re.compile(r"((?:[A-Za-z_]\w*\s*::\s*)+)$")
GENERIC_ARGS = re.compile(r"::<(?:[^<>]|<(?:[^<>]|<[^<>]*>)*>)*>")
TYPE_ALIAS = re.compile(r"\btype\s+(\w+)(?:<[^=;]*>)?\s*=\s*&?\s*((?:\w+::)*\w+)")
ITEM_OPENER = re.compile(r"^([ \t]*)(?:pub(?:\([^)]*\))?\s+)?(?:unsafe\s+)?(mod|impl|trait)\b\s*(\w*)")


def code_only(text):
    """`text` without comments, and with string literals emptied (an identifier there is no reference).

    Line breaks stay, so an offset keeps its line number."""
    def blank(match):
        kept = match.group(0)
        return ('""' if kept[0] in 'r"' else " ") + "\n" * kept.count("\n")
    return CODE_ONLY.sub(blank, text)


def split_top_level(text, separator):
    parts, depth, current = [], 0, []
    for char in text:
        depth += char == "{"
        depth -= char == "}"
        if char == separator and not depth:
            parts.append("".join(current))
            current = []
            continue
        current.append(char)
    parts.append("".join(current))
    return parts


def local_binding(code, name):
    """Offset in the function `code` from which a local variable called `name` shadows an item, else None."""
    found = []
    header = code.split("{", 1)[0]
    if re.search(rf"[(,]\s*(?:mut\s+)?{re.escape(name)}\s*:(?!:)", header):
        found.append(0)
    for pattern in (rf"\blet\b[^=;]*?\b{re.escape(name)}\b",
                    rf"\bfor\b[^{{}};]*?\b{re.escape(name)}\b[^{{}};]*?\bin\b"):
        match = re.search(pattern, code)
        if match:
            found.append(match.start())
    # A nested `fn name` item is visible in the whole block that declares it.
    if re.search(rf"\bfn\s+{re.escape(name)}\b", code.split("\n", 1)[1] if "\n" in code else ""):
        found.append(0)
    return min(found) if found else None


def in_closure_params(before, after):
    """Whether an identifier between `before` and `after` sits in a closure's `|params|`."""
    if after[:1] not in ("|", ",", ":") or after[:2] == "||":
        return False
    bar = before.rfind("|")
    if bar < 0 or before[bar - 1:bar] == "|":
        return False
    return not re.search(r"[{};=]", before[bar + 1:])


def expand_use(tree, prefix=()):
    """[(path tuple, bound name or None, glob)] of one `use` tree (`a::{b, c as d, e::*}`)."""
    tree = " ".join(tree.split())
    brace = tree.find("{")
    if brace >= 0:
        head = tuple(p.strip() for p in tree[:brace].split("::") if p.strip())
        inner = tree[brace + 1:tree.rindex("}")] if "}" in tree else ""
        return [item for part in split_top_level(inner, ",") if part.strip()
                for item in expand_use(part, prefix + head)]
    parts = [p.strip() for p in tree.split("::") if p.strip()]
    if not parts:
        return []
    alias = None
    if " as " in parts[-1]:
        parts[-1], alias = (s.strip() for s in parts[-1].split(" as ", 1))
    if parts[-1] == "*":
        return [(prefix + tuple(parts[:-1]), None, True)]
    if parts[-1] == "self":
        parts = parts[:-1]
    path = prefix + tuple(parts)
    return [(path, alias or (path[-1] if path else None), False)] if path else []


def impl_owner(row, opened):
    """The block kind and type of an `impl` header row: ('inherent', Type), ('trait', Type) or ('traitdef', Trait)."""
    if opened.group(2) == "trait":
        return ("traitdef", opened.group(3))
    if opened.group(2) != "impl":
        return None
    rest, depth, index = row[opened.end(2):], 0, 0
    rest = rest.lstrip()
    if rest.startswith("<"):
        for index, char in enumerate(rest):
            depth += char == "<"
            depth -= char == ">"
            if not depth:
                break
        rest = rest[index + 1:]
    kind = "inherent"
    if re.search(r"\sfor\s", rest):
        kind, rest = "trait", re.split(r"\sfor\s", rest, maxsplit=1)[1]
    named = re.match(r"\s*(?:&\s*(?:mut\s+)?)?(?:dyn\s+)?((?:\w+::)*\w+)", rest)
    return (kind, named.group(1).rsplit("::", 1)[-1]) if named else ("unknown", None)


class SourceScopes:
    """The inline modules, `use` declarations and impl blocks of one library source (#2247).

    A function declared in `mod seam { .. }` lives in `<file module>::seam`, a method in an `impl`
    or `trait` block is not a module-level function, and a `use` binds names in the module that
    holds it. Blocks are matched as rustfmt writes them: an opener line and its `}` at the
    same indentation."""

    def __init__(self, module, text):
        self.module = module
        code = code_only(text)
        rows = code.split("\n")
        self.scope, stack = [], []
        self.modules = {module}
        for row in rows:
            opened = ITEM_OPENER.match(row)
            if opened and not row.rstrip().endswith((";", "}")) and (opened.group(2) != "mod" or row.rstrip().endswith("{")):
                stack.append((opened.group(1), opened.group(2), opened.group(3), impl_owner(row, opened)))
            names = [name for _, kind, name, _ in stack if kind == "mod" and name]
            effective = "::".join([m for m in (module, *names) if m])
            blocks = [info for _, kind, _, info in stack if kind != "mod"]
            self.scope.append((effective, bool(blocks), blocks[-1] if blocks else None))
            self.modules.add(effective)
            if stack and row.rstrip() == stack[-1][0] + "}":
                stack.pop()
        self.bindings, self.globs, self.reexports = {}, {}, {}
        for found in USE_ITEM.finditer(code):
            effective = self.scope[code.count("\n", 0, found.start())][0]
            for path, name, glob in expand_use(found.group(3)):
                if found.group(2):
                    names, any_glob = self.reexports.get(effective, (set(), False))
                    self.reexports[effective] = (names | {name}, any_glob or glob)
                if glob:
                    self.globs.setdefault(effective, []).append(path)
                elif name:
                    self.bindings.setdefault(effective, []).append((path, name))


class ItemReferences:
    """Which functions provably refer to one function item, resolved by module path (#2247).

    The trace used to follow an exported helper by its bare name, so two modules defining
    `execute_tool` made every reference ambiguous. A reference is resolved from where it is
    written: a qualified path (`tools::name`, `crate::a::name`, `super::name`), an explicit
    `use`, a definition in its own module, or a glob import of the owner, followed through `pub use`
    re-exports, re-exported modules, glob chains and `use .. as` aliases down to the defining module
    (#2592). Anything else (a method of an unknown receiver, an unreadable path, a re-export cycle,
    a chain deeper than REEXPORT_DEPTH, a path naming no known module, a name two items could
    supply) is unresolved and the caller keeps the conservative answer."""

    def __init__(self, sources):
        self.sources = sources
        self.files = {}
        self.known = set()
        self.cache = {}
        self.by_name = {}
        self.why = ""
        self.chain_why = ""
        self.definitions = {}  # name -> {effective module: [(is a method, is pub, impl owner, takes self), ...]}
        self.aliases = {}  # a type alias or `use .. as` name -> the names it may stand for
        self.uses = {}  # module -> ([(path, bound name, scopes)] of its `use` items, [(glob path, scopes)])
        self.renames = []  # [(path, alias, module, scopes)] of every `use path as alias`
        for path, text in sources.texts.items():
            module = sources.module(path) if lib_source(path) else None
            if not module:
                continue
            scopes = self.files[path] = SourceScopes(module, text)
            self.known |= scopes.modules
            for name, start, _, attrs, body in rust_functions(text):
                if not TEST_ATTR.search(attrs):
                    effective, method, owner = scopes.scope[start]
                    receiver = bool(re.match(rf"[^(]*\bfn\s+{re.escape(name)}\s*(?:<[^(]*>)?\s*\(\s*(?:&\s*(?:'\w+\s+)?)?(?:mut\s+)?self\b", body))
                    self.definitions.setdefault(name, {}).setdefault(effective, []).append(
                        (method, body.lstrip().startswith("pub"), owner, receiver))
            for found in TYPE_ALIAS.finditer(code_only(text)):
                self.aliases.setdefault(found.group(1), set()).add(found.group(2).rsplit("::", 1)[-1])
            for module_name, bindings in scopes.bindings.items():
                for path, bound in bindings:
                    self.uses.setdefault(module_name, ([], []))[0].append((path, bound, scopes))
                    if path[-1] != bound:
                        self.aliases.setdefault(bound, set()).add(path[-1])
                        if bound != "_":
                            self.renames.append((path, bound, module_name, scopes))
            for module_name, paths in scopes.globs.items():
                for path in paths:
                    self.uses.setdefault(module_name, ([], []))[1].append((path, scopes))

    def fail(self, why):
        self.why = why
        return None

    def module_path(self, parts, caller, scopes, depth=0):
        """The known module `parts` names from module `caller`, as a '::' string, else None.

        A segment that is not a child module may be a module the previous one re-exports
        (`pub use crate::real::tools;`): `reexported_module` follows it, bounded by REEXPORT_DEPTH."""
        here = tuple(caller.split("::")) if caller else ()
        parts = tuple(parts)
        if parts and parts[0] == "crate":
            absolute = parts[1:]
        elif parts and parts[0] in ("self", "super"):
            absolute, rest = here, parts
            while rest and rest[0] in ("self", "super"):
                if rest[0] == "super":
                    if not absolute:
                        return None
                    absolute = absolute[:-1]
                rest = rest[1:]
            absolute += rest
        else:
            absolute = here + parts
            if "::".join(absolute) not in self.known and parts and scopes is not None:
                targets = {path for path, bound in scopes.bindings.get(caller, ()) if bound == parts[0]}
                if len(targets) != 1:
                    return None
                head = self.module_path(next(iter(targets)), caller, None, depth + 1)
                if head is None:
                    return None
                absolute = tuple(head.split("::")) + parts[1:]
        joined = "::".join(absolute)
        return joined if joined in self.known else self.reexported_module(absolute, depth)

    def reexported_module(self, absolute, depth):
        """The module an absolute path reaches through a module that is re-exported on the way, else None."""
        if depth >= REEXPORT_DEPTH:
            return None
        for split in range(len(absolute) - 1, 0, -1):
            if "::".join(absolute[:split]) in self.known:
                break
        else:
            return None
        current = "::".join(absolute[:split])
        for segment in absolute[split:]:
            current = self.module_segment(current, segment, depth)
            if current is None:
                return None
        return current

    def module_segment(self, module, segment, depth):
        """The module `segment` names inside `module`: a child, a `use` of a module, or one a glob supplies."""
        if module + "::" + segment in self.known:
            return module + "::" + segment
        uses, globs = self.uses.get(module, ((), ()))
        found = {self.module_path(path, module, scopes, depth + 1)
                 for path, bound, scopes in uses if bound == segment}
        if not found:
            found = {self.module_segment(target, segment, depth + 1) for path, scopes in globs
                     for target in [self.module_path(path, module, scopes, depth + 1)] if target}
        found.discard(None)
        return next(iter(found)) if len(found) == 1 else None

    def item_pairs(self, module, ident, stack=()):
        """{(defining module, name)}: the function items `module::ident` may be, following re-exports (#2592).

        A definition in the module is the item. Otherwise an explicit `use` binding of `ident`
        (renames included: `pub use a::f as ident` is `a::f`) names it, and only when the module has no
        explicit binding do its glob imports. The chain is followed through every module it
        crosses. An empty set means the module supplies no such function. None means the chain
        cannot be placed (a cycle, a chain deeper than REEXPORT_DEPTH, a path that names no known module, or
        more than one distinct item): the caller keeps the conservative answer, `self.chain_why` says why."""
        defined = self.definitions.get(ident, {}).get(module, ())
        if defined and not all(k[0] for k in defined):
            return frozenset({(module, ident)})
        key = (module, ident)
        if key in stack:
            return self.chain_fail(f"a re-export cycle through `{module}::{ident}`")
        if len(stack) >= REEXPORT_DEPTH:
            return self.chain_fail(f"a re-export chain of `{module}::{ident}` deeper than {REEXPORT_DEPTH} modules")
        stack += (key,)
        uses, globs = self.uses.get(module, ((), ()))
        found, explicit = set(), False
        for path, bound, scopes in uses:
            if bound != ident or len(path) < 2:
                continue
            explicit = True
            head = self.module_path(path[:-1], module, scopes)
            if head is None:
                if self.is_local_path(path[:-1], module, scopes):
                    return self.chain_fail("a re-export `" + "::".join(path) + "` that names no known module")
                continue  # an external crate's item
            sub = self.item_pairs(head, path[-1], stack)
            if sub is None:
                return None
            found |= sub
        for path, scopes in () if explicit else globs:
            target = self.module_path(path, module, scopes)
            if target is None:
                if path and path[-1][:1].isupper():
                    continue  # `use Kind::*`: enum variants, not functions
                if path and path[0] in ("crate", "self", "super"):
                    return self.chain_fail("a glob import `" + "::".join(path) + "::*` of no known module")
                continue  # an external crate's glob
            sub = self.item_pairs(target, ident, stack)
            if sub is None:
                return None
            found |= sub
        if len(found) > 1:
            return self.chain_fail(f"`{module}::{ident}` may name {len(found)} different items")
        return frozenset(found)

    def chain_fail(self, why):
        self.chain_why = why
        return None

    def events(self, body, name, caller, scopes, impl=None, bound_in=frozenset()):
        """What one function body does with `name`, as events independent of which item is the owner (#2247).

        ("pairs", p)        a call of a module-level function that is one of the items p, each
                            (defining module, name), after following imports, `pub use` and globs (#2592);
        ("receiver",)       a `.name(..)` method call;
        ("assoc", names)    `Type::name(..)`; `names` are the types the qualifier may stand for;
        ("fail", why)       a reference this scan cannot place.

        `bound_in` are the modules that bind `name` as the alias of `use path as name`."""
        code = GENERIC_ARGS.sub("", code_only(body))
        defined_in = {m for m, kinds in self.definitions.get(name, {}).items() if not all(k[0] for k in kinds)}
        defined_in |= bound_in
        found = []
        bound_at = local_binding(code, name)
        for hit in re.finditer(rf"\b{re.escape(name)}\b", code):
            before, after = code[:hit.start()].rstrip(), code[hit.end():].lstrip()
            if re.search(r"\bfn$", before):
                continue  # the signature itself, or a nested item that shadows the name (local_binding)
            if after.startswith("!") and not after.startswith("!="):
                continue
            if re.search(r"\blet(?:\s+mut)?$", before):
                continue
            if before.endswith(".") and not before.endswith(".."):
                found.append(("receiver",))
                continue
            if before.endswith("::"):
                chain = QUALIFIER.search(before)
                if chain is None:
                    found.append(("fail", "an unreadable path"))
                    continue
                parts = [p.strip() for p in chain.group(1).split("::") if p.strip()]
                if parts[-1][0].isupper():
                    qualifier = parts[-1]
                    if qualifier == "Self":
                        if not impl or impl[0] not in ("inherent", "trait") or not impl[1]:
                            found.append(("fail", "`Self::` outside an impl block"))
                            continue
                        qualifier = impl[1]
                    found.append(("assoc", {qualifier} | self.aliases.get(qualifier, set()), parts[-1]))
                    continue
                if after.startswith("::") and self.module_path(parts + [name], caller, scopes) is not None:
                    continue  # `crate::topology::resolve::f`: `resolve` is a module segment, never a function
                module = self.module_path(parts, caller, scopes)
                if module is not None:
                    pairs = self.item_pairs(module, name)
                    if pairs is None:
                        found.append(("fail", self.chain_why))
                        continue
                    if pairs:
                        found.append(("pairs", pairs))
                        continue
                if (module is not None or self.is_local_path(parts, caller, scopes)):
                    found.append(("fail", "a path `" + "::".join(parts) + "` that names no defining module"))
                continue  # otherwise an external crate's item
            if bound_at is not None and hit.start() >= bound_at:
                continue  # a local variable shadows the item from its `let`, parameter or `for`
            if in_closure_params(before, after):
                continue  # `|run| ..`: a closure parameter, not a reference
            if after[:1] not in ("(", ",", ")", ";", "}", "]", "") and not after.startswith("::"):
                continue  # an operand, field label or receiver: a variable, never a call or a passed item
            if after.startswith("::") and self.module_path((name,), caller, scopes) is not None:
                continue  # `use crate::topology::verify; verify::judge()`: an imported module segment
            if caller in defined_in:
                pairs = self.item_pairs(caller, name)
                found.append(("pairs", pairs) if pairs is not None else ("fail", self.chain_why))
                continue
            imported = {path for path, bound in scopes.bindings.get(caller, ()) if bound == name}
            if imported:
                path = next(iter(imported))
                head = self.module_path(path[:-1], caller, scopes) if len(path) > 1 else None
                pairs = self.item_pairs(head, path[-1]) if head is not None else None
                if len(imported) != 1:
                    found.append(("fail", "conflicting imports"))
                elif head is not None and pairs is None:
                    found.append(("fail", self.chain_why))
                elif head is None or not pairs:
                    if head is None and (len(path) < 2 or not self.is_local_path(path[:-1], caller, scopes)):
                        continue  # an external crate's item
                    found.append(("fail", "an import `" + "::".join(path) + "` that names no defining module"))
                else:
                    found.append(("pairs", pairs))
                continue
            supplied = set()
            unplaced = None
            for glob in scopes.globs.get(caller, ()):
                module = self.module_path(glob, caller, scopes)
                if module is None:
                    if glob and glob[-1][:1].isupper():
                        continue  # `use Kind::*`: enum variants, not functions
                    if glob and glob[0] in ("crate", "self", "super"):
                        unplaced = "a glob import `" + "::".join(glob) + "::*` of no known module"
                    continue
                pairs = self.item_pairs(module, name)
                if pairs is None:
                    unplaced = self.chain_why
                    continue
                supplied |= pairs
            if unplaced:
                found.append(("fail", unplaced))
            elif len(supplied) > 1:
                found.append(("fail", "a bare call that more than one glob import could supply"))
            elif supplied:
                found.append(("pairs", frozenset(supplied)))
            # No definition, import or glob accounts for the name: it is a variable or a pattern
            # binding (or an external item), never the owner's function.
        return found

    def is_local_path(self, parts, caller, scopes, depth=0):
        """Whether a path that names no known module starts in this crate (`crate::`, a child module, an import of either)."""
        head = parts[0]
        if head in ("crate", "self", "super"):
            return True
        here = tuple(caller.split("::")) if caller else ()
        if "::".join(here + (head,)) in self.known:
            return True
        if scopes is None or depth > 3:
            return False
        return any(self.is_local_path(path, caller, scopes, depth + 1)
                   for path, bound in scopes.bindings.get(caller, ()) if bound == head and path != tuple(parts))

    def callers(self, owner, name):
        """{(module, function)} that refer to `owner::name`, or None when a reference cannot be resolved."""
        key = (owner, name)
        if key not in self.cache:
            self.why = ""
            self.cache[key] = (self.scan(owner, name), self.why)
        callers, self.why = self.cache[key]
        return callers

    def references(self, name, bound_in=frozenset()):
        """[(file module, function, events)] of every function that mentions `name`; cached per name."""
        key = (name, bound_in)
        if key not in self.by_name:
            pattern = re.compile(rf"\b{re.escape(name)}\b")
            found = []
            for path, scopes in self.files.items():
                text = self.sources.text(path)
                if not pattern.search(text):
                    continue
                for fn_name, start, _, _, body in rust_functions(text):
                    if pattern.search(body):
                        caller, _, impl = scopes.scope[start]
                        found.append((scopes.module, fn_name, self.events(body, name, caller, scopes, impl, bound_in)))
            self.by_name[key] = found
        return self.by_name[key]

    def identifiers(self, ours, name):
        """{identifier: modules that bind it as an alias}: every name the item may be written as, else None.

        `use path as alias` is a reference only when it resolves to the item: an alias of an
        unrelated same-name helper is another item and stays out (#2592). An alias that cannot
        be resolved keeps the conservative answer."""
        names = {name: set()}
        for _ in range(REEXPORT_DEPTH):
            grew = False
            for path, bound, module, scopes in self.renames:
                if path[-1] not in names or module in names.get(bound, ()):
                    continue
                head = self.module_path(path[:-1], module, scopes) if len(path) > 1 else module
                if head is None:
                    if self.is_local_path(path[:-1], module, scopes):
                        self.why = f"{module} renames it in a `use` of a module this scan cannot place"
                        return None
                    continue  # an external crate's item
                pairs = self.item_pairs(head, path[-1])
                if pairs is None:
                    self.why = f"{module} renames it in a `use` ({self.chain_why})"
                    return None
                if pairs & ours:
                    names.setdefault(bound, set()).add(module)
                    grew = True
            if not grew:
                return names
        self.why = f"a chain of `use .. as` renames of it deeper than {REEXPORT_DEPTH}"
        return None

    def scan(self, owner, name):
        # The item is named by its file module; an inline `mod` of that file holds it too.
        inline = {m for scopes in self.files.values() if scopes.module == owner for m in scopes.modules}
        owned = {m: [k for k in kinds if k[1]] for m, kinds in self.definitions.get(name, {}).items() if m in inline}
        owned = {m: kinds for m, kinds in owned.items() if kinds}
        if not owned:
            return self.fail("no definition of it is in a library source")
        # The exported items are the `pub` definitions: a private method of the same name is another item.
        owners = {m for m, kinds in owned.items() if not all(k[0] for k in kinds)}
        methods = [k for kinds in owned.values() for k in kinds if k[0]]
        types = {k[2][1] for k in methods if k[2] and k[2][0] == "inherent" and k[2][1]}
        receiver = any(k[3] for k in methods)
        trait = any(not (k[2] and k[2][0] == "inherent" and k[2][1]) for k in methods)
        ours = {(m, name) for m in owners}
        identifiers = self.identifiers(ours, name)
        if identifiers is None:
            return None
        callers = set()
        for ident, bound_in in identifiers.items():
            for module, fn_name, events in self.references(ident, frozenset(bound_in)):
                is_alias = ident != name
                is_ours = False
                for event in events:
                    verdict = None
                    if event[0] == "fail":
                        verdict = event[1]
                    elif event[0] == "pairs":
                        is_ours |= bool(event[1] & ours)
                    elif is_alias:
                        continue  # an alias names a path item, never a method
                    elif event[0] == "receiver":
                        if methods and (receiver or trait):
                            verdict = "a method call on an unknown receiver"
                    elif methods:  # an associated function: `Type::name(..)`
                        if trait:
                            verdict = f"a `{event[2]}::` call of a trait method"
                        else:
                            is_ours |= bool(event[1] & types)
                    if verdict:
                        self.why = f"{module}::{fn_name} refers to it through {verdict}"
                        return None
                if is_ours:
                    callers.add((module, fn_name))
        return callers


def unresolved_reason(sources):
    return getattr(getattr(sources, "_item_references", None), "why", "") or "unresolved"


def item_callers(sources, owner, name):
    """Functions that refer to the item `name` of module `owner`; None if a reference is unprovable (#2247).

    Only a sharded library function is resolved: a leaf crate's exported function is called
    from another crate through facades this scan does not read."""
    if not hasattr(sources, "_item_references"):
        sources._item_references = ItemReferences(sources)
    references = sources._item_references
    if owner not in references.known:
        references.why = "a crate this scan does not read calls it"
        return None
    return references.callers(owner, name)


def dispatch_observers(sources, seeds, dispatchers, diagnostics):
    """Follow registered items through helpers without conflating local names.

    Runtime tests often use helpers named `request` or `fixture`. Their private
    names stay in their module subtree; unique helpers can cross module mounts.
    The dispatcher and its shared family-predicate name are never caller edges.
    """
    functions, reached, picked = sources.functions(), set(), set()
    definitions, exported = {}, set()
    for name, module, is_test, _, _, _ in functions:
        if not is_test:
            definitions.setdefault(name, set()).add(module)
    for path, text in sources.texts.items():
        if not lib_source(path):
            continue
        rows = text.splitlines()
        for name, start, _, _, _ in rust_functions(text):
            if rows[start].lstrip().startswith("pub"):
                exported.add((sources.module(path), name))

    identified, identified_callers = set(), set()

    def observes(module, words, fn=None):
        return bool(words & seeds) or (module, fn) in identified_callers or any(
            name in words and (module == owner or module.startswith(owner + "::")
                              or len(definitions.get(name, ())) == 1)
            for owner, name in reached if (owner, name) not in identified)

    while True:
        callers = {(module, name) for name, module, is_test, _, words, size in functions
                   if not is_test and size <= LARGE_FUNCTION_LINES
                   and name not in dispatchers and name != "is_operator_method"
                   and observes(module, words, name)}
        if callers <= reached:
            break
        reached |= callers
        # #2247: an exported helper whose name is shared is followed by the functions that
        # provably refer to it; one with an unprovable reference keeps the broad fallback.
        for module, name in sorted(reached):
            if (module, name) in identified or (module, name) not in exported or len(definitions.get(name, ())) < 2:
                continue
            refs = item_callers(sources, module, name)
            if refs is None:
                diagnostics.append(f"ambiguous exported helper: {module}::{name} ({unresolved_reason(sources)})")
                return None
            identified.add((module, name))
            identified_callers |= refs
        if len(reached) > NARROW_FUNCTION_CAP:
            diagnostics.append(f"qualified registration trace exceeds {NARROW_FUNCTION_CAP} functions")
            return None
    for name, module, is_test, shards, words, _ in functions:
        if is_test and observes(module, words, name):
            picked.update((module, name, shard) for shard in shards)
    count = len({(module, name) for module, name, _ in picked})
    if count > NARROW_TEST_CAP:
        diagnostics.append(f"qualified registration trace selects {count} tests, exceeding the {NARROW_TEST_CAP}-test bound")
        return None
    return sorted(picked | set(source_scanner_tests(sources, {RSID_SRC + "rpc.rs"})))


def narrow_tests(sources, old_sources, repo, merge_base, head, path, diagnostics=None, seeds=None,
                 direct=None):
    """The tests that can observe the diff of `path`: [(module, name, shard)], or None.

    Traces each changed function through its callers (a word match in the body,
    transitively, across the sharded library sources, never through a large
    function) to the tests that mention it; a change inside a large function is
    traced by the rare identifiers of its changed lines instead. [] when the trace
    is complete and no test mentions the change (the compile check is all that
    observes it). None when a declaration cannot be traced, the trace names too
    many functions or tests, or an identifier is too common:
    the caller then keeps the module filter and flags it broad.

    The walk never follows a high-fan-in token (a type or name more than
    HUB_FUNCTIONS functions mention: it alone would exceed the whole trace budget). It stops
    there and follows a hub type's changed method by the method's own name instead, so every
    function that can call it stays reached. A trace that is uncertain only because it was
    stopped (a hub, the function bound, the test bound) still hands the `direct` out-dict
    {"tests": [(module, name, shard, distance)], "hubs": {...}, "layers": n} to the caller: the
    tests it proved observe the change, nearest first. They are an ordering hint for the
    broad fallback, which stays the coverage, and never replace it (#2092)."""
    before, after = old_sources.text(path), sources.text(path)
    resolved_types, initializers, owned_field = set(), set(), None
    if seeds is not None:
        # #2057: the caller resolved the seeds itself (an include_str! constant), no diff to read.
        moved, regions, old_lines, new_lines = {}, (), [], []
    else:
        moved, regions = private_move(before, after)
        old_lines, new_lines = (relocation_lines(before, after, moved, regions) if moved else
                                changed_line_numbers(repo, merge_base, head, path))
    frequency = sources.token_frequency()
    parent = sources.trace_module(path) or sources.module(path)
    def uncertain(reason):
        if diagnostics is not None:
            diagnostics.append(reason)
        return None

    dispatch = seeds is None and path == RSID_SRC + "rpc.rs"
    new = rpc_dispatch_seeds(after, new_lines, sources) if dispatch else None
    old = rpc_dispatch_seeds(before, old_lines, old_sources) if dispatch else None
    dispatch = dispatch and new is not None and old is not None
    dispatchers = {name for text in (before, after) for name, _, _, _, body in rust_functions(text)
                   if re.search(r"match request\.method\.as_str\(\)\s*\{", body)}
    if dispatch:
        return dispatch_observers(sources, new[0] | new[1] | old[0] | old[1], dispatchers,
                                  diagnostics if diagnostics is not None else [])
    if seeds is not None:
        new, old = seeds, (set(), set(), set())
    elif not dispatch:
        if path == RSID_SRC + "rpc.rs" and any(
                name in dispatchers and any(start < line <= end for line in lines)
                for text, lines in ((before, old_lines), (after, new_lines))
                for name, start, end, _, _ in rust_functions(text)):
            return uncertain("RPC edit extends beyond simple method-to-handler registration arms")
        # A common field (refusal_code, status, ...) belongs to its concrete
        # struct. Resolve only unique type declarations across the store/daemon
        # split; the bounded observer trace, rather than field-name frequency,
        # decides whether the type's consumers are small enough to name.
        # A declaration quoted in a string literal or a comment (a source-scanner test naming
        # `pub(crate) struct X`) is not a second declaration of the type (#2247).
        types = collections.Counter(name for text in sources.texts.values()
                                    for name in re.findall(r"\b(?:struct|enum)\s+(\w+)", code_only(text)))
        resolved_types = {name for name, count in types.items() if count == 1}
        known = {}

        def owned_field(field):
            if field not in known:
                known[field] = (unique_private_field_owner(sources.texts, field, resolved_types)
                                if frequency.get(field, 0) <= NARROW_FUNCTION_CAP else None)
            return known[field]

        new = trace_seeds(after, new_lines, frequency, parent, moved, regions, resolved_types,
                          owned_field, initializers)
        old = trace_seeds(before, old_lines, frequency, parent, moved, resolved_types=resolved_types,
                          owned_field=owned_field, initializers=initializers) if old_lines else (set(), set(), set())
    if new is None or old is None:
        return uncertain("changed declaration or common identifier cannot be resolved")
    changed, tokens, mounted = new[0] | old[0], new[1] | old[1], new[2] | old[2]
    if not changed and not tokens and not mounted:
        return uncertain("no executable trace seeds were resolved")
    if mounted and leaf_package(path):
        # #2441: a leaf module declaration names a leaf module, which no daemon test path can match.
        return uncertain("a leaf module declaration cannot be traced to the daemon tests")
    functions = (sources.functions_without_initializers(initializers, owned_field) if initializers
                 else sources.functions())
    # Field reads and exported types can occur in helper bodies/signatures;
    # follow their consumers just as we follow changed function names.
    # A common test-only method of the private type (insert, len, ...) must
    # not become an edge to every unrelated type's method with that name.
    # Resolve that edge to the tests which use its owning type instead.
    test_methods = {}
    if moved:
        for name, start, _, attrs, _ in rust_functions(after):
            owner = private_owner(after, start + 1, moved)
            if owner and "#[cfg(test)]" in attrs:
                if name in test_methods and test_methods[name] != owner:
                    return None
                test_methods[name] = owner
    typed_tests = set()
    owners = {}
    typed_helpers = set()
    # A private helper sharing its name with a pub item of the same module (a test fake's
    # `new` beside a public constructor) is its own definition, not the exported one.
    exported_defs, exported_leaf = set(), set()
    definitions = {}
    for name, module, is_test, _, _, _ in functions:
        if not is_test:
            definitions.setdefault(name, set()).add(module)
    if moved or resolved_types:
        for source, text in sources.texts.items():
            module = sources.trace_module(source)
            if module is None:
                continue
            types = set(moved) | resolved_types
            line_owners = type_owners(text, types)
            test_regions = test_module_regions(text)
            for name, start, _, attrs, body in rust_functions(text):
                words = frozenset(WORD.findall(body)) - {name}
                if body.lstrip().startswith("pub"):
                    exported_defs.add((name, module, words))
                owner = line_owners[start]
                if owner:
                    owners.setdefault((name, module, words), set()).add(owner)
                if (is_test_module(module or "") or "#[cfg(test)]" in attrs
                        or any(a <= start + 1 <= b for a, b in test_regions)):
                    typed_helpers.add((name, module))
    # #2441: a public leaf function is called from another crate by its bare name, so a name another
    # module also defines cannot be told apart: the trace is then ambiguous, never module-local.
    for source, text in sources.texts.items():
        if leaf_package(source):
            module = sources.trace_module(source)
            exported_leaf.update((name, module) for name, _, _, _, body in rust_functions(text)
                                 if body.lstrip().startswith("pub"))
    # #2441: a leaf crate cannot name its callers and its wrappers are routinely long, so the walk
    # from a leaf edit follows large functions too; the function and test bounds still make an
    # over-wide trace unprovable (facade tests only, with the reason).
    leaf_edit = bool(leaf_package(path))
    reached = changed | tokens
    qualified = set()
    # #2588: hops from the changed seeds (0) to every reached token, and the hubs the walk stopped at.
    distance = {word: 0 for word in reached}
    hubs, layers = {}, 0
    # #2247: an exported helper whose name another module also defines is followed by the
    # functions that provably refer to this very item, never by the bare name.
    identified, identified_callers = set(), set()

    def observes_local(module, words):
        return any(name in words and (module == owner or module.startswith(owner + "::"))
                   for owner, name in qualified)

    def observer_tests():
        return sorted({(module, name, shard)
                       for name, module, is_test, shards, words, _ in functions
                       if is_test and (name in changed or words & reached or words & tokens or words & typed_tests
                                       or observes_local(module, words) or (module, name) in identified_callers
                                       or any(f"{module}::".startswith(m + "::") for m in mounted))
                       for shard in shards})

    def direct_observers():
        """The tests the walk reached so far, each with its distance: 1 for a test that names a
        changed function or seed, then one more per layer of callers between. A test reached only
        through a module-local, identified or mounted edge sits past the last layer."""
        far = layers + 1
        near = {}
        for name, module, is_test, shards, words, _ in functions:
            if not is_test:
                continue
            hops = [distance[word] + 1 for word in words & reached]
            if name in changed:
                hops.append(1)
            if words & tokens:
                hops.append(1)
            if not hops and (words & typed_tests or observes_local(module, words)
                             or (module, name) in identified_callers
                             or any(f"{module}::".startswith(m + "::") for m in mounted)):
                hops.append(far)
            if hops:
                for shard in shards:
                    near[(module, name, shard)] = min(hops)
        return {"tests": sorted((*key, hops) for key, hops in near.items()),
                "hubs": dict(hubs), "layers": layers}

    def stopped(reason, why):
        """Uncertain, but the layers settled so far still name their observers, nearest first."""
        if direct is not None:
            direct.update(direct_observers(), reason=why)
        return uncertain(reason)

    while True:
        for name, owner in test_methods.items():
            if name in reached:
                typed_tests.add(owner)
                reached.remove(name)
        callers, local_callers, resolved = set(), set(), {}
        for name, module, is_test, _, words, size in functions:
            observes = (words & reached or observes_local(module, words)
                        or (module, name) in identified_callers
                        or ((name, module) in typed_helpers and words & typed_tests))
            if (is_test or size > LARGE_FUNCTION_LINES and not leaf_edit and (name, module) not in typed_helpers
                    or name in reached or name in test_methods or not observes):
                continue
            # Common method names belong to a receiver type, not every type
            # with an identically named method. Follow the receiver's actual
            # users and the helpers that return it instead.
            receivers = owners.get((name, module, frozenset(words)), set())
            if len(receivers) > 1:
                return stopped(f"ambiguous receiver for {module}::{name}", "unresolved receiver")
            common = len(definitions.get(name, ())) > 1
            owner = next(iter(receivers), None) if common else None
            if common and not owner:
                if (name, module, frozenset(words)) in exported_defs or (name, module) in exported_leaf:
                    if (module, name) in identified:
                        continue
                    refs = item_callers(sources, module, name)
                    if refs is None:
                        return stopped(f"ambiguous exported helper: {module}::{name} ({unresolved_reason(sources)})",
                                       "unresolved helper identity")
                    resolved[(module, name)] = refs
                    continue
                local_callers.add((module, name))
                continue
            if owner and frequency.get(owner, 0) > HUB_FUNCTIONS:
                # A hub type is not followed: its name is in most functions. The changed method
                # stays reached by its own name, which every caller of it must mention.
                hubs[owner] = frequency[owner]
                if frequency.get(name, 0) > HUB_FUNCTIONS:
                    hubs[name] = frequency[name]
                    continue
                callers.add(name)
                continue
            callers.add(owner or name)
        callers -= reached
        local_callers -= qualified
        for name, owner in test_methods.items():
            if any(n == name and words & reached for n, _, is_test, _, words, _ in functions if not is_test):
                typed_tests.add(owner)
        if not callers and not local_callers and not resolved:
            break
        layers += 1
        settled = (set(reached), set(qualified), set(identified), set(identified_callers))
        reached |= callers
        distance.update((word, layers) for word in callers)
        qualified |= local_callers
        identified |= set(resolved)
        for refs in resolved.values():
            identified_callers |= refs
        if len(reached) + len(qualified) + len(identified) > NARROW_FUNCTION_CAP:
            # The layer that overflows is far; the layers before it are proven observers.
            reached, qualified, identified, identified_callers = settled
            layers -= 1
            return stopped(f"observer trace exceeds {NARROW_FUNCTION_CAP} functions", "function bound")
    if hubs:
        names = ", ".join(f"{token} ({count} functions)" for token, count in sorted(hubs.items()))
        return stopped(f"observer trace stops at high-fan-in {names}: its direct observers are named, "
                       "its far observers are left to the module filter", "hub")
    found = observer_tests()
    # Concrete private types and enums can have users in several modules.
    # Keep their complete named trace up to a module gate's 60-test threshold.
    resolved_enums = {name for text in (before, after)
                      for name in re.findall(r"\benum\s+(\w+)", text)} & resolved_types
    cap = BROAD_TEST_LIMIT if moved or tokens & resolved_enums else NARROW_TEST_CAP
    count = len({(m, n) for m, n, _ in found})
    if count > cap:
        return stopped(f"observer trace selects {count} tests, exceeding the {cap}-test bound", "test bound")
    return found


def direct_filterset(module):
    """Nextest filterset for the tests declared directly in `module` (none of its submodules')."""
    return f"test(/^{module}::[A-Za-z0-9_]+$/)"


def anchored_filterset(module):
    """Nextest filterset for every test in `module` and the modules beneath it, and no other (#1653)."""
    return f"test(/^{module}::/)"


SIMPLE_MODULE = re.compile(r"test\(([A-Za-z0-9_:]+)\)")
ANCHORED_MODULE = re.compile(r"test\(/\^([A-Za-z0-9_:]+)::/\)")


def named_filterset(module, names):
    """Nextest filterset for the named tests of `module`, wherever an inline `mod` nests them."""
    names = sorted(set(names))
    alternatives = names[0] if len(names) == 1 else "(?:" + "|".join(names) + ")"
    return f"test(/^{module}::(?:\\w+::)*{alternatives}$/)"


def traced_filters(picked):
    grouped = {}
    for module, name, shard in picked:
        grouped.setdefault((shard, module), []).append(name)
    filters = []
    for (shard, module), names in sorted(grouped.items()):
        prefix, chunk = f"rsid=shard:{shard}:", []
        for name in sorted(set(names)):
            if chunk and len(prefix + named_filterset(module, chunk + [name])) > GATE_FILTER_LENGTH:
                filters.append(prefix + named_filterset(module, chunk))
                chunk = []
            chunk.append(name)
        filters.append(prefix + named_filterset(module, chunk))
    return filters


def direct_summary(direct):
    """The part of a stopped trace a broad filter's receipt entry reports: how many tests it proved
    observe the change, how many layers it settled, and the hubs it did not follow (#2588)."""
    if not direct.get("tests"):
        return {}
    return {"direct_tests": len({(module, name) for module, name, _, _ in direct["tests"]}),
            "trace_layers": direct["layers"], "trace_stopped": direct["reason"],
            "hubs": [{"token": token, "functions": count} for token, count in sorted(direct["hubs"].items())]}


def direct_observer_filters(found):
    """[{"filter", "distance"}]: the tests that bounded traces proved observe the change, one set of
    named filters per distance, nearest first. scoped-test ranks them ahead of every unranked far observer,
    whatever its specificity tier; they select nothing the broad fallback does not already select."""
    by_distance = {}
    for (module, name, shard), hops in found.items():
        by_distance.setdefault(hops, []).append((module, name, shard))
    return [{"filter": value, "distance": hops}
            for hops in sorted(by_distance) for value in traced_filters(by_distance[hops])]


def direct_observer_summary(found):
    """{"tests", "by_distance"} of the tests `direct_observer_filters` names, counted by identity."""
    nearest = {}
    for (module, name, _), hops in found.items():
        nearest[(module, name)] = min(hops, nearest.get((module, name), hops))
    by_distance = collections.Counter(nearest.values())
    return {"tests": len(nearest), "by_distance": {str(hops): by_distance[hops] for hops in sorted(by_distance)}}


def covered_filters(filters, merged=None):
    """Deduplicate and remove filters already covered by a same-shard module.

    Use only syntactically proven containment; don't shorten the list by
    broadening a regex or assuming that different shards select the same tests.
    """
    filters = list(dict.fromkeys(filters))
    modules = []
    for value in filters:
        match = SHARD_FILTER.match(value)
        simple = SIMPLE_MODULE.fullmatch(match.group(2)) if match else None
        anchored = ANCHORED_MODULE.fullmatch(match.group(2)) if match else None
        if simple:
            modules.append((value, match.group(1), simple.group(1), False))
        elif anchored:
            modules.append((value, match.group(1), anchored.group(1), True))
    kept = []
    for value in filters:
        match = SHARD_FILTER.match(value)
        # The prefix before the regex's first metacharacter is guaranteed to
        # appear in every selected test name, including inline test modules.
        prefix = re.match(r"test\(/\^([A-Za-z0-9_:]+)", match.group(2)) if match else None
        simple = SIMPLE_MODULE.fullmatch(match.group(2)) if match else None
        scope = prefix.group(1) if prefix else simple.group(1) if simple else None
        # A substring filter covers any scope that contains it; an anchored `^module::` one
        # only the scopes beneath that module.
        covering = next((other for other, shard, module, anchored in modules
                         if scope and other != value and shard == match.group(1)
                         and (scope.startswith(module + "::") if anchored else module in scope)), None)
        if covering:
            if merged is not None:
                merged.append({"filter": value, "covered_by": covering,
                               "reason": "same-shard module filter already selects every matching test"})
            continue
        kept.append(value)
    return kept


def changed_modules(sources, changed, comment_only=frozenset()):
    """The modules and targets whose own source changed, with the tests they already hold (#2182).

    [{"package", "module", "path", "excluded", "tests"}] per changed library module, and
    [{"package", "kind", "target", "path"}] per changed bin or integration-test source. A module's
    tests are the ones whose name begins `<module>::`, except those of a descendant module that is
    a source of its own (`excluded`): its test modules (`tests`, `*_tests`) belong to it, and a
    changed descendant has a record of its own. scoped-test ranks them ahead of every unrelated
    observer, so a time box can never be spent before the change's own module ran. A
    comment-only edit changes no behaviour and ranks nothing."""
    records, seen = [], set()
    for path in sorted(changed):
        if not path.endswith(".rs") or path in comment_only:
            continue
        package = package_for(path)
        module = sources.module(path) if package and path in sources.modules else None
        if module and (package, module) not in seen:
            seen.add((package, module))
            descendants = sorted(m for p, m in sources.modules.items()
                                 if package_for(p) == package and m.startswith(module + "::")
                                 and not is_test_module(m[len(module) + 2:]) and p not in changed)
            excluded = [m for m in descendants if not any(m.startswith(o + "::") for o in descendants if o != m)]
            records.append({"package": package, "module": module, "path": path, "excluded": excluded,
                            "tests": sources.direct_tests_everywhere(module)})
            continue
        for owner_package, kind, name in sources.target_owners(path):
            records.append({"package": owner_package, "kind": kind, "target": name, "path": path})
    return records


def unsharded_filters(filters, shard_packages, merged=None):
    """An identical expression runs once per unsharded package, regardless of label.

    Keep labels with different package coverage and keep every label for the
    explicit sharded --run-filters lane (the caller bypasses this helper).
    """
    kept, seen = [], {}
    for value in dict.fromkeys(filters):
        match = SHARD_FILTER.match(value)
        packages = tuple(sorted(shard_packages.get(match.group(1), ["rsid"]))) if match else ()
        key = (packages, match.group(2)) if match else (value,)
        if key in seen:
            if merged is not None:
                merged.append({"filter": value, "covered_by": seen[key],
                               "reason": "identical expression selects the same unsharded library packages"})
            continue
        seen[key] = value
        kept.append(value)
    return kept


def is_test_module(module):
    return any(part == "tests" or part.endswith("_tests") for part in module.split("::"))


def source_observer_pins(sources, changed, comment_only):
    """([(module, test, shard)], [missing]) the exact tests SOURCE_OBSERVER_PINS names for the changed sources (#2949)."""
    wanted = {pin for path, pins in SOURCE_OBSERVER_PINS.items()
              if path in changed and path not in comment_only for pin in pins}
    found, seen = [], set()
    for name, module, is_test, shards, _, _ in sources.functions():
        if is_test and (module, name) in wanted:
            seen.add((module, name))
            found += [(module, name, shard) for shard in shards]
    return found, sorted(wanted - seen)


def manifest_dir_guard_filters(sources, changed):
    """#417: the workspace guard reads raw Rust files beneath crates/, including tests and comments.

    Mirror rust_sources and its exemptions in rsi-common/tests/manifest_dir_guard.rs.
    Older trees without the guard retain their selection. No source inventory scan is needed.
    """
    guard = "crates/rsi-common/tests/manifest_dir_guard.rs"
    if guard not in sources.tree_files:
        return []
    if any(path.startswith("crates/") and path.endswith(".rs")
           and "target" not in Path(path).parts and Path(path).name != "build.rs"
           and path != "crates/rsi-common/src/manifest_dir.rs" for path in changed):
        return ["rsi-common=test:manifest_dir_guard:test(=workspace_code_never_bakes_the_manifest_path_at_compile_time)"]
    return []


def verb_pin_filters(sources):
    """Named filters for the agent verb catalog tests (#1440), one per shard and module."""
    found = {}
    for name, module, is_test, shards, words, _ in sources.functions():
        if (is_test and f"{module}::".startswith(AGENT_VERB_PIN_MODULES)
                and (AGENT_VERB_PIN_NAME.search(name) or words & {"AGENT_VERBS", "READ_VERBS"})):
            for shard in shards:
                found.setdefault((shard, module), set()).add(name)
    return found


COVERAGE_DECLARATIONS = "scripts/test-coverage.json"


def declared_coverage(repo, merge_base, head, path, sources):
    """(filters, rule) a declared rule gives the diff of `path`, or None (#1585).

    Used only when every changed line, old and new, lies in a function the rule
    names (blank lines and `//` comments are free) and the rule's tests resolve to
    at most NARROW_TEST_CAP sharded tests, every exact name included. Anything
    else returns None and the caller derives the module filters.
    """
    declared = git(repo, "show", f"{head}:{COVERAGE_DECLARATIONS}")
    if declared.returncode != 0:
        return None
    try:
        rules = json.loads(declared.stdout).get("rules", [])
    except ValueError:
        return None
    rule = next((r for r in rules if r.get("path") == path), None)
    old_text = git(repo, "show", f"{merge_base}:{path}")
    if rule is None or old_text.returncode != 0:
        return None
    names, prefixes = set(rule.get("functions", [])), tuple(rule.get("function_prefixes", ()))

    def contained(text, lines):
        rows, spans = text.splitlines(), function_spans(text)
        for number in lines:
            row = rows[number - 1].strip() if 0 < number <= len(rows) else ""
            if not row or row.startswith("//"):
                continue
            if not any(first <= number <= last and (name in names or (prefixes and name.startswith(prefixes)))
                       for name, first, last in spans):
                return False
        return True

    old_lines, new_lines = changed_line_numbers(repo, merge_base, head, path)
    if not (old_lines or new_lines) or not contained(old_text.stdout, old_lines) \
            or not contained(sources.text(path), new_lines):
        return None
    # `tests` is one spec or a list of specs (one per test module); the cap and
    # the every-exact-name check apply to the whole rule.
    specs = rule.get("tests", {})
    specs = specs if isinstance(specs, list) else [specs]
    candidates = list(sources.functions())
    picked = set()
    for spec in specs:
        exact, test_prefixes = set(spec.get("names", [])), tuple(spec.get("prefixes", ()))
        got = {(module, name, shard) for name, module, is_test, shards, _, _ in candidates
               if is_test and module == spec.get("module")
               and (name in exact or (test_prefixes and name.startswith(test_prefixes)))
               for shard in shards}
        if not got or not exact <= {name for _, name, _ in got}:
            return None
        picked |= got
    picked = sorted(picked)
    if not picked or len({(m, n) for m, n, _ in picked}) > NARROW_TEST_CAP:
        return None
    return traced_filters(picked), rule


def leaf_package(path: str) -> str | None:
    """The leaf crate (LEAF_FACADES) whose library source `path` is, else None (#2410)."""
    package = package_for(path)
    if package not in LEAF_FACADES or not path.endswith(".rs"):
        return None
    return package if path.startswith(LEAF_SCOPES.get(package, "")) else None


def only_test_lines(text, lines):
    """Whether every changed line of `text` is blank, a comment, or inside test code (#2410).

    Test code is an inline `mod tests {}`/`*_tests` module or a function carrying `#[test]` or
    `#[cfg(test)]`; a `#[cfg(test)]` attribute row on its own counts as production, so an
    unclear edit keeps the observers."""
    rows = text.splitlines()
    regions = list(test_module_regions(text))
    for _, start, end, attrs, _ in rust_functions(text):
        if TEST_ATTR.search(attrs) or "#[cfg(test)]" in attrs:
            regions.append((start - (attrs.count("\n") + 1 if attrs else 0) + 1, end))
    for number in lines:
        row = rows[number - 1].strip() if 0 < number <= len(rows) else ""
        if row and not row.startswith("//") and not any(first <= number <= last for first, last in regions):
            return False
    return True


def lib_source(path: str) -> bool:
    """A sharded library source: rsid (not a bin target, not main.rs) or rsid-store."""
    if path.startswith(RSID_STORE_SRC):
        return path.endswith(".rs")
    return path.startswith(RSID_SRC) and path.endswith(".rs") and not path.startswith(RSID_SRC + "bin/") and path != RSID_SRC + "main.rs"


def package_of(path: str) -> str:
    return "rsid-store" if path.startswith(RSID_STORE_SRC) else "rsid"


def shard_packages(repo):
    """{shard: [package, ...]} in shard order, from the checker at `repo`.

    A repo whose checker predates the split has no such mode: every shard is rsid's.
    """
    script = repo / "scripts/check-rsid-test-shards.py"
    listing = None
    if script.exists():
        # --shards-only reads the manifests without the source inventory (#1853);
        # a checker that predates it rejects the flag and gets the full listing.
        for flags in (["--shards-only"], []):
            try:
                listing = run([sys.executable, str(script), "--list-shard-packages", *flags], repo, timeout=LIST_TIMEOUT_SEC)
            except subprocess.TimeoutExpired:
                listing = None
                break
            if listing.returncode == 0:
                break
    if listing is not None and listing.returncode == 0:
        mapping = {}
        for line in listing.stdout.splitlines():
            parts = line.split()
            if len(parts) >= 2:
                mapping[parts[0]] = parts[1:]
        if mapping:
            return mapping
    names = []
    if script.exists():
        legacy = run([sys.executable, str(script), "--list-shards"], repo)
        names = legacy.stdout.split() if legacy.returncode == 0 else []
    return {name: ["rsid"] for name in (names or ["store-01"])}


def child_sources(path, tree_files):
    stem = path[:-3] if path.endswith(".rs") else path
    if path.endswith("/mod.rs"):
        stem = path[: -len("/mod.rs")]
    return [path] + [f for f in tree_files if f.startswith(stem + "/")]


def shards_in(text: str) -> set[str]:
    return set(GATE.findall(text))


# Rust lexemes that can hold a shard name that is not a gate: comments, raw and
# ordinary strings (byte/C prefixes included) and char literals.
LITERAL = re.compile(
    r"""//[^\n]*|/\*|(?P<raw>[bc]?r(?P<hashes>\#*)")|[bc]?"|'(?:\\.[^'\n]*|[^'\\\n])'""",
)
CFG_FEATURE = re.compile(r"\bfeature\s*=\s*$")
GATE_LITERAL = re.compile(r"test-shard-([a-z]+-[0-9]+)")


def code_shards(text: str) -> set[str]:
    """Shards gated by `feature = "test-shard-<shard>"` in code (#1818).

    `shards_in` also counts a shard named in a string or comment: a test fixture
    that prints `#[cfg(.. feature = \"test-shard-store-04\"))]` or a doc line is not
    a gate, and mapping a changed file to such a shard compiles it for nothing. Only
    a string that is exactly a shard name directly after `feature =` in code counts;
    anything nested in another literal or a comment is skipped.
    """
    found, position, size = set(), 0, len(text)
    while position < size:
        match = LITERAL.search(text, position)
        if not match:
            break
        token = match.group(0)
        if token == "/*":
            depth, cursor = 1, match.end()
            while depth and cursor < size:
                opener, closer = text.find("/*", cursor), text.find("*/", cursor)
                if closer < 0:
                    cursor = size
                    break
                if 0 <= opener < closer:
                    depth, cursor = depth + 1, opener + 2
                else:
                    depth, cursor = depth - 1, closer + 2
            position = cursor
        elif token.startswith("//") or token.endswith("'"):
            position = match.end()
        else:
            if match.group("raw") is not None:
                end = text.find('"' + match.group("hashes"), match.end())
                end = size if end < 0 else end
                after = end + 1 + len(match.group("hashes"))
            else:
                cursor = match.end()
                while cursor < size and text[cursor] != '"':
                    cursor += 2 if text[cursor] == "\\" else 1
                end, after = cursor, cursor + 1
            gate = GATE_LITERAL.fullmatch(text[match.end():end])
            if gate and CFG_FEATURE.search(text[max(0, match.start() - 40):match.start()]):
                found.add(gate.group(1))
            position = after
    return found


TEST_GATE = re.compile(r'^\s*#\[cfg\(any\(not\(feature = "test-shard-mode"\), feature = "test-shard-([a-z]+-[0-9]+)"\)\)\]\s*$')


def test_shards(text: str) -> set[str]:
    """Shards of the tests themselves: the gate line right above a test attribute.

    A shared helper gated for several shards (`any(.., store-01, store-02)`) puts
    its shards in `shards_in` but holds no test, so a `test(module)` filter for
    them would select nothing (#1260: `store::tests` on store-02).
    """
    lines = text.split("\n")
    return {m.group(1) for i in range(1, len(lines)) if TEST_ATTR.match(lines[i].lstrip()) and (m := TEST_GATE.match(lines[i - 1]))}


def added_lines(repo, merge_base, head):
    """{path: [(lineno, text)]} for .rs files, from a zero-context diff."""
    diff = git_out(repo, "diff", "-U0", "--no-color", f"{merge_base}..{head}", "--", "*.rs")
    out: dict[str, list[tuple[int, str]]] = {}
    path, line = None, 0
    for raw in diff.splitlines():
        if raw.startswith("+++ "):
            path = raw[6:] if raw.startswith("+++ b/") else None
        elif raw.startswith("@@"):
            match = re.search(r"\+(\d+)", raw)
            line = int(match.group(1)) if match else 0
        elif raw.startswith("+") and path:
            out.setdefault(path, []).append((line, raw[1:]))
            line += 1
    return out


def dynamic_sql(added):
    """format!-built SQL: a `format!(` line with a SQL keyword on it or the next 5 added lines."""
    findings = []
    for path, lines in added.items():
        for index, (number, text) in enumerate(lines):
            if "format!(" not in text and "format!" not in text:
                continue
            window = lines[index : index + 6]
            joined = " ".join(item[1] for item in window)
            if SQL_WORDS.search(joined) and not any(SQL_OK in item[1] for item in window):
                findings.append(f"{path}:{number}")
    return findings


def cargo_prefix():
    override = os.environ.get("CHECK_TOUCHED_SHARDS_CARGO")
    if override is not None:
        return override.split()
    slot = Path.home() / ".rsi/bin/cargo-slot"
    # An outer cargo-slot (a declared job recipe, #1560) already holds a governor
    # slot and marks its child; acquiring again would reserve two slots.
    held = bool(os.environ.get("RSI_CARGO_SLOT_HELD"))
    prefix = [str(slot)] if slot.exists() and not held else []
    return prefix + ["env", "-u", "RSI_PROCESS_OWNERSHIP_NAMESPACE", "cargo"]


def workspace_packages(repo):
    """Package names of the workspace members under crates/ (path dependencies)."""
    names = []
    for manifest in sorted((repo / "crates").glob("*/Cargo.toml")):
        found = re.search(r'^\s*name\s*=\s*"([^"]+)"', manifest.read_text(errors="replace").split("[dependencies]")[0], re.M)
        if found:
            names.append(found.group(1))
    return names


def target_directory(repo):
    """The target dir cargo would use in `repo`: CARGO_TARGET_DIR, else what cargo reports."""
    env = os.environ.get("CARGO_TARGET_DIR")
    if env:
        return Path(env)
    # Metadata only: no dependency resolution and no network, never a build (#2564).
    result = run(["cargo", "metadata", "--no-deps", "--offline", "--format-version", "1"], repo)
    try:
        return Path(json.loads(result.stdout)["target_directory"])
    except (ValueError, KeyError, TypeError):
        return None


def clean_workspace_packages(repo):
    """Opt-in (CHECK_TOUCHED_SHARDS_CLEAN=1): drop cached artifacts of every workspace package.

    A target reused after a branch switch can hold a stale rsi-common whose
    fingerprint still looks fresh, so every shard fails with "no field X on ..."
    on a tree that compiles directly (#1260). Off by default: a shared target
    (~/.cargo/shared-target) holds artifacts other agents' builds use, and the
    clean forces a workspace recompile. Never cleans a target directory that is
    not under the repo being checked. Third-party dependencies stay cached.
    """
    if not os.environ.get("CHECK_TOUCHED_SHARDS_CLEAN"):
        return
    target = target_directory(repo)
    if target is None or not target.resolve().is_relative_to(repo.resolve()):
        sys.stderr.write(f"check-touched-shards: not cleaning {target}: the target directory is not under {repo}\n")
        return
    packages = workspace_packages(repo)
    if not packages:
        return
    result = run(cargo_prefix() + ["clean", *[flag for name in packages for flag in ("-p", name)]], repo)
    if result.returncode != 0:
        sys.stderr.write(f"check-touched-shards: cargo clean of workspace packages failed (continuing):\n{result.stderr[-500:]}\n")


def error_signature(stderr):
    """The distinct `error...` lines of a cargo run, for comparing failures across shards."""
    return "\n".join(sorted({line.strip() for line in stderr.splitlines() if line.startswith("error") and "could not compile" not in line}))


def failure_excerpt(stderr):
    """Keep the first error blocks and spans (40 lines/4000 chars) ahead of the tail."""
    diagnostics = []
    in_error = False
    for line in stderr.splitlines():
        if re.match(r"^error(?:\[[^\]]+\])?:", line):
            in_error = True
        elif re.match(r"^warning(?:\[[^\]]+\])?:", line):
            in_error = False
        if in_error:
            diagnostics.append(line)
            if len(diagnostics) >= 40:
                break
    first_errors = "\n".join(diagnostics)[:4000].rstrip()
    tail = stderr[-2000:]
    return f"{first_errors}\n\nstderr tail:\n{tail}" if first_errors else tail


STALE_HINT = (
    "every shard compile failed with the same error while the tree may compile directly: a stale "
    "workspace-package artifact in a reused target is suspected; retry with CHECK_TOUCHED_SHARDS_CLEAN=1 "
    "(cleans only a target under the repo) or point CARGO_TARGET_DIR at a private directory (#1260)"
)


TMPFS_FIXTURE = re.compile(r"\b(?:TempDir::new|tempfile::tempdir|tempdir)\(\)")
SHARD_FILTER = re.compile(r"^rsid=shard:([a-z]+-\d+):(.+)$")


def gate_tmpdir():
    """A private TMPDIR on tmpfs, the filesystem the merge-queue lander gates on.

    A fixture that allocates a sandbox under `$TMPDIR` passes with a disk-backed
    TMPDIR and fails the gate (#1182). Override the parent with
    CHECK_TOUCHED_SHARDS_TMPDIR; without a usable tmpfs the host TMPDIR is used.
    """
    parent = os.environ.get("CHECK_TOUCHED_SHARDS_TMPDIR", "/dev/shm")
    if not os.path.isdir(parent) or not os.access(parent, os.W_OK):
        sys.stderr.write(f"check-touched-shards: {parent} unusable; filters run with the host TMPDIR\n")
        parent = None
    return tempfile.mkdtemp(prefix="check-touched-shards-", dir=parent)


def impact_filters(repo, merge_base, head):
    exe = os.environ.get("RSI_TEST_IMPACT") or shutil.which("rsi-test-impact")
    if not exe:
        return None
    result = run([exe, "--repo", str(repo), "--base", merge_base, "--head", head], repo)
    if result.returncode != 0:
        return None
    filters, in_section = [], False
    for line in result.stdout.splitlines():
        if line.startswith("Lander arguments:"):
            in_section = True
        elif in_section and line.startswith("  --test-filter"):
            filters.append(line.strip().split(None, 1)[1])
        elif in_section and not line.startswith("  "):
            break
    return filters


# #2270: the slow tier. `.config/slow-tier.toml` names the rsid-store tests that re-prove
# RELEASED migrations; nextest's default-filter (generated from it) leaves them out of every
# profile that inherits `default`. The tier runs in full when the candidate diff touches a
# trigger path or a line of a slow test's own source, and in the full QA. Every other tool
# (scripts/scoped-test, rsi-rolling-land) follows the decision made here.
SLOW_TIER_CONFIG = ".config/slow-tier.toml"
NEXTEST_CONFIG = ".config/nextest.toml"
SLOW_TIER_NAME = re.compile(r"[A-Za-z0-9_:]+")
SLOW_TIER_FILTER_LINE = re.compile(r"^default-filter = 'not \(package\(.*$", re.M)
FN_LINE = re.compile(r"^(\s*)(?:pub(?:\([^)]*\))?\s+)?(?:async\s+)?(?:unsafe\s+)?fn\s+(\w+)")
TEST_ATTRIBUTE = re.compile(r"#\[(?:test|tokio::test|test_case)\b")
HUNK = re.compile(r"^@@ -(\d+)(?:,(\d+))? \+(\d+)(?:,(\d+))? @@", re.M)


def parse_slow_tier(text):
    """The validated slow-tier config from its TOML text; ValueError when it is malformed."""
    if tomllib is None:
        raise ValueError("python tomllib is unavailable")
    config = tomllib.loads(text)
    package, paths, tests = config.get("package"), config.get("trigger_paths"), config.get("tests")
    if not isinstance(package, str) or not re.fullmatch(r"[\w-]+", package):
        raise ValueError("slow-tier package must be a package name")
    if not isinstance(paths, list) or not all(isinstance(item, str) and item for item in paths):
        raise ValueError("slow-tier trigger_paths must be a list of paths")
    if not isinstance(tests, list) or not all(isinstance(item, str) and SLOW_TIER_NAME.fullmatch(item) for item in tests):
        raise ValueError("slow-tier tests must be a list of test names ([A-Za-z0-9_:])")
    if len(set(tests)) != len(tests):
        raise ValueError("slow-tier tests lists a name twice")
    return {"package": package, "trigger_paths": list(paths), "tests": list(tests)}


def load_slow_tier(repo, rev):
    """The slow-tier config at `rev`, or None when that revision has none (no tier)."""
    result = git(repo, "show", f"{rev}:{SLOW_TIER_CONFIG}")
    return parse_slow_tier(result.stdout) if result.returncode == 0 else None


def slow_tier_filter(config):
    """The nextest default-filter that leaves exactly the slow-tier tests out."""
    names = "|".join(sorted(config["tests"]))
    return f"not (package({config['package']}) & test(/^(?:{names})$/))"


def write_slow_tier_filter(repo):
    """Regenerate the default-filter line of .config/nextest.toml from .config/slow-tier.toml."""
    config = parse_slow_tier((repo / SLOW_TIER_CONFIG).read_text())
    target = repo / NEXTEST_CONFIG
    text = target.read_text()
    if len(SLOW_TIER_FILTER_LINE.findall(text)) != 1:
        raise ValueError(f"{NEXTEST_CONFIG} must hold exactly one generated `default-filter = 'not (package(` line")
    target.write_text(SLOW_TIER_FILTER_LINE.sub(lambda _match: f"default-filter = '{slow_tier_filter(config)}'", text))
    print(f"check-touched-shards: wrote the slow-tier default-filter ({len(config['tests'])} tests) to {NEXTEST_CONFIG}")
    return 0


def test_fn_spans(lines):
    """[(first line, last line, name)], 1-based, of every `#[test]` fn in `lines`; None when the
    layout is not rustfmt-shaped (a body whose closing brace is not on its own line)."""
    spans = []
    for index, line in enumerate(lines):
        match = FN_LINE.match(line)
        if not match:
            continue
        indent, name = match.groups()
        first, probe, is_test = index, index - 1, False
        while probe >= 0 and index - probe <= 24:
            stripped = lines[probe].strip()
            deeper = len(lines[probe]) - len(lines[probe].lstrip()) > len(indent)
            if not stripped or not (deeper or stripped.startswith(("#[", "//", ")", "]"))):
                break
            is_test = is_test or bool(TEST_ATTRIBUTE.search(stripped))
            first, probe = probe, probe - 1
        if not is_test:
            continue
        if line.rstrip().endswith("}") and line.count("{") == line.count("}"):
            last = index
        else:
            last = next((later for later in range(index + 1, len(lines)) if lines[later].rstrip() == indent + "}"), None)
            if last is None:
                return None
            if any(FN_LINE.match(lines[later]) and FN_LINE.match(lines[later]).group(1) == indent
                   for later in range(index + 1, last)):
                return None
        spans.append((first + 1, last + 1, name))
    return spans


def changed_line_ranges(diff):
    """[(old first, old count, new first, new count)] of the hunks of a `git diff -U0`."""
    return [(int(old), 1 if oldn == "" else int(oldn), int(new), 1 if newn == "" else int(newn))
            for old, oldn, new, newn in HUNK.findall(diff)]


def slow_test_source_change(repo, merge_base, head, path, slow_names):
    """The first changed line of `path` that is not inside a fast `#[test]` fn, for a file that
    declares a slow test; None when the file declares none or every change is in a fast test.

    A change inside a slow test, a shared helper, a `use` line or anything outside a test body
    counts: the slow test (or what it calls) may have changed. Blank lines are neutral."""
    new = git(repo, "show", f"{head}:{path}")
    old = git(repo, "show", f"{merge_base}:{path}")
    texts = {"new": new.stdout if new.returncode == 0 else None, "old": old.stdout if old.returncode == 0 else None}
    declares = re.compile(r"\bfn\s+(?:" + "|".join(map(re.escape, sorted(slow_names))) + r")\b")
    if not any(text and declares.search(text) for text in texts.values()):
        return None
    if texts["new"] is None or texts["old"] is None:
        return 1
    lines = {side: text.splitlines() for side, text in texts.items()}
    spans = {side: test_fn_spans(side_lines) for side, side_lines in lines.items()}
    if any(side_spans is None for side_spans in spans.values()):
        return 1
    diff = git_out(repo, "diff", "-U0", "--no-color", merge_base, head, "--", path)
    for old_first, old_count, new_first, new_count in changed_line_ranges(diff):
        for side, first, count in (("old", old_first, old_count), ("new", new_first, new_count)):
            for number in range(first, first + count):
                if number > len(lines[side]) or not lines[side][number - 1].strip():
                    continue
                if not any(start <= number <= end and name not in slow_names for start, end, name in spans[side]):
                    return number
    return None


def slow_tier_decision(repo, merge_base, head, changed):
    """{"mode": "full"|"excluded", "reason", ...}: whether the slow tier runs for this diff.

    `full` is the conservative answer: no config, an unreadable config or any trigger runs it."""
    try:
        config = load_slow_tier(repo, head)
        if config is None:
            return {"mode": "full", "reason": "no_slow_tier_config", "tests": 0}
        count = len(config["tests"])
        for path in changed:
            for trigger in config["trigger_paths"]:
                if path == trigger or (trigger.endswith("/") and path.startswith(trigger)):
                    return {"mode": "full", "reason": "trigger_path", "path": path, "tests": count}
        slow_names = {name.rsplit("::", 1)[-1] for name in config["tests"]}
        source = f"crates/{config['package']}/src/"
        for path in changed:
            if path.startswith(source) and path.endswith(".rs"):
                line = slow_test_source_change(repo, merge_base, head, path, slow_names)
                if line is not None:
                    return {"mode": "full", "reason": "slow_test_source", "path": path, "line": line, "tests": count}
        return {"mode": "excluded", "reason": "no_trigger", "tests": count}
    except (OSError, ValueError, subprocess.SubprocessError) as error:
        return {"mode": "full", "reason": f"decision_error: {type(error).__name__}: {error}", "tests": 0}



E2E_SURFACE_CONFIG = "scripts/e2e-tui-surfaces.json"


@functools.lru_cache(maxsize=None)
def glob_regex(pattern):
    """`*` stays in one path segment, `**` crosses directories."""
    out, i = [], 0
    while i < len(pattern):
        if pattern.startswith("**", i):
            out.append(".*")
            i += 2
        elif pattern[i] == "*":
            out.append("[^/]*")
            i += 1
        else:
            out.append(re.escape(pattern[i]))
            i += 1
    return re.compile("".join(out) + r"\Z")


def e2e_surface_filters(repo, head, changed, comment_only=frozenset()):
    """#2321: `rsi=test:e2e_tui:test(<module>::)` for each e2e_tui module that drives a changed TUI file.

    The map is `scripts/e2e-tui-surfaces.json` at the candidate head. A module the e2e root
    does not mount, or that holds no test, is dropped and reported. When every module is
    selected the whole target is suggested instead (the same run, one filter).
    Returns (filters, selected, dropped).
    """
    shown = git(repo, "show", f"{head}:{E2E_SURFACE_CONFIG}")
    if shown.returncode != 0:
        return [], [], []
    config = json.loads(shown.stdout)
    package, target, root = config["package"], config["target"], config["root"]
    root_text = git(repo, "show", f"{head}:{root}")
    if root_text.returncode != 0:
        return [], [], []
    base_dir = posixpath.dirname(root)
    mounted = {}
    for match in re.finditer(r'(?:#\[path\s*=\s*"([^"]+)"\]\s*)?(?:pub\s+)?mod\s+(\w+)\s*;', root_text.stdout):
        mounted[match.group(2)] = posixpath.normpath(posixpath.join(base_dir, match.group(1) or f"{target}/{match.group(2)}.rs"))
    holds_tests = {}
    for module, source in mounted.items():
        text = git(repo, "show", f"{head}:{source}")
        holds_tests[module] = text.returncode == 0 and holds_runnable_test(text.stdout)
    candidates = [path for path in changed if path not in comment_only]
    selected, dropped, seen = [], [], set()
    for surface in config["surfaces"]:
        patterns = [glob_regex(pattern) for pattern in surface["paths"]]
        paths = sorted(path for path in candidates if any(pattern.match(path) for pattern in patterns))
        if not paths:
            continue
        for module in surface["modules"]:
            if module in seen:
                continue
            if not holds_tests.get(module):
                dropped.append({"filter": f"{package}=test:{target}:test({module}::)",
                                "reason": f"module `{module}` is not mounted by {root} or holds no test"})
                continue
            seen.add(module)
            selected.append({"module": module, "paths": paths, "reason": surface.get("reason", "")})
    if not selected:
        return [], [], dropped
    if seen >= {module for module, ok in holds_tests.items() if ok}:
        return [f"{package}=test:{target}"], selected, dropped
    return [f"{package}=test:{target}:test({item['module']}::)" for item in selected], selected, dropped


def verdict(ok, detail=""):
    return {"verdict": "ok" if ok else "fail", "detail": detail}


def compile_mode(args):
    """The mode label of this run: compile, no_compile or filters_only; None when none was chosen."""
    if args.filters_only:
        return "filters_only"
    if args.no_compile:
        return "no_compile"
    return "compile" if args.compile else None


def compile_receipt(mode, shard_runs):
    """What the compile phase truly did, so a skipped compile is never read as verified (#2564)."""
    executed = mode == "compile"
    receipt = {"mode": mode, "status": "executed" if executed else "skipped",
               "cargo_check_invoked": bool(shard_runs), "shards_checked": sorted(shard_runs)}
    if not executed:
        receipt["detail"] = "planning only: compile validation belongs to the supervised scoped_test job"
    return receipt


DESKTOP_PATH_LIMIT = 50


def _desktop_gate():
    """The desktop lane's gate module (hyphenated file name): the one source of its trigger inputs."""
    import importlib.util
    spec = importlib.util.spec_from_file_location("desktop_test_gate", Path(__file__).resolve().with_name("desktop-test-gate.py"))
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def desktop_lane(changed, inputs=None):
    """The `desktop` test lane selection (hub #3001, #3042): selected exactly when a changed path is a lane input.

    The inputs are `desktop-test-gate.py`'s `trigger_inputs`: `desktop/`, `Cargo.toml`, `docs/keybindings.md`, `crates/rsi/src`
    and the path dependencies of `desktop/src-tauri/Cargo.toml` (`inputs` is that list read at the candidate's
    head; without it, only the manifest-free static inputs apply). The desktop app is a Tauri workspace of its
    own with its own node frontend, so no Cargo shard filter covers it; scoped-test and the merge queue run
    `scripts/desktop-test-gate.py` for it instead (`npm test` and `cargo test` in `desktop/src-tauri`).
    A diff elsewhere selects nothing.
    The receipt's `desktop` object lists at most DESKTOP_PATH_LIMIT of the selecting paths; `total` counts them all."""
    gate = _desktop_gate()
    inputs = gate.static_inputs() if inputs is None else inputs
    paths = sorted(path for path in changed if gate.under(path, inputs))
    return {"selected": bool(paths), "total": len(paths), "paths": paths[:DESKTOP_PATH_LIMIT]}


def desktop_lane_at(repo, base, head, changed):
    """`desktop_lane` with the trigger inputs read from the candidate's manifest at `head`.

    Fails closed (#355): when `head` lacks `scripts/desktop-test-gate.py` and the diff touches it or one of the
    lane's manifest-derived inputs (or that closure cannot be established), the entry is `selected`
    with an `error` naming the script (the run then fails);
    selecting nothing is only right for a diff that needs no lane."""
    gate = _desktop_gate()
    try:
        gate.require_selector(repo, base, head)
    except gate.SelectorMissing as error:
        lane = desktop_lane(changed, gate.static_inputs())
        return {**lane, "selected": True, "error": str(error)}
    return desktop_lane(changed, gate.trigger_inputs(gate.git_reader(repo, head)))


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--base", default="origin/rolling", help="revision the candidate lands on (default origin/rolling)")
    parser.add_argument("--head", default="HEAD")
    parser.add_argument("--repo", default=".", help="worktree to check (default cwd)")
    parser.add_argument("--compile", action="store_true", help="explicit verifier mode: shard-mode `cargo check` every touched shard. Start it only inside a supervised job (the check-touched-shards recipe, candidate-receipt.sh); planning uses --filters-only (#2564)")
    parser.add_argument("--no-compile", action="store_true", help="map shards but skip the cargo compile")
    parser.add_argument("--filters-only", action="store_true", help="derive suggested_filters and cheap git audits only: no cargo compile, no shard-gate/migration audits, no rsi-test-impact (seconds on a loaded host, #1853)")
    parser.add_argument("--run-filters", action="store_true", help="run the suggested rsid shard landing filters (plus any --filter) under a tmpfs TMPDIR, as the merge-queue lander does (#1182)")
    parser.add_argument("--filter", action="append", default=[], help="extra landing filter rsid=shard:<shard>:<filterset> to run with --run-filters (repeatable)")
    parser.add_argument("--json", action="store_true", help="print only the JSON receipt")
    parser.add_argument("--receipt-line", action="store_true", help="print the receipt last as one `RECEIPT_JSON <json>` line (used by candidate-receipt.sh)")
    parser.add_argument("--receipt", help="also write the JSON receipt to this path")
    parser.add_argument("--slow-tier-only", action="store_true", help="print the slow-tier decision (JSON) for base..head and exit: whether the diff runs the migration-history tests in full (#2270)")
    parser.add_argument("--write-slow-tier-filter", action="store_true", help="regenerate the nextest default-filter in .config/nextest.toml from .config/slow-tier.toml and exit")
    args = parser.parse_args()
    if args.write_slow_tier_filter:
        try:
            return write_slow_tier_filter(Path(args.repo).resolve())
        except (OSError, ValueError) as error:
            sys.stderr.write(f"check-touched-shards: {error}\n")
            return 1
    if args.compile and (args.no_compile or args.filters_only):
        parser.error("--compile contradicts --no-compile and --filters-only")
    if not (compile_mode(args) or args.slow_tier_only):
        parser.error("compiling is an explicit verifier mode: pass --compile only inside a supervised job; "
                     "to plan filters pass --filters-only (no cargo, seconds), or --no-compile")
    mode = compile_mode(args)
    if args.filters_only:
        if args.run_filters:
            parser.error("--filters-only does not run filters; drop --run-filters")
        args.no_compile = True
    started = time.monotonic()
    timings = {}
    # A derivation that takes seconds needs no log; the full check does (#1657).
    PROGRESS[0] = not args.filters_only and not os.environ.get("CHECK_TOUCHED_SHARDS_QUIET")

    def lap(name):
        timings[name] = max(0.0, round(time.monotonic() - started - sum(timings.values()), 2))
        progress(f"{name} done in {timings[name]}s")

    repo = Path(args.repo).resolve()
    base = git_out(repo, "rev-parse", args.base).strip()
    head = git_out(repo, "rev-parse", args.head).strip()
    mb = git(repo, "merge-base", "--all", base, head)
    merge_bases = mb.stdout.split() if mb.returncode == 0 else []
    # A branch that merged an earlier, still-queued commit of rolling has two merge
    # bases (#1633). `git merge-base` then names one and the diff re-counts what
    # the other side already holds, so diff against the base tip itself, kept to
    # the files some merge base also sees changed (a file only rolling changed is
    # not part of the candidate). One merge base keeps the plain merge-base diff.
    multiple_bases = len(merge_bases) > 1
    merge_base = base if multiple_bases or not merge_bases else merge_bases[0]
    audit_base = merge_bases[0] if merge_bases else base

    # The true delta of a candidate with several merge bases is what the merge
    # changes in the base tip: diff the tip against the merge-tree result, so a
    # file rolling changed after an earlier commit the branch merged (and the
    # branch still carries the older bytes of) is not counted as the candidate's
    # (#2814). A conflicted merge cannot land; it keeps the intersection below.
    merged_tree = None
    if multiple_bases:
        merged = git(repo, "merge-tree", "--write-tree", base, head)
        first = merged.stdout.split()[0] if merged.returncode == 0 and merged.stdout.split() else ""
        merged_tree = first or None

    def diff_names(*flags):
        if not multiple_bases:
            return [p for p in git_out(repo, "diff", "--name-only", *flags, f"{merge_base}..{head}").splitlines() if p]
        if merged_tree:
            return sorted(p for p in git_out(repo, "diff", "--name-only", *flags, base, merged_tree).splitlines() if p)
        tip = set(git_out(repo, "diff", "--name-only", *flags, base, head).splitlines())
        seen = set()
        for each in merge_bases:
            seen |= set(git_out(repo, "diff", "--name-only", *flags, f"{each}..{head}").splitlines())
        return sorted(p for p in tip & seen if p)

    changed = diff_names()
    slow_tier = slow_tier_decision(repo, merge_base, head, changed)
    if args.slow_tier_only:
        print(json.dumps(slow_tier, sort_keys=True))
        return 0
    added_files = set(diff_names("--diff-filter=A"))
    if multiple_bases:
        sys.stderr.write(f"check-touched-shards: {len(merge_bases)} merge bases ({', '.join(b[:9] for b in merge_bases)}): "
                         f"diffing against the base tip {base[:9]}, kept to files a merge base also sees changed (#1633)\n")

    # merge-clean vs base
    tree = git(repo, "merge-tree", "--write-tree", base, head)
    merge_clean = True if tree.returncode == 0 else (False if tree.returncode == 1 else None)

    # shard mapping
    tree_files = [f for f in git_out(repo, "ls-tree", "-r", "--name-only", head, "crates").splitlines()]
    sources = SourceTree(repo, head, tree_files)
    affected = changed
    old_sources = None
    if any(lib_source(p) for p in changed):
        old_files = git_out(repo, "ls-tree", "-r", "--name-only", merge_base, "crates").splitlines()
        old_sources = SourceTree(repo, merge_base, old_files)
        affected = list(dict.fromkeys(
            target for path in changed
            for target in registration_sources(path, sources, old_sources)
        ))
    lap("diff_and_sources")
    shard_files: dict[str, list[str]] = {}
    rsid_changed = [p for p in affected if lib_source(p)]
    packages_of_shard = shard_packages(repo)
    for path in rsid_changed:
        for shard in sources.shards_for(path):
            shard_files.setdefault(shard, []).append(path)
    fallback = None
    if rsid_changed and not shard_files:
        # A shard declared by a changed package: an rsid-store-only change must
        # not fall back to a shard that compiles only rsid.
        changed_packages = {package_of(p) for p in rsid_changed}
        fallback = next(
            (name for name, pkgs in packages_of_shard.items() if changed_packages & set(pkgs)),
            next(iter(packages_of_shard), "store-01"),
        )
        shard_files[fallback] = list(rsid_changed)
    # The daemon depends on the store: compile one rsid-only shard too, so a
    # store API change that breaks session code cannot hide behind store shards.
    dependent_shard = None
    if any(p.startswith(RSID_STORE_SRC) for p in rsid_changed):
        dependent_shard = next((n for n, pkgs in packages_of_shard.items() if pkgs == ["rsid"]), None)
        if dependent_shard and dependent_shard not in shard_files:
            shard_files[dependent_shard] = []

    lap("shard_mapping")
    compiled = {"ok": [], "failed": [], "skipped": args.no_compile}
    shard_runs = {}
    failure_signatures = {}

    def checkpoint(phase):
        """A durable partial receipt after each shard, so a run the unit budget
        kills mid-way leaves the shards it finished instead of nothing (#1718)."""
        partial = {
            "partial": True, "phase": phase, "ok": False, "base": base, "head": head, "merge_base": merge_base,
            "changed_files": len(changed),
            "compile": compile_receipt(mode, shard_runs),
            "shards": {"compiled_ok": compiled["ok"], "compiled_failed": compiled["failed"],
                       "compile_pending": [s for s in sorted(shard_files) if s not in shard_runs],
                       "compile_skipped": compiled["skipped"], "runs": shard_runs, "map": shard_files},
            "timings_sec": dict(timings),
        }
        if args.receipt:
            write_receipt(args.receipt, partial)
        return partial

    def interrupted(signum, _frame):
        partial = checkpoint("interrupted")
        progress(f"interrupted by signal {signum}; shards ok so far: {','.join(compiled['ok']) or '-'}; "
                 f"pending: {','.join(partial['shards']['compile_pending']) or '-'}")
        if args.receipt_line:
            print("RECEIPT_JSON " + json.dumps(partial, separators=(",", ":")), flush=True)
        raise SystemExit(128 + signum)

    if not args.no_compile:
        signal.signal(signal.SIGTERM, interrupted)
        clean_workspace_packages(repo)
        shards = sorted(shard_files)
        checkpoint("mapped")
        for number, shard in enumerate(shards, 1):
            package_flags = [flag for pkg in packages_of_shard.get(shard, ["rsid"]) for flag in ("-p", pkg)]
            cmd = cargo_prefix() + ["check", *package_flags, "--lib", "--tests", "--no-default-features", "--features", f"test-shard-{shard}"]
            progress(f"compiling shard {shard} ({number}/{len(shards)}); a held build slot queues first")
            shard_started = time.monotonic()
            result = run(cmd, repo)
            seconds = round(time.monotonic() - shard_started, 1)
            waited = slot_wait_seconds(result.stderr)
            shard_runs[shard] = {"verdict": "ok" if result.returncode == 0 else "fail", "seconds": seconds,
                                 "slot_wait_sec": waited, "build_sec": round(max(0.0, seconds - waited), 1)}
            (compiled["ok"] if result.returncode == 0 else compiled["failed"]).append(shard)
            progress(f"shard {shard} {'ok' if result.returncode == 0 else 'FAILED'} in {seconds}s "
                     f"(build slot wait {waited}s)")
            if result.returncode != 0:
                failure_signatures[shard] = error_signature(result.stderr)
                sys.stderr.write(f"shard {shard} compile failed:\ncommand: {shlex.join(cmd)}\n"
                                 f"exit code: {result.returncode}\n{failure_excerpt(result.stderr)}\n")
            checkpoint("compile")

    suspect_stale = None
    if len(compiled["failed"]) >= 2 and not compiled["ok"] and len(set(failure_signatures.values())) == 1 and next(iter(failure_signatures.values())):
        suspect_stale = {"hint": STALE_HINT, "error": next(iter(failure_signatures.values()))[:500]}
        sys.stderr.write(f"check-touched-shards: shard_compile_suspect_stale: {STALE_HINT}\n")
    lap("compile")
    audits = {}
    filter_runs = {"ok": [], "failed": [], "skipped": not args.run_filters}
    heavy_skipped = {"verdict": "skipped", "detail": "--filters-only"}
    if args.filters_only:
        audits["shard_gates"] = dict(heavy_skipped)
    elif (repo / "scripts/check-rsid-test-shards.py").exists():
        result = run([sys.executable, "scripts/check-rsid-test-shards.py", "--require-gates"], repo)
        audits["shard_gates"] = verdict(result.returncode == 0, (result.stdout + result.stderr).strip()[-300:])
    else:
        audits["shard_gates"] = {"verdict": "skipped", "detail": "script absent"}
    result = (git(repo, "diff", "--check", base, head, "--", *changed) if multiple_bases and changed
              else git(repo, "diff", "--check", f"{base}...{head}"))
    audits["diff_check"] = verdict(result.returncode == 0, result.stdout.strip()[-300:])
    if args.filters_only:
        audits["released_migrations"] = dict(heavy_skipped)
    elif (repo / "tools/check-released-migrations.py").exists():
        result = run([sys.executable, "tools/check-released-migrations.py", audit_base, head], repo)
        audits["released_migrations"] = verdict(result.returncode == 0, (result.stdout + result.stderr).strip()[-300:])
    else:
        audits["released_migrations"] = {"verdict": "skipped", "detail": "tool absent"}
    kept = set(changed)
    added = {path: lines for path, lines in added_lines(repo, merge_base, head).items() if path in kept}
    sql = dynamic_sql(added)
    audits["dynamic_sql"] = {"verdict": "ok" if not sql else "flag", "detail": ", ".join(sql[:10])}
    # #1182: a fixture on $TMPDIR passes with a disk-backed TMPDIR and fails the
    # lander's tmpfs gate when it allocates a sandbox. Advisory: read each flag;
    # add `tmpfs-fixture-ok` on the line when the test never allocates a sandbox.
    tmpfs_fixtures = [
        f"{path}:{number}"
        for path, lines in added.items()
        if path.startswith("crates/rsid/src/session/")
        for number, text in lines
        if TMPFS_FIXTURE.search(text) and "tmpfs-fixture-ok" not in text
    ]
    audits["tmpfs_fixture"] = {"verdict": "ok" if not tmpfs_fixtures else "flag", "detail": ", ".join(tmpfs_fixtures[:10])}

    lap("audits")
    # migrations
    # The head and the new units follow the layout each revision builds from:
    # the rsid-store directory when populated, else the pre-split one. A unit
    # added to the pre-split directory of a split head is never executed.
    def layout_heads(rev):
        for pattern, directory in ((MIGRATION_FILE, MIGRATIONS), (PRE_SPLIT_MIGRATION_FILE, PRE_SPLIT_MIGRATIONS)):
            found = [int(m.group(1)) for p in git_out(repo, "ls-tree", "--name-only", rev, directory).splitlines() if (m := pattern.match(p))]
            if found:
                return found, pattern
        return [], MIGRATION_FILE

    base_heads, _ = layout_heads(base)
    head_versions, head_pattern = layout_heads(head)
    split_head = head_pattern is MIGRATION_FILE and bool(head_versions)
    new_migrations = sorted(int(m.group(1)) for p in added_files if (m := (MIGRATION_FILE.match(p) or PRE_SPLIT_MIGRATION_FILE.match(p))))
    stray_pre_split = sorted(p for p in added_files if split_head and PRE_SPLIT_MIGRATION_FILE.match(p))
    base_head = max(base_heads) if base_heads else None
    # A slice numbered after an in-flight sibling declares it (#1285): the numbers it skips are
    # `pending_predecessors` in a newly added provisional declaration, and are not a conflict.
    pending_predecessors = []
    if new_migrations and base_head is not None:
        declaration_texts = [
            git_out(repo, "show", f"{head}:{name}")
            for name in sorted(added_files)
            if name.startswith("tools/provisional-migrations/") and name.endswith(".json")
        ]
        if declaration_texts:
            try:
                pending_predecessors = _released_migration_guard(repo).parse_pending_predecessors(declaration_texts, base_head)
            except Exception:  # a malformed declaration fails the released-migration audit, not this count
                pending_predecessors = []
    first_expected = base_head + 1 if base_head is not None else None
    while first_expected in pending_predecessors:
        first_expected += 1
    migration_conflict = bool(new_migrations and base_head is not None and new_migrations[0] != first_expected)

    lap("migrations")
    # suggested filters
    # Only filters that match at least one test: a static check that the file (or
    # its child modules) holds a test, never a filter that would match nothing
    # (a 40-minute landing gate was refused for one, #1129).
    suggested = []
    rewind_filters = None
    narrowed, broad, declared_used = [], [], []
    direct_found = {}  # (module, name, shard) -> nearest distance of a test the bounded traces proved (#2588)
    derived_by_path = {}
    comment_only = set()
    for path in changed:
        if not path.endswith(".rs"):
            continue
        before = old_sources.text(path) if old_sources else git(repo, "show", f"{merge_base}:{path}").stdout
        if rust_comment_only_change(before, sources.text(path)):
            comment_only.add(path)
    comment_scanners = source_scanner_tests(sources, comment_only) if comment_only else []
    suggested.extend(traced_filters(comment_scanners))

    def shard_filters(path, module, shards):
        """Landing filters of one changed sharded source; bounded, or flagged `broad` (#1418, #1438).

        A test module that mounts test submodules gets only its own tests (the
        `test(module)` prefix also selects every submodule). A filter selecting
        more than BROAD_TEST_LIMIT tests is narrowed to the tests that mention
        the changed functions; when that cannot be traced it is kept and flagged.
        """
        nonlocal old_sources
        children = sources.test_children(module) if is_test_module(module) else []
        if children and not any(sources.direct_tests(s, module) for s in shards):
            children = []
        count = (lambda s: sources.direct_tests(s, module)) if children else (lambda s: sources.tests_selected(s, module))
        if children:
            shards = [s for s in shards if count(s)]
        scope = direct_filterset(module) if children else f"test({module})"
        # The real run selects the tests of every shard, whichever shard labels the
        # filter (#1698), so every labelled copy is as large as the whole selection.
        selected = sources.direct_tests_everywhere(module) if children else sources.tests_selected_everywhere(module)
        # A substring that also names tests outside the module (`deploy` in `v95_deployed_...`)
        # would run them too; anchor the filter to the module's own tree (#1653).
        foreign = [] if children else sources.foreign_tests(module)
        if foreign and shards:
            scope = anchored_filterset(module)
            selected = sources.subtree_tests_everywhere(module)
            narrowed.append({"path": path, "module": module, "filter": scope, "tests": selected,
                             "reason": f"`test({module})` is a substring match and also selects {len(foreign)} tests outside the module "
                                       f"(e.g. {', '.join(foreign[:3])}); anchored to the module's own tree"})
        over = {s: selected for s in shards} if selected > BROAD_TEST_LIMIT else {}
        diagnostics, direct_out = [], {}
        declaration = False
        if path in changed:
            old_lines, new_lines = changed_line_numbers(repo, merge_base, head, path)
            before = git(repo, "show", f"{merge_base}:{path}").stdout
            for text, lines in ((before, old_lines), (sources.text(path), new_lines)):
                spans, rows = function_spans(text), text.splitlines()
                enums = set(re.findall(r"\benum\s+(\w+)", text))
                owners = type_owners(text, enums)
                declaration |= any(owners[line - 1] in enums for line in lines)
                declaration |= any(
                    re.fullmatch(r"\s*(?:pub(?:\([^)]*\))?\s+)?\w+\s*:\s*[^{};]+,", rows[line - 1])
                    and not any(first <= line <= last for _, first, last in spans)
                    for line in lines)
        if (over or declaration or path == RSID_SRC + "rpc.rs") and path in changed:
            if old_sources is None:
                old_files = git_out(repo, "ls-tree", "-r", "--name-only", merge_base, "crates").splitlines()
                old_sources = SourceTree(repo, merge_base, old_files)
            picked = narrow_tests(sources, old_sources, repo, merge_base, head, path, diagnostics,
                                  direct=direct_out)
            if picked is None and direct_out.get("tests"):
                for *key, hops in direct_out["tests"]:
                    direct_found[tuple(key)] = min(hops, direct_found.get(tuple(key), hops))
            if picked is not None:
                narrowed.append({"path": path, "module": module, "tests": len({(m, n) for m, n, _ in picked}),
                                 "reason": f"`{scope}` selects {selected} tests; " + (
                                     "narrowed to the tests that mention the change"
                                     if picked else "no test mentions the change, so only the compile check observes it")})
                return traced_filters(picked)
        if children and shards:
            narrowed.append({"path": path, "module": module, "filter": scope, "excludes": children,
                             "reason": "a test module that mounts test submodules selects its own tests only; add test(<submodule>) after editing a helper they share"})
        for shard, tests in over.items():
            broad.append({"filter": f"rsid=shard:{shard}:{scope}", "tests": tests, "path": path,
                          "reason": "; ".join(diagnostics) or "diff cannot be traced to the tests that observe it",
                          "stop": direct_out.get("reason"),
                          "worker_bounded": direct_out.get("reason") in WORKER_BOUNDED_STOPS,
                          **direct_summary(direct_out)})
        return [f"rsid=shard:{s}:{scope}" for s in shards]

    leaf_notes = []
    unprovable = []

    def leaf_observers(path, package):
        """Landing filters of the daemon tests that observe a production edit of leaf crate `package` (#2410).

        The leaf cannot name its callers, so its own `<package>=<module>` filter is never enough: the
        tests of the retained facade module always run, and the sharded tests that name the changed
        identifiers join them when the trace is complete. A test-only edit of the leaf selects none."""
        nonlocal old_sources
        before = old_sources.text(path) if old_sources else git(repo, "show", f"{merge_base}:{path}").stdout
        old_lines, new_lines = changed_line_numbers(repo, merge_base, head, path)
        if only_test_lines(before, old_lines) and only_test_lines(sources.text(path), new_lines):
            leaf_notes.append({"path": path, "package": package, "filters": [],
                               "reason": "only the leaf's test code changed: its own tests observe it"})
            return []
        facades = LEAF_FACADES[package]
        facade_filters = []
        for facade in facades:
            facade_dir = f"{RSID_SRC}{facade.replace('::', '/')}"
            facade_path = next((p for p in (f"{facade_dir}/mod.rs", f"{facade_dir}.rs") if p in sources.texts), None)
            shards = sorted(sources.shards_for(facade_path)) if facade_path else []
            if shards:
                facade_filters += shard_filters(facade_path, facade, shards)
        fallback_only = package in LEAF_FACADES_FALLBACK_ONLY
        filters = [] if fallback_only else list(facade_filters)
        facade = " and ".join(f"`{f}`" for f in facades)
        if old_sources is None:
            old_files = git_out(repo, "ls-tree", "-r", "--name-only", merge_base, "crates").splitlines()
            old_sources = SourceTree(repo, merge_base, old_files)
        diagnostics = []
        picked = narrow_tests(sources, old_sources, repo, merge_base, head, path, diagnostics)
        if picked:
            filters += traced_filters(picked)
        if picked is None:
            # #2441: a trace that cannot be proven must not leave the facade tests as the only daemon
            # coverage, because any filter suppresses the lander's own closure over the leaf and rsid
            # sources. Withdraw every filter so the gate runs that complete closure instead.
            unprovable.append(path)
            leaf_notes.append({
                "path": path, "package": package, "filters": [], "unfiltered": True,
                "reason": ("production edit: the trace to the daemon tests is not provable ("
                           + ("; ".join(diagnostics) or "unresolved") + "), so no filter is derived and the lander's "
                           "complete closure over the leaf and rsid sources selects the observers"),
            })
            return []
        leaf_notes.append({
            "path": path, "package": package, "filters": list(dict.fromkeys(filters)),
            "reason": ((f"production edit: the {facade} facade tests plus " if not fallback_only else "production edit: ")
                       + (f"{len({(m, n) for m, n, _ in picked})} sharded tests that name the change" if picked
                          else "no other sharded test named the change")),
        })
        return filters

    if REWIND_FIXTURE in affected:
        before = git(repo, "show", f"{merge_base}:{REWIND_FIXTURE}").stdout
        if rewind_only_change(before, sources.text(REWIND_FIXTURE)):
            added_units = sorted(p for p in added_files if MIGRATION_FILE.match(p))
            additive = bool(added_units) and all(additive_migration(sources.text(p)) for p in added_units)
            rewind_filters = (additive and rewind_test_filters(sources, pins_only=True)
                              or rewind_test_filters(sources) or None)
            if rewind_filters:
                reason = ("proven additive/isolated migration selects only migration-chain pins" if additive else
                          "rewind helper change has no proven additive/isolated migration; retained every caller")
                narrowed.append({"path": REWIND_FIXTURE, "module": sources.module(REWIND_FIXTURE),
                                 "tests": len(rewind_filters), "reason": reason})
                if not additive and len(rewind_filters) > BROAD_TEST_LIMIT:
                    broad.append({"path": REWIND_FIXTURE, "filter": "migration rewind callers",
                                  "tests": len(rewind_filters), "reason": reason})
    for path in affected:
        if path in comment_only:
            narrowed.append({"path": path, "module": sources.module(path),
                             "tests": len({(m, n) for m, n, _ in comment_scanners}),
                             "reason": "only Rust comments/docs changed; compile check and source readers observe the change"})
            continue
        if path == REWIND_FIXTURE and rewind_filters:
            suggested.extend(rewind_filters)
            continue
        # Targets mounting the metadata still observe it, independently of
        # the library replay closure below.
        for filter_ in sources.target_filters(path):
            if filter_ not in suggested:
                suggested.append(filter_)
        if path in (MIGRATIONS + "altered_objects.rs", PRE_SPLIT_MIGRATIONS + "altered_objects.rs"):
            filters = covered_filters(traced_filters(migration_metadata_tests(sources, path))
                                      + rewind_test_filters(sources))
            if filters:
                derived_by_path[path] = filters
                suggested.extend(filters)
                narrowed.append({"path": path, "module": sources.module(path),
                                 "reason": "migration catalog metadata selects its consumers and all required replay callers"})
                continue
        # #1937, #1650: a bin or integration target that compiles this source
        # (its root, a module it mounts, a `tests/` helper) runs its own tests.
        if TARGET.match(path) or (sources.target_owners(path) and not sources.lib_mounted(path)):
            continue
        if (leaf := leaf_package(path)) and path in changed:
            for filter_ in leaf_observers(path, leaf):
                if filter_ not in suggested:
                    suggested.append(filter_)
        module = sources.module(path)
        if module is None and (root_filter := crate_root_test_filter(sources, path)):
            # #2331: a library root has no module path, but its own inline `mod tests`
            # (`tests::name`) still observes the diff.
            suggested.append(root_filter)
            continue
        if module is None or (path.startswith(SHARDED_SRCS) and not lib_source(path)):
            continue
        if path.startswith(SHARDED_SRCS):
            shards = sorted(s for s, files in shard_files.items() if path in files and s != fallback)
            declared = declared_coverage(repo, merge_base, head, path, sources) if path in changed else None
            if declared:
                derived_by_path[path] = declared[0]
                declared_used.append({"path": path, "filters": declared[0], "reason": declared[1].get("reason", "")})
            else:
                derived_by_path[path] = shard_filters(path, module, shards)
            suggested += derived_by_path[path]
        elif sources.has_tests(path):
            # The owning package: `rsid-core=process_control`, not `rsi=process_control`.
            suggested.append(f"{package_for(path)}={module}")
    # A bin, integration test or library module that reads a changed file
    # (include_str!/include_bytes!, a command/skill/prompt asset, a package
    # fixture named by a path literal) observes it although it is not in the
    # diff (#1769, #1926).
    changed_files = set(changed) | set(affected)
    data_changed = {p for p in changed if not p.endswith(".rs")}
    readers = include_readers(repo, head, changed_files)
    readers += asset_reader_targets(repo, head, tree_files, set(changed))
    readers += data_readers(repo, head, sources, data_changed)
    for path in dict.fromkeys(readers):
        for filter_ in reader_filters(sources, path):
            if filter_ not in suggested:
                suggested.append(filter_)
    # #2057: a data file under src/ is observed through the item that includes it, so
    # name that item's tests instead of leaving the lander's whole-module closure to
    # fall back to every library test. None keeps today's behaviour.
    included = include_item_tests(sources, set(changed))
    for filter_ in traced_filters(included or []):
        if filter_ not in suggested:
            suggested.append(filter_)
    # #2034: a source scanner reads production files it does not name, so any
    # diff touching production Rust in a crate it scans also runs the scanners.
    scanners = source_reader_tests(sources, changed, comment_only)
    token_scanners = scanned_token_tests(sources, old_sources, changed, merge_base, comment_only)
    scanners = sorted(set(scanners) | set(token_scanners))
    for filter_ in traced_filters(scanners):
        if filter_ not in suggested:
            suggested.append(filter_)
    for filter_ in source_reader_targets(sources, changed):
        if filter_ not in suggested:
            suggested.append(filter_)
    # #2321: a changed TUI surface runs the e2e_tui modules that drive it, and only those.
    e2e_filters, e2e_surfaces, e2e_dropped = e2e_surface_filters(repo, head, set(changed), comment_only)
    for filter_ in e2e_filters:
        whole_target = ":" not in filter_.split("=", 1)[1][len("test:"):]
        if whole_target:
            suggested[:] = [f for f in suggested if not f.startswith(filter_ + ":")]
        elif any(f.split("=", 1)[1] == "test:" + filter_.split(":")[1] for f in suggested if "=test:" in f):
            continue
        if filter_ not in suggested:
            suggested.append(filter_)
    # #2029: a new or edited migration file changes what every replay/rewind/catalog
    # pin observes (e.g. an ALTER on an older table breaks a replay that compares
    # sqlite_master), although no test names the file. Select every caller of the
    # rewind helpers by scan, so tests added later are picked up too.
    if any(MIGRATION_FILE.match(p) and p not in comment_only for p in changed):
        for filter_ in rewind_test_filters(sources, catalog_pins=True):
            if filter_ not in suggested:
                suggested.append(filter_)
    pins = []
    added_text ="\n".join(t for p, lines in added.items() if p not in comment_only for _, t in lines)
    if re.search(r"\b(AGENT_VERBS|READ_VERBS)\b", added_text) or any(p.startswith(("crates/rsid/src/rpc/agent", "crates/rsid/src/harness/tools")) for p in changed if p not in comment_only):
        named = verb_pin_filters(sources)
        # Chunked like every named set, so no pin passes GATE_FILTER_LENGTH (the
        # job and queue wire cap per filter, #1705).
        pins += traced_filters([(module, name, shard) for (shard, module), names in sorted(named.items()) for name in names])
        if sum(len(names) for names in named.values()) > AGENT_VERB_PIN_CAP:
            broad.append({"filter": "agent verb catalog pins", "tests": sum(len(n) for n in named.values()),
                          "reason": "more than %d catalog/operator_only tests" % AGENT_VERB_PIN_CAP})
    observer_tests, observer_missing = source_observer_pins(sources, set(changed), comment_only)
    pins += traced_filters(observer_tests)
    workspace_observers = manifest_dir_guard_filters(sources, changed)
    pins += workspace_observers
    manual_docs_changed = "docs/keybindings.md" in changed
    if any(Path(p).name in ("settings_registry.rs", "key_tables.rs") for p in changed):
        pins.append("rsi=manual::")
    derived_filters = {f for filters in derived_by_path.values() for f in filters}
    other_filters = [f for f in suggested if f not in derived_filters] + pins
    suggested = covered_filters(suggested + pins)
    # Small per-module inventories can still exceed the worker's gate budget
    # in aggregate. Try the same observer trace on those modules too, accepting
    # only reductions after merging overlapping coverage. An uncertain trace
    # retains its original filters, even when that leaves more than the budget.
    if len(suggested) > GATE_FILTER_LIMIT:
        if old_sources is None:
            old_files = git_out(repo, "ls-tree", "-r", "--name-only", merge_base, "crates").splitlines()
            old_sources = SourceTree(repo, merge_base, old_files)
        for path, original in list(derived_by_path.items()):
            if path not in changed or not original:
                continue
            picked = narrow_tests(sources, old_sources, repo, merge_base, head, path)
            if picked is None:
                continue
            replacement = traced_filters(picked)
            candidate = covered_filters(other_filters + [
                f for source, filters in derived_by_path.items()
                for f in (replacement if source == path else filters)
            ])
            if len(candidate) >= len(suggested):
                continue
            derived_by_path[path] = replacement
            suggested = candidate
            narrowed.append({"path": path, "module": sources.module(path),
                             "tests": len({(m, n) for m, n, _ in picked}),
                             "reason": "aggregate gate budget: traced field, export and function consumers; merged already-covered tests"})
            if len(suggested) <= GATE_FILTER_LIMIT:
                break
    merged = []
    suggested = covered_filters(other_filters + [f for filters in derived_by_path.values() for f in filters], merged)
    # #1260/#1253: a filter that selects no test fails the gate after a long build.
    # Keep a shard filter only when a test of that shard sits under the module.
    dropped = []
    kept = []
    for flt in suggested:
        match = SHARD_FILTER.match(flt)
        simple = SIMPLE_MODULE.fullmatch(match.group(2)) if match else None
        simple = simple or (ANCHORED_MODULE.fullmatch(match.group(2)) if match else None)
        if simple and not sources.filter_matches(match.group(1), simple.group(1)):
            dropped.append({"filter": flt, "reason": f"no test of shard {match.group(1)} has `{simple.group(1)}` in its module path"})
            continue
        kept.append(flt)
    suggested = kept
    if not args.run_filters:
        suggested = unsharded_filters(suggested, packages_of_shard, merged)
        duplicates = {item["filter"] for item in merged
                      if item["reason"].startswith("identical expression")}
        broad = [item for item in broad if item["filter"] not in duplicates]
    for item in dropped:
        sys.stderr.write(f"check-touched-shards: dropped {item['filter']}: {item['reason']}\n")
    # A worker still verifies the known changed modules and targets when an
    # unresolved leaf trace leaves the lander to derive its complete closure.
    # Keep this separate: publishing a partial landing filter list would narrow
    # that gate (#2441, #2611).
    worker_filters = list(suggested)
    if unprovable:
        # #2441: no filters at all means the unfiltered gate; a partial list would replace it.
        suggested = []
    # A filter that cannot be split (one test name longer than the wire cap) would be
    # refused by AgentSubmitJob/AgentEnqueueLandingSource: name it (#1705).
    oversize = [flt for flt in suggested if len(flt.encode()) > GATE_FILTER_LENGTH]
    for flt in oversize:
        sys.stderr.write(f"check-touched-shards: {len(flt.encode())}-byte filter exceeds the {GATE_FILTER_LENGTH}-byte job wire cap "
                         f"and cannot be split further: {flt[:120]}...; enqueue with derive_filters instead of copying it\n")
    for item in broad:
        sys.stderr.write(f"check-touched-shards: BROAD {item['filter']} ({item['tests']} tests): {item['reason']}; "
                         "split the run or run it with a longer budget\n")
    lap("filters")
    impact = None if args.filters_only else impact_filters(repo, merge_base, head)
    lap("impact")

    if args.run_filters:
        tmpdir = gate_tmpdir()
        try:
            for flt in dict.fromkeys(suggested + args.filter):
                match = SHARD_FILTER.match(flt)
                if not match:
                    continue
                shard, expr = match.groups()
                package_flags = [flag for pkg in packages_of_shard.get(shard, ["rsid"]) for flag in ("-p", pkg)]
                cmd = cargo_prefix() + ["nextest", "run", *package_flags, "--lib", "--no-default-features", "--features", f"test-shard-{shard}", "-E", expr]
                env = {**os.environ, "TMPDIR": tmpdir}
                result = run(cmd, repo, env=env)
                (filter_runs["ok"] if result.returncode == 0 else filter_runs["failed"]).append(flt)
                if result.returncode != 0:
                    sys.stderr.write(f"filter {flt} failed with TMPDIR={tmpdir}:\n{(result.stdout + result.stderr)[-3000:]}\n")
        finally:
            shutil.rmtree(tmpdir, ignore_errors=True)

    desktop = desktop_lane_at(repo, merge_base, head, changed)
    if "error" in desktop:
        sys.stderr.write(f"check-touched-shards: desktop lane: {desktop['error']}\n")
    failed = "error" in desktop or bool(filter_runs["failed"]) or bool(compiled["failed"]) or any(a["verdict"] == "fail" for a in audits.values()) or merge_clean is False or migration_conflict or bool(stray_pre_split)
    receipt = {
        "base": base,
        "head": head,
        "merge_base": merge_base,
        "merge_bases": merge_bases,
        "merge_clean": merge_clean,
        "changed_files": len(changed),
        "slow_tier": slow_tier,
        "compile": compile_receipt(mode, shard_runs),
        "shards": {"compiled_ok": compiled["ok"], "compiled_failed": compiled["failed"], "compile_skipped": compiled["skipped"], "shard_compile_suspect_stale": suspect_stale, "fallback": fallback, "map": shard_files, "runs": shard_runs},
        "audits": audits,
        "desktop": desktop,
        "filter_runs": filter_runs,
        "migrations": {
            "new": new_migrations,
            "base_head": base_head,
            "numbering_conflict": migration_conflict,
            "pending_predecessors": pending_predecessors,
            "stray_pre_split": stray_pre_split,
        },
        "suggested_filters": suggested,
        "worker_filters": worker_filters,
        "priority_filters": unsharded_filters(
            changed_test_filters(sources, repo, merge_base, head, changed), packages_of_shard),
        "changed_modules": changed_modules(sources, changed, comment_only),
        "dropped_filters": dropped + e2e_dropped,
        "e2e_surfaces": e2e_surfaces,
        "oversize_filters": oversize,
        "broad": bool(broad),
        "broad_filters": broad,
        "direct_observer_filters": direct_observer_filters(direct_found),
        "direct_observers": direct_observer_summary(direct_found),
        "narrowed_filters": narrowed,
        "source_scanners": sorted({f"{m}::{n}" for m, n, _ in scanners}),
        # An unprovable leaf withdraws suggested_filters to preserve the
        # lander's complete closure. scoped-test can still run these mandatory
        # pins without replacing that unfiltered landing (#2495).
        "scanned_token_filters": traced_filters(token_scanners),
        "leaf_observers": leaf_notes,
        "unfiltered_leaf_paths": unprovable,
        "declared_coverage": declared_used,
        "source_observer_pins": sorted(f"{m}::{n}" for m, n, _ in observer_tests),
        "workspace_source_observers": workspace_observers,
        "source_observer_missing": [f"{m}::{n}" for m, n in observer_missing],
        "merged_filters": merged,
        "filter_budget": {"limit": GATE_FILTER_LIMIT, "over": len(suggested) > GATE_FILTER_LIMIT,
                          "reason": "uncertain coverage is retained rather than truncated"},
        "impact_filters": impact,
        "manual_docs_changed": manual_docs_changed,
        "ok": not failed,
        "filters_only": args.filters_only,
        "timings_sec": timings,
    }
    audit_text = " ".join(f"{k}={v['verdict']}" for k, v in audits.items())
    summary = (
        f"check-touched-shards {'OK' if not failed else 'FAIL'} head={head[:9]} base={base[:9]} "
        f"merge_clean={str(merge_clean).lower()} shards_ok={','.join(compiled['ok']) or '-'} "
        f"shards_failed={','.join(compiled['failed']) or '-'} {audit_text} "
        f"filters_failed={','.join(filter_runs['failed']) or '-'} "
        f"migrations={','.join('V%d' % n for n in new_migrations) or '-'}"
        f"{' RENUMBER' if migration_conflict else ''}"
        f"{' STRAY_PRE_SPLIT_MIGRATION' if stray_pre_split else ''} filters={len(suggested)}"
        f"{' BROAD' if broad else ''}"
        f"{' MERGE_BASES=%d' % len(merge_bases) if multiple_bases else ''}"
    )
    receipt["partial"] = False
    if args.receipt:
        write_receipt(args.receipt, receipt)
    if not args.json:
        print(summary)
    if args.receipt_line:
        print("RECEIPT_JSON " + json.dumps(receipt, separators=(",", ":")))
    else:
        print(json.dumps(receipt, indent=2))
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
