[Unit]
Description=Stop tonight's AWS instances at budget or deadline

[Service]
Type=oneshot
EnvironmentFile=-%h/.rsi/cloud/watchdog.env
ExecStart=%h/.rsi/bin/cloud-watchdog.py $RSI_CLOUD_WATCHDOG_ARGS
StandardOutput=append:%h/.rsi/cloud-watchdog.log
StandardError=append:%h/.rsi/cloud-watchdog.log
