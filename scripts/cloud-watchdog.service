[Unit]
Description=Sweep expired or untagged RSI AWS instances and reconcile spend reservations

[Service]
Type=oneshot
EnvironmentFile=-%h/.rsi/cloud/watchdog.env
ExecStart=%h/.rsi/bin/rsi-cloud watchdog $RSI_CLOUD_WATCHDOG_ARGS
StandardOutput=append:%h/.rsi/cloud-watchdog.log
StandardError=append:%h/.rsi/cloud-watchdog.log
