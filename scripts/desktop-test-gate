#!/bin/sh
# Python-free entry (#363): Select and run the desktop test lane.
# Builds crates/rsi-repo-guards on demand (scripts/repo-guard) and runs the `desktop-test-gate`
# guard with the same flags, output and exit codes as the legacy script of the same name
# (which stays until its callers switch; hub #3621 owns the trusted executable).
set -eu
root=$(CDPATH='' cd "$(dirname "$0")/.." && pwd -P)
exec "$root/scripts/repo-guard" desktop-test-gate "$@"
