#!/bin/sh
# RSI-021 — Branch + path invariant enforcement for pipeline agents.
#
# This hook is the primary defense against the four chronic agent-contract
# failure modes documented in
# thoughts/shared/tickets/rsi-harness/RSI-021_agent_contract_enforcement.md.
#
# It reads $CLAUDE_AGENT_ROLE — exported by pipeline agents per the spawn
# prompts in master_implement.md / team_implement.md. Empty role means a
# human commit; the hook exits 0 with no enforcement so Jake's normal
# workflow is unaffected.
#
# Rule table (from the ticket):
#   pipeline-research  → branch=main, path=thoughts/shared/research/**
#   pipeline-plan      → branch=main, path=thoughts/shared/plans/**
#   pipeline-implement → branch != main (must be a feature branch / worktree)
#
# Unknown roles fail closed — surfaces harness-spec drift fast.
#
# The corpus provenance gate (#622/#623) runs BEFORE the role check and is
# deliberately role-independent; see its block comment below.

# ── Corpus provenance gate (Issues #622, #623) ──────────────────────────────
# A benchmark corpus/answer-key markdown is a pinned artifact: a fabricated SHA
# or a "new" regression test that already exists at the parent silently mis-pins
# a case, and the packet builder then fails late or builds the wrong diff.
#
# DELIBERATELY ROLE-INDEPENDENT — placed ABOVE the `[ -z "$ROLE" ] && exit 0`
# below. The rest of this hook is agent-contract enforcement that must not touch
# a human commit, but a corpus pin is a factual claim about this repository
# whether a pipeline agent or the operator wrote it, and issue #622 asks for a
# gate on "any corpus/answer-key artifact". It is a no-op unless a corpus file
# is staged, so ordinary human commits are unaffected. See
# thoughts/shared/bench/reviewer-calibration/README.md.
staged_corpus="$(git diff --cached --name-only --diff-filter=d \
  -- 'thoughts/shared/research/*corpus*' 'thoughts/shared/research/*packet*' \
     'thoughts/shared/research/*answer-key*' 'thoughts/shared/bench/*corpus*' \
     'thoughts/shared/bench/*packet*' 'thoughts/shared/bench/*answer-key*')"
if [ -n "$staged_corpus" ]; then
  if [ -x scripts/check-corpus-pins.sh ]; then
    staged_dir="$(mktemp -d)"
    trap 'rm -rf "$staged_dir"' EXIT HUP INT TERM
    staged_files=""
    staged_index=0
    for staged_path in $staged_corpus; do
      staged_index=$((staged_index + 1))
      staged_blob="$staged_dir/$staged_index.md"
      if ! git show ":$staged_path" > "$staged_blob" 2>/dev/null; then
        echo "pre-commit: corpus provenance gate could not read staged blob: $staged_path" >&2
        exit 1
      fi
      staged_files="$staged_files $staged_blob"
    done
    # Temp filenames are generated by this hook and contain no whitespace.
    # shellcheck disable=SC2086
    if ! scripts/check-corpus-pins.sh $staged_files; then
      echo "pre-commit: corpus provenance gate failed (see above). Fix the pin or unstage the corpus file." >&2
      exit 1
    fi
  else
    echo "pre-commit: [skip] scripts/check-corpus-pins.sh not found; not checking staged corpus pins" >&2
  fi
fi

ROLE="${CLAUDE_AGENT_ROLE:-}"
[ -z "$ROLE" ] && exit 0

BRANCH="$(git rev-parse --abbrev-ref HEAD)"
STAGED="$(git diff --cached --name-only)"

case "$ROLE" in
  pipeline-research)
    if [ "$BRANCH" != "main" ]; then
      echo "pre-commit: pipeline-research must commit on 'main' (current: $BRANCH)" >&2
      exit 1
    fi
    for f in $STAGED; do
      case "$f" in
        thoughts/shared/research/*) ;;
        *)
          echo "pre-commit: pipeline-research may only commit under thoughts/shared/research/ (offender: $f)" >&2
          exit 1
          ;;
      esac
    done
    ;;
  pipeline-plan)
    if [ "$BRANCH" != "main" ]; then
      echo "pre-commit: pipeline-plan must commit on 'main' (current: $BRANCH)" >&2
      exit 1
    fi
    for f in $STAGED; do
      case "$f" in
        thoughts/shared/plans/*) ;;
        *)
          echo "pre-commit: pipeline-plan may only commit under thoughts/shared/plans/ (offender: $f)" >&2
          exit 1
          ;;
      esac
    done
    ;;
  pipeline-implement)
    if [ "$BRANCH" = "main" ] || [ "$BRANCH" = "master" ]; then
      echo "pre-commit: pipeline-implement must NOT commit on '$BRANCH'. Check out a feature branch / worktree." >&2
      exit 1
    fi
    ;;
  *)
    # Unknown role — fail closed to surface harness-spec drift.
    echo "pre-commit: unknown CLAUDE_AGENT_ROLE='$ROLE' (expected: pipeline-research|pipeline-plan|pipeline-implement)" >&2
    exit 1
    ;;
esac

# ── A3: MWP/ICM staged-artifact validation ──────────────────────────────────
# Runs ONLY for non-empty roles — the empty-role `exit 0` above already returned
# for human/master commits, so this NEVER blocks a human/empty-role commit.
#
# Maps each staged pipeline artifact to its rsi-common validator:
#   thoughts/shared/research/*.json           → rsi-research-validate --strict
#   thoughts/shared/handoffs/**/*.md          → rsi-handoff-validate --strict
#   *.md with `phases_sealed:` in frontmatter → rsi-manifest-validate
# (rsi-contract-validate reads a worker reply from stdin, not a committed file.)
#
# To keep commits fast and never force a compile, we use a PRE-BUILT validator
# binary and SKIP-with-warning (exit 0) when it is absent. exit 1 fires ONLY on
# a genuine validation failure of a staged artifact.

# Resolve a validator binary by name; echo path or "" (workspace may use a
# shared cargo target-dir, so we do not assume repo-local target/).
find_validator() {
  _name="$1"
  if [ -n "${RSI_VALIDATE_BIN_DIR:-}" ] && [ -x "$RSI_VALIDATE_BIN_DIR/$_name" ]; then
    echo "$RSI_VALIDATE_BIN_DIR/$_name"; return 0
  fi
  _p="$(command -v "$_name" 2>/dev/null || true)"
  [ -n "$_p" ] && { echo "$_p"; return 0; }
  _cfg="$(grep -shE '^[[:space:]]*target-dir[[:space:]]*=' \
            .cargo/config.toml .cargo/config "${HOME}/.cargo/config.toml" "${HOME}/.cargo/config" 2>/dev/null \
          | head -n1 | sed -E 's/.*=[[:space:]]*"?([^"]*)"?[[:space:]]*$/\1/')"
  for _base in "${CARGO_TARGET_DIR:-}" "$_cfg" "target"; do
    [ -n "$_base" ] || continue
    for _prof in release debug; do
      [ -x "$_base/$_prof/$_name" ] && { echo "$_base/$_prof/$_name"; return 0; }
    done
  done
  echo ""; return 0
}

# True iff $1 is a verification manifest (phases_sealed: in its FRONTMATTER).
# NOTE: awk `exit N` in a main rule still runs END, so the decision is made in
# END from a flag (a naive `exit 0` in a rule would be overridden by END).
is_manifest() {
  awk '
    NR==1   { if ($0 != "---") exit 1; next }
    done==1 { next }                          # stop scanning after frontmatter
    /^---[[:space:]]*$/ { done=1; next }       # end of frontmatter fence
    /^phases_sealed:/   { found=1 }
    END     { exit (found ? 0 : 1) }
  ' "$1" 2>/dev/null
}

# ── Identity-assertion guard ────────────────────────────────────────────────
# Rejects a staged test that requires an entity's OWN name to be invisible.
# Such a test pins data loss as a requirement and defeats the next agent sent
# to fix it. Narrow by construction (see scripts/check-identity-assertions.sh).
staged_rs="$(git diff --cached --name-only --diff-filter=d -- '*.rs')"
if [ -n "$staged_rs" ] && [ -f tools/check_identity_assertions.py ]; then
  # shellcheck disable=SC2086
  if ! python3 tools/check_identity_assertions.py $staged_rs; then
    echo "pre-commit: identity-assertion guard failed (see above)." >&2
    exit 1
  fi
fi

art_fail=0
for f in $(git diff --cached --name-only --diff-filter=d); do
  [ -f "$f" ] || continue
  vbin=""; label=""; set -- ""
  case "$f" in
    thoughts/shared/research/*.json)
      vbin="$(find_validator rsi-research-validate)"; label="research sidecar"; set -- "$f" --strict ;;
    thoughts/shared/handoffs/*.md)
      vbin="$(find_validator rsi-handoff-validate)"; label="handoff"; set -- --strict "$f" ;;
    *.md)
      is_manifest "$f" || continue
      vbin="$(find_validator rsi-manifest-validate)"; label="manifest"; set -- "$f" ;;
    *)
      continue ;;
  esac
  if [ -z "$vbin" ]; then
    echo "pre-commit: [skip] validator for $label not built; not validating $f (build: cargo build --release -p rsi-common --bins)" >&2
    continue
  fi
  if ! "$vbin" "$@" >/dev/null 2>&1; then
    echo "pre-commit: $label FAILED validation: $f" >&2
    "$vbin" "$@" 2>&1 | sed 's/^/    /' >&2
    art_fail=1
  fi
done
if [ "$art_fail" -ne 0 ]; then
  echo "pre-commit: staged artifact validation failed (see above). Fix the artifact or unstage it." >&2
  exit 1
fi

exit 0
